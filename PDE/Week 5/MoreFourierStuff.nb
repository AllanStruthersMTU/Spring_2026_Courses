Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "x"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"0", "<", "x", "<", "\[Pi]"}], ",", 
    RowBox[{
     SuperscriptBox["x", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[Pi]", "-", "x"}], ")"}], "2"]}], ",", "10"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"f", "[", 
       RowBox[{"-", "x"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "\[Pi]"}], ",", "0"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Green"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"f", "[", 
       RowBox[{"x", "-", "\[Pi]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "Pi", ",", 
       RowBox[{"2", " ", "\[Pi]"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Orange"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", "+", 
       RowBox[{"2", "\[Pi]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"-", "2"}], "Pi"}], ",", 
       RowBox[{"-", "\[Pi]"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", "All"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
