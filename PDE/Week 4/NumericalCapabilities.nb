\\\"TI\\\"]}], \\\"}\\\"}], \\\"\[Element]\\\", \
StyleBox[\\\"\[CapitalOmega]\\\", \\\"TR\\\"]}]}], \\\"]\\\"}]\\) solves the \
partial differential equations \\!\\(\\*StyleBox[\\\"eqns\\\", \\\"TI\\\"]\\) \
over the region \\!\\(\\*StyleBox[\\\"\[CapitalOmega]\\\", \\\"TR\\\"]\\).\\n\
\\!\\(\\*RowBox[{\\\"NDSolveValue\\\", \\\"[\\\", RowBox[{StyleBox[\\\"eqns\\\
