      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"D2fVec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "''"}], "[", 
      RowBox[{"x", "[", "j", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<f\>\"", "->", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"f", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ListPlot", "[", 
        RowBox[{"fVec", ",", 
         RowBox[{"DataRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", "+", "\[CapitalDelta]x"}], ",", "b"}], "}"}]}]}], 
        "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<f'\>\"", "->", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"f", "'"}], "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"D1c", ".", "fVec"}], ",", 
         RowBox[{"DataRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", "+", "\[CapitalDelta]x"}], ",", "b"}], "}"}]}]}], 
        "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<f''\>\"", "->", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"f", "''"}], "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"D2", ".", "fVec"}], ",", 
         RowBox[{"DataRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", "+", "\[CapitalDelta]x"}], ",", "b"}], "}"}]}]}], 
        "]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
    "\"\<|f'-\!\(\*SubscriptBox[\(D\), \(\(1\)\(?\)\)]\).f|\>\"", " ", "->", 
     " ", 
     RowBox[{"ListLogPlot", "[", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"D1fVec", "-", 
          RowBox[{"D1f", ".", "fVec"}]}], ",", 
         RowBox[{"D1fVec", "-", 
          RowBox[{"D1b", ".", "fVec"}]}], ",", 
         RowBox[{"D1fVec", "-", 
          RowBox[{"D1c", ".", "fVec"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"DataRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "L"}], ",", "L"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<f\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], "}"}]}], 
       ",", 
       RowBox[{"GridLines", "->", "Automatic"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
    "\"\<|f''-\!\(\*SubscriptBox[\(D\), \(\(2\)\(?\)\)]\).f|\>\"", " ", "->", 
     " ", 
     RowBox[{"ListLogPlot", "[", " ", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"D2fVec", "-", 
         RowBox[{"D2c", ".", "fVec"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"DataRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "L"}], ",", "L"}], "}"}]}], ",", 
