Cell["\<\
We need to define and check our approximate differentiation matrices. \
\>", "Text",
 CellChangeTimes->{{3.9836197179241514`*^9, 3.983619743298258*^9}, {
  3.9836199953979006`*^9, 3.9836200114132075`*^9}, {3.9836200550017977`*^9, 
  3.9836200630665855`*^9}, {3.983620159201912*^9, 
  3.9836201612726865`*^9}},ExpressionUUID->"3dc0a134-d6d4-4d99-9529-\
6f63924fd217"],

Cell["\<\
We need to understand how to incorporate periodic boundary conditions. \
\>", "Text",
 CellChangeTimes->{{3.9836197179241514`*^9, 3.983619743298258*^9}, {
  3.9836199953979006`*^9, 3.9836200114132075`*^9}, {3.9836200550017977`*^9, 
  3.9836200630665855`*^9}, {3.983620159201912*^9, 3.9836201612726865`*^9}, {
  3.983620201054185*^9, 
  3.9836202340729184`*^9}},ExpressionUUID->"feb60b59-0d7f-4f60-80ac-\
1b7158d48f95"],

Cell["\<\
We need to understand (in as many ways as possible) the effects of our \
different approximate differentiation matrices.   \
\>", "Text",
 CellChangeTimes->{{3.9836197179241514`*^9, 3.983619743298258*^9}, {
  3.9836199953979006`*^9, 3.9836200114132075`*^9}, {3.9836200550017977`*^9, 
  3.9836200630665855`*^9}, {3.983620111696805*^9, 
  3.983620188844254*^9}},ExpressionUUID->"a22bd2b3-e6cc-4569-baf4-\
950547b751a2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Spectral Methods", "Section",
 CellChangeTimes->{{3.9828522048633337`*^9, 3.982852214940895*^9}, {
   3.983264009139923*^9, 3.9832640202797794`*^9}, {3.9836200323626432`*^9, 
   3.9836200354844174`*^9}, 
   3.9836202398018503`*^9},ExpressionUUID->"6635e341-6d85-4539-a13c-\
7d3eee86012e"],

Cell[TextData[{
 "We need to understand and check the Fourier solvers for linear PDEs.  The \
first thing we need to understand is the order that our FFT puts the pieces \
in.   We decided we are doing a periodic problem on the interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "L"}], "<", "x", "<", "L"}], TraditionalForm]],
  ExpressionUUID->"df12728e-f4b2-4fb4-ba07-ce42bae3c171"],
 ".  We are going to assume our data is of length ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "7ddc3f4d-d77b-48fb-8cbf-5c091b205185"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "=", 
    RowBox[{
     RowBox[{"-", "L"}], "+", "\[CapitalDelta]x"}]}], TraditionalForm]],
  ExpressionUUID->"c4ca87df-883a-4ff2-8c10-c8e11a0f5a4a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], "=", 
    RowBox[{
     RowBox[{"-", "L"}], "+", 
     RowBox[{"2", " ", "\[CapitalDelta]x"}]}]}], TraditionalForm]],
  ExpressionUUID->"c86a6cc9-ddd2-48f8-b4cb-8b0a4ad751d3"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "n"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "L"}], "+", 
      RowBox[{"n", " ", "\[CapitalDelta]x"}]}], "=", "L"}]}], 
   TraditionalForm]],ExpressionUUID->"3fb6f353-d6c9-4d48-94d6-946a7a4add65"],
 " "
}], "Text",
 CellChangeTimes->{{3.9836197179241514`*^9, 3.983619743298258*^9}, {
  3.9836199953979006`*^9, 3.9836200114132075`*^9}, {3.9836200550017977`*^9, 
  3.9836200630665855`*^9}, {3.983620159201912*^9, 3.9836201612726865`*^9}, {
  3.983620250179385*^9, 
  3.98362047204679*^9}},ExpressionUUID->"ca56e35b-7ce9-4083-9171-\
da63d854c7e6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]x", "=", 
   RowBox[{"2.0", 
    RowBox[{"L", "/", "n"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"1.2", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"3", "x"}], "]"}]}], "+", 
   RowBox[{"2.4", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"2", "x"}], "]"}]}], "+", " ", 
   RowBox[{"0.3", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"2", "x"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "[", "j_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "L"}], "+", 
   RowBox[{"j", " ", "\[CapitalDelta]x"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fVec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", "[", "j", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{"fVec", ",", 
   RowBox[{"DataRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "L"}], ",", "L"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.983620486383108*^9, 3.9836206259300966`*^9}},
 CellLabel->
  "In[104]:=",ExpressionUUID->"4059b907-7163-471f-b90d-7c168e15cd0a"],

