Cell[TextData[{
 "\nSplitting \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ImaginaryI]", " ", 
     SubscriptBox["u", "t"]}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     SubscriptBox["u", "xx"]}]}], TraditionalForm]],ExpressionUUID->
  "28a3659e-19fc-4686-a2bb-3ca3f2a51fcf"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ImaginaryI]", " ", 
     SubscriptBox["u", "t"]}], "=", 
    RowBox[{"-", 
     RowBox[{"|", "u", 
      SuperscriptBox["|", "2"], "u"}]}]}], TraditionalForm]],ExpressionUUID->
  "bf7dae9c-954a-4596-b2f0-c53c2e14a133"]
}], "Text",
