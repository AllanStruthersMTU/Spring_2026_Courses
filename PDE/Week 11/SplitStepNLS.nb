Cell[CellGroupData[{
Cell["\<\
Strang Splitting for NLS
\
\>", "Section",
 CellChangeTimes->{{3.9828522048633337`*^9, 3.982852214940895*^9}, {
  3.983264009139923*^9, 
  3.9832640202797794`*^9}},ExpressionUUID->"6635e341-6d85-4539-a13c-\
7d3eee86012e"],

Cell[TextData[{
 "Code is for \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", 
       SubscriptBox["u", "t"]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["u", "xx"]}], "+"}], "|", "u", 
     SuperscriptBox["|", "2"], "u"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"db76007b-5938-4b33-8219-23186c7897cf"]
}], "Text",
 CellChangeTimes->{{3.982851969165657*^9, 3.9828521195262604`*^9}, {
   3.9828521676976357`*^9, 3.982852195078617*^9}, 3.9832640306702943`*^9, {
   3.9832640843421664`*^9, 3.9832642139513884`*^9}, {3.9832720553424273`*^9, 
   3.983272061146021*^9}},ExpressionUUID->"5c2f5688-858f-44e6-8aa7-\
22082ca73b6c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Parameters", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L", "=", "10"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Domain", " ", "length"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmax", "=", "35"}], ";", 
    RowBox[{"(*", "Time", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"kappa", "=", "1"}], ";", 
    RowBox[{"(*", 
     RowBox[{"Nonlinearity", " ", "coefficient"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"NLS", " ", 
       RowBox[{"Equation", ":", 
        RowBox[{
         RowBox[{
          RowBox[{"i", "*", "u_t"}], "+", 
          RowBox[{"0.5", " ", "u_xx"}], "+", 
          RowBox[{"kappa", "*"}]}], "|", "u", "|", 
         RowBox[{
          RowBox[{"^", "2"}], "*", "u"}]}]}]}], "=", "0"}], "*)"}], 
    RowBox[{"eq", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"I", "*", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}]}], "+", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], "+", 
       RowBox[{"kappa", "*", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}], "]"}], "^", "2"}], "*", 
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}]}], "==", "0"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Initial", " ", "Condition", " ", 
     RowBox[{"(", "Soliton", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ic", "=", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "0"}], "]"}], "==", 
      RowBox[{"Sech", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Boundary", " ", "Conditions", " ", 
     RowBox[{"(", "Periodic", ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"bc", "=", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{
        RowBox[{"-", "L"}], ",", "t"}], "]"}], "==", 
      RowBox[{"u", "[", 
       RowBox[{"L", ",", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "NDSolve", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"eq", ",", "ic", ",", "bc"}], "}"}], ",", "u", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "Result"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"TabView", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Plot3D", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"sol", "[", 
           RowBox[{"x", ",", "t"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
         RowBox[{"PlotPoints", "->", "100"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ContourPlot", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"sol", "[", 
           RowBox[{"x", ",", "t"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
         RowBox[{"PlotPoints", "->", "100"}], ",", "\[IndentingNewLine]", 
         RowBox[{"GridLines", "\[Rule]", "Automatic"}]}], "]"}]}], "}"}], ",",
      "\[IndentingNewLine]", "2"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.983272908734414*^9, 3.9832729671528263`*^9}, {
  3.9832730555431633`*^9, 3.9832730628588476`*^9}, {3.9832732042458916`*^9, 
  3.9832733711889486`*^9}, {3.983273508309746*^9, 3.9832736093108416`*^9}, {
  3.983278081335052*^9, 3.9832780818918962`*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"a14b01e7-9e33-4c9e-93bc-f6fed65b11b6"],

