7a2944d06a78"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "t", ",", "u"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", "=", "5"}], ";", 
  RowBox[{"TMax", "=", "5"}], ";", 
  RowBox[{"c", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"uSol", "=", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], " ", "+", " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "3"}], "}"}]}], "]"}], "-", 
        RowBox[{"6", " ", 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], " ", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{"x", ",", "t"}], "]"}], ",", "x"}], "]"}]}]}], "==", 
       "0"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "==", 
       RowBox[{
        FractionBox["c", "2"], 
        SuperscriptBox[
         RowBox[{"Sech", "[", 
          RowBox[{
           FractionBox[
            SqrtBox["c"], "2"], "x"}], "]"}], "2"]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{
         RowBox[{"-", "L"}], ",", "t"}], "]"}], "==", 
       RowBox[{"u", "[", 
        RowBox[{"L", ",", "t"}], "]"}]}]}], "\[IndentingNewLine]", "}"}], ",",
     "\[IndentingNewLine]", "u", ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", 
      RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Method", " ", "->", " ", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"\"\<PDEDiscretization\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<MethodOfLines\>\"", ",", " ", "\n", "      ", 
         RowBox[{"\"\<SpatialDiscretization\>\"", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<TensorProductGrid\>\"", ",", " ", 
            RowBox[{"\"\<MaxPoints\>\"", " ", "->", " ", "5000"}]}], 
           "}"}]}]}], "}"}]}], "}"}]}]}], "]"}], " "}]}], "Input",
