Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Step", " ", 
       RowBox[{"A", ":", 
        RowBox[{"Half", " ", "dispersion", " ", "Step"}]}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"uhat", "=", 
        RowBox[{"Fourier", "[", "u", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"uhat", "=", 
