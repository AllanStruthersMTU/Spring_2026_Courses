Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NLSStep", "[", 
    RowBox[{"dt_", ",", "LPhase_"}], "]"}], "[", "uIn_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "uHalf", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Convert", " ", "to", " ", "Fourier", " ", "Space", " ", "advance", " ", 
      "by", " ", 
      RowBox[{"\[CapitalDelta]t", "/", "2"}], " ", "using", " ", "LPhase"}], 
     " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Check", " ", "LPhase", " ", 
      RowBox[{"(", 
       RowBox[{"computed", " ", "externally"}], ")"}], "corresponds", " ", 
      "to", " ", 
      RowBox[{"dt", "/", "2"}]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"uHalf", "=", 
      RowBox[{
       RowBox[{"Fourier", "[", 
        RowBox[{"uIn", ",", 
         RowBox[{"FourierParameters", "->", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], "*", "LPhase"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Convert", " ", "back", " ", "to", " ", "Physical", " ", "Space", " ", 
       "and", " ", "advance", " ", "by", " ", "a", " ", "full", " ", "dt"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uHalf", "=", 
      RowBox[{"InverseFourier", "[", 
       RowBox[{"uHalf", ",", 
        RowBox[{"FourierParameters", "->", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uHalf", "=", 
      RowBox[{"uHalf", "+", 
       RowBox[{"dt", " ", 
        SuperscriptBox[
         RowBox[{"Abs", "[", "uHalf", "]"}], "2"], "*", "uHalf"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Back", " ", "to", " ", "Fourier", " ", "and", " ", "complete", " ", 
       "linear", " ", "advance", " ", "by", " ", 
       RowBox[{"\[CapitalDelta]t", "/", "2"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"uHalf", "=", 
      RowBox[{
       RowBox[{"Fourier", "[", 
        RowBox[{"uHalf", ",", 
         RowBox[{"FourierParameters", "->", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], "*", "LPhase"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "back", " ", "to", " ", "physical", " ", "sapce", " ", "and", " ", 
       "return"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"InverseFourier", "[", 
      RowBox[{"uHalf", ",", 
       RowBox[{"FourierParameters", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
