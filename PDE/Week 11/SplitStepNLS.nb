Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"u", ",", "U", ",", "x", ",", "t"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Kappa]", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u0", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nMax", "=", "50"}], ";", " ", 
  RowBox[{"dt", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", 
   RowBox[{"dt", "*", "nMax"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"uSol", "=", 
  RowBox[{"NDSolveValue", "[", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"u", "'"}], "[", "t", "]"}], "==", 
       RowBox[{"\[ImaginaryI]", " ", "\[Kappa]", " ", 
        SuperscriptBox[
         RowBox[{"Abs", "[", 
          RowBox[{"u", "[", "t", "]"}], "]"}], "2"], 
        RowBox[{"u", "[", "t", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"u", "[", "0", "]"}], "==", "u0"}]}], "}"}], ",", "u", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "TMax"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"U", "=", "u0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Data", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"U", " ", "=", " ", 
      RowBox[{"U", "*", 
       SuperscriptBox["E", 
        RowBox[{"\[ImaginaryI]", " ", "\[Kappa]", " ", "dt", " ", 
         SuperscriptBox[
          RowBox[{"Abs", "[", "U", "]"}], "2"]}]]}]}], ",", 
     RowBox[{"{", "nMax", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"uSol", "[", "t", "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"uSol", "[", "t", "]"}], "]"}], ",", 
       RowBox[{"Abs", "[", 
        RowBox[{"uSol", "[", "t", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax"}], "}"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", "Data", "]"}], ",", 
       RowBox[{"Im", "[", "Data", "]"}], ",", 
       RowBox[{"Abs", "[", "Data", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"DataRange", "->", 
      RowBox[{"{", 
       RowBox[{"dt", ",", " ", "TMax"}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
