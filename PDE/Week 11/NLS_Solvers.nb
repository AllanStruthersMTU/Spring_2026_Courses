Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "L"}], ",", "L"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]x", "=", 
   RowBox[{"2.0", " ", 
    RowBox[{"L", "/", "n"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "[", "j_", "]"}], ":=", " ", 
  RowBox[{"a", "+", " ", 
   RowBox[{"\[CapitalDelta]x", " ", "j"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"1.2", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"3", " ", "\[Pi]", " ", 
      RowBox[{"x", "/", "L"}]}], "]"}]}], "-", 
   RowBox[{"0.4", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"2", " ", "\[Pi]", " ", 
      RowBox[{"x", "/", "L"}]}], "]"}]}], "+", 
   RowBox[{"3.2", 
    RowBox[{"Sin", "[", 
     RowBox[{"5", " ", "\[Pi]", " ", 
      RowBox[{"x", "/", "L"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fVec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", "[", "j", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"D2", "=", 
  RowBox[{
   FractionBox["1", 
    SuperscriptBox["\[CapitalDelta]x", "2"]], 
   RowBox[{"SparseArray", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "n"}], "}"}], "->", "1.0"}], ",", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"n", ",", "1"}], "}"}], "->", "1.0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Band", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}], "]"}], "->", 
        RowBox[{"-", "2.0"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Band", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], "]"}], "->", "1.0"}], ",", 
       RowBox[{
        RowBox[{"Band", "[", 
         RowBox[{"{", 
          RowBox[{"2", ",", "1"}], "}"}], "]"}], "->", "1.0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"fVec", ",", 
     RowBox[{"DataRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "+", "\[CapitalDelta]x"}], ",", "b"}], "}"}]}]}], 
    "]"}]}], "]"}], "\[IndentingNewLine]", 
