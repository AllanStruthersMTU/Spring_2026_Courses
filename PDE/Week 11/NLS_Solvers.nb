Cell[CellGroupData[{
Cell[TextData[{
 "Numerical methods for\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", 
       SubscriptBox["u", "t"]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["u", "xx"]}], "+"}], "|", "u", 
     SuperscriptBox["|", "2"], "u"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"227144a6-0e5b-402b-b2d6-663b94c4e94e"],
 "\non ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "<", "x", "<", "b"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2f63e0da-06ed-4fe5-90dc-d80abd0169ea"],
 " with periodic BC."
}], "Title",
 CellChangeTimes->{{3.983619129089838*^9, 3.983619141082221*^9}, {
  3.983619202520323*^9, 3.983619219165579*^9}, {3.9836193506183805`*^9, 
  3.983619373435424*^9}},ExpressionUUID->"4fbe4fe6-ebc6-42e3-9e70-\
c050cc2ce895"],

Cell[CellGroupData[{

Cell["Method of Lines", "Section",
 CellChangeTimes->{{3.9836191647071276`*^9, 
  3.9836191684260635`*^9}},ExpressionUUID->"15a02933-0c32-4029-bf37-\
8faae94cf1d7"],

Cell["\<\
We need to define the points at which we are going to approximate solutions. \
\>", "Text",
 CellChangeTimes->{{3.9836197179241514`*^9, 3.983619743298258*^9}, {
  3.9836199953979006`*^9, 
  3.9836200114132075`*^9}},ExpressionUUID->"3a27d31b-4415-4417-9c7a-\
f6a8a9769d63"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "L"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]x", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "[", "j_", "]"}], ":=", " ", 
  RowBox[{"a", "+", " ", 
   RowBox[{"\[CapitalDelta]x", " ", "j"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"1.2", " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"3", " ", "x"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fVec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", "[", "j", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "a", ",", "b"}], "}"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"fVec", ",", 
     RowBox[{"DataRange", "->", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}]}]}], "]"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
