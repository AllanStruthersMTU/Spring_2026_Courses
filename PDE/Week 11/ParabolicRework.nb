Cell["\<\
Of course, you want to solve for the values of the parameters at which the \
determinant of the system is equal to zero so that you have non-trivial \
solutions to the linear system with zeros on the right hand side. I am going \
to pretend I already know k=2 and just work on \[Alpha].  With the right \
numbers the \[Alpha]s you compute should produce a numerically zero value for \
the imaginary part of the final answer.  \
\>", "Text",
 CellChangeTimes->{{3.9837069540762396`*^9, 3.983707024997698*^9}, {
  3.98370707021762*^9, 3.9837070785267024`*^9}, {3.983707299319146*^9, 
  3.9837074170394235`*^9}, {3.9837074997614365`*^9, 3.9837075240222187`*^9}, {
  3.983707588059269*^9, 
  3.983707655622668*^9}},ExpressionUUID->"ca37a198-c570-4347-84bb-\
9e7f91892fad"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"F", ",", "\[Alpha]", ",", "k"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"F", "[", "\[Alpha]_", "]"}], ":=", " ", 
  RowBox[{"Det", "[", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        RowBox[{"U1", "[", 
         RowBox[{"k", ",", "\[Alpha]"}], "]"}], "[", "0", "]"}], 
       RowBox[{
        RowBox[{"U2", "[", 
         RowBox[{"k", ",", "\[Alpha]"}], "]"}], "[", "0", "]"}]},
      {
       RowBox[{
        RowBox[{"U1", "[", 
         RowBox[{"k", ",", "\[Alpha]"}], "]"}], "[", "0", "]"}], 
       RowBox[{
        RowBox[{"U2", "[", 
         RowBox[{"k", ",", "\[Alpha]"}], "]"}], "[", "1", "]"}]}
     }], ")"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"FindRoot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"F", "[", "\[Alpha]", "]"}], "==", "0"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", "1.2"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9837074247123384`*^9, 3.9837075828695283`*^9}},
 CellLabel->
  "In[280]:=",ExpressionUUID->"4b23523b-802e-4ab3-9041-10c0eeb61a34"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\[Alpha]", "\[Rule]", 
   RowBox[{
    RowBox[{"-", "0.11115382542354856`"}], "+", 
    RowBox[{"0.797851545665703`", " ", "\[ImaginaryI]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9837075639569783`*^9, 3.983707583556671*^9}},
 CellLabel->
  "Out[283]=",ExpressionUUID->"c14091a9-8e76-43dc-90d0-d7b82922a2e5"]
}, Open  ]]
