Notebook[{
Cell["\<\
There is nothing wrong with doing the wave equation but you only need to do \
the eigenvalue problem for the Laplacian \
\>", "Text",
 CellChangeTimes->{{3.983707663183552*^9, 
  3.983707716051034*^9}},ExpressionUUID->"69142a83-2225-4b22-b72c-\
f869eef92c0e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"\[Alpha]", ",", "U", ",", "u", ",", "k"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"hmm", "=", 
  RowBox[{"DSolveValue", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"U", "''"}], "[", "u", "]"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["u", "2"], 
          SuperscriptBox["k", "2"]}], "-", "\[Alpha]"}], ")"}], 
       RowBox[{"U", "[", "u", "]"}]}]}], "==", "0"}], ",", 
    RowBox[{"U", "[", "u", "]"}], ",", "u"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.983046274444648*^9, 3.9830462776564827`*^9}, {
  3.983046310251719*^9, 3.983046317691723*^9}, {3.9830463575936947`*^9, 
  3.98304637620706*^9}, {3.983046408430915*^9, 3.98304644151539*^9}, {
  3.983046474305786*^9, 3.983046520274811*^9}, {3.983046644801859*^9, 
  3.9830466454315434`*^9}, {3.98304673943093*^9, 3.9830467403439007`*^9}, {
  3.9831044314204073`*^9, 3.983104442162307*^9}, {3.983618482702059*^9, 
  3.983618511572891*^9}, {3.9836217338989697`*^9, 3.983621742674629*^9}, {
  3.9836218065531063`*^9, 3.98362180757967*^9}, {3.9837010111513433`*^9, 
  3.9837010283413315`*^9}, {3.983706617336784*^9, 3.983706648045751*^9}},
 CellLabel->
  "In[212]:=",ExpressionUUID->"e9d8e477-71a3-4dcb-a544-58767384a725"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   TemplateBox[{"2"},
    "C"], " ", 
   RowBox[{"ParabolicCylinderD", "[", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"-", "k"}], "-", 
       RowBox[{"\[ImaginaryI]", " ", "\[Alpha]"}]}], 
      RowBox[{"2", " ", "k"}]], ",", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"3", "/", "4"}]], " ", 
      SqrtBox["2"], " ", 
      SqrtBox["k"], " ", "u"}]}], "]"}]}], "+", 
  RowBox[{
   TemplateBox[{"1"},
    "C"], " ", 
   RowBox[{"ParabolicCylinderD", "[", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"-", "k"}], "+", 
       RowBox[{"\[ImaginaryI]", " ", "\[Alpha]"}]}], 
      RowBox[{"2", " ", "k"}]], ",", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"1", "/", "4"}]], " ", 
      SqrtBox["2"], " ", 
      SqrtBox["k"], " ", "u"}]}], "]"}]}]}]], "Output",
 CellChangeTimes->{{3.983701020303093*^9, 3.98370102900128*^9}, 
   3.983706648935962*^9},
 CellLabel->
  "Out[213]=",ExpressionUUID->"b8617f7d-58cf-4776-8209-25916887c854"]
}, Open  ]],

Cell["\<\
I grabbed to two pieces from the solution above.  As you can see both of them \
are genuinely complex.\
\>", "Text",
 CellChangeTimes->{{3.983706875431921*^9, 
  3.9837069165093765`*^9}},ExpressionUUID->"bd770fd8-6f40-4050-b7ae-\
f2eefa160d7a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"U1", "[", 
    RowBox[{"k_", ",", "\[Alpha]_"}], "]"}], "[", "u_", "]"}], ":=", 
  RowBox[{"ParabolicCylinderD", "[", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"-", "k"}], "+", 
      RowBox[{"\[ImaginaryI]", " ", "\[Alpha]"}]}], 
     RowBox[{"2", " ", "k"}]], ",", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"1", "/", "4"}]], " ", 
     SqrtBox["2"], " ", 
     SqrtBox["k"], " ", "u"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"U2", "[", 
     RowBox[{"k_", ",", "\[Alpha]_"}], "]"}], "[", "u_", "]"}], ":=", 
   RowBox[{"ParabolicCylinderD", "[", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"-", "k"}], "-", 
       RowBox[{"\[ImaginaryI]", " ", "\[Alpha]"}]}], 
      RowBox[{"2", " ", "k"}]], ",", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"3", "/", "4"}]], " ", 
      SqrtBox["2"], " ", 
      SqrtBox["k"], " ", "u"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{
       RowBox[{"U1", "[", 
        RowBox[{"1", ",", "0.2"}], "]"}], "[", "u", "]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Im", "[", 
      RowBox[{
       RowBox[{"U1", "[", 
        RowBox[{"1", ",", "0.2"}], "]"}], "[", "u", "]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Re", "[", 
      RowBox[{
       RowBox[{"U2", "[", 
        RowBox[{"1", ",", "0.2"}], "]"}], "[", "u", "]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Im", "[", 
      RowBox[{
       RowBox[{"U2", "[", 
        RowBox[{"1", ",", "0.2"}], "]"}], "[", "u", "]"}], "]"}]}], 
    "\[IndentingNewLine]", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"u", ",", "0", ",", " ", "4"}], "}"}]}], "]"}]}], "Input",
