Cell["\<\
If I solve a system (with any values of k and \[Alpha]) with real values on \
the RHS I should get a real valued solution albeit with complex coefficients \
giving those real values.  See below for an example. \
\>", "Text",
 CellChangeTimes->{{3.9837069540762396`*^9, 3.983707024997698*^9}, {
  3.98370707021762*^9, 3.9837070785267024`*^9}, {3.983707299319146*^9, 
  3.983707316627267*^9}},ExpressionUUID->"5acef005-99b6-4e29-8ac6-\
206802d797d4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"k", ",", "\[Alpha]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k", "=", "1.2"}], ";", " ", 
  RowBox[{"\[Alpha]", " ", "=", "9.6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Sub", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"c1", " ", 
        RowBox[{
         RowBox[{"U1", "[", 
          RowBox[{"k", ",", "\[Alpha]"}], "]"}], "[", "0", "]"}]}], "+", 
       RowBox[{"c2", " ", 
        RowBox[{
         RowBox[{"U2", "[", 
          RowBox[{"k", ",", "\[Alpha]"}], "]"}], "[", "0", "]"}]}]}], "==", 
      "1.2"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"c1", " ", 
        RowBox[{
         RowBox[{"U1", "[", 
          RowBox[{"k", ",", "\[Alpha]"}], "]"}], "[", "1", "]"}]}], "+", 
       RowBox[{"c2", " ", 
        RowBox[{
         RowBox[{"U2", "[", 
          RowBox[{"k", ",", "\[Alpha]"}], "]"}], "[", "1", "]"}]}]}], "==", 
      "2.3"}]}], "\[IndentingNewLine]", "}"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "u_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"c1", " ", 
     RowBox[{
      RowBox[{"U1", "[", 
       RowBox[{"k", ",", "\[Alpha]"}], "]"}], "[", "u", "]"}]}], "+", 
    RowBox[{"c2", " ", 
     RowBox[{
      RowBox[{"U2", "[", 
       RowBox[{"k", ",", "\[Alpha]"}], "]"}], "[", "u", "]"}]}]}], "/.", 
   "Sub"}]}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<re\>\"", "->", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"f", "[", "u", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<im\>\"", "->", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Im", "[", 
        RowBox[{"f", "[", "u", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], "}"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9837070281952624`*^9, 3.983707064891951*^9}, {
  3.9837070973311777`*^9, 3.9837072932647724`*^9}},
 CellLabel->
  "In[270]:=",ExpressionUUID->"3bd9ae00-c4ce-4268-ab0d-39ac2de08f22"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"c1", "\[Rule]", 
     RowBox[{"0.03674647268650067`", "\[VeryThinSpace]", "-", 
      RowBox[{"0.08684562361482283`", " ", "\[ImaginaryI]"}]}]}], ",", 
    RowBox[{"c2", "\[Rule]", 
     RowBox[{"0.0035855790458406943`", "\[VeryThinSpace]", "+", 
      RowBox[{"0.008474478865136727`", " ", "\[ImaginaryI]"}]}]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{
  3.9837070430688405`*^9, 3.9837070848806396`*^9, {3.9837071344629993`*^9, 
   3.9837071682481265`*^9}, {3.983707209532318*^9, 3.983707293780108*^9}},
 CellLabel->
  "Out[272]=",ExpressionUUID->"70c4543c-bbe2-4192-8758-a125d4a61037"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"0.0035855790458406943`", "\[VeryThinSpace]", "+", 
      RowBox[{"0.008474478865136727`", " ", "\[ImaginaryI]"}]}], ")"}], " ", 
    RowBox[{"ParabolicCylinderD", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "0.5`"}], "-", 
       RowBox[{"4.`", " ", "\[ImaginaryI]"}]}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1.0954451150103321`"}], "+", 
         RowBox[{"1.0954451150103324`", " ", "\[ImaginaryI]"}]}], ")"}], " ", 
       "u"}]}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"0.03674647268650067`", "\[VeryThinSpace]", "-", 
      RowBox[{"0.08684562361482283`", " ", "\[ImaginaryI]"}]}], ")"}], " ", 
    RowBox[{"ParabolicCylinderD", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "0.5`"}], "+", 
       RowBox[{"4.`", " ", "\[ImaginaryI]"}]}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1.0954451150103324`", "\[VeryThinSpace]", "+", 
         RowBox[{"1.0954451150103324`", " ", "\[ImaginaryI]"}]}], ")"}], " ", 
       "u"}]}], "]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.9837070430688405`*^9, 3.9837070848806396`*^9, {3.9837071344629993`*^9, 
