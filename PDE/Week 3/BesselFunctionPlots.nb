Notebook[{

Cell[CellGroupData[{
Cell["Bessel Functions", "Title",
 CellChangeTimes->{{3.977221536103969*^9, 3.9772215393612146`*^9}, {
  3.978004047013856*^9, 
  3.9780040521815844`*^9}},ExpressionUUID->"e92b3264-461f-412b-be27-\
7a2944d06a78"],

Cell[TextData[{
 "Separation of variables on circular/annular domains produces Bessel \
functions that satisfy the ODE\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "2"], 
      RowBox[{"y", "''"}]}], "+", 
     RowBox[{"x", " ", 
      RowBox[{"y", "'"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["x", "2"], "-", 
        SuperscriptBox["\[Alpha]", "2"]}], ")"}], "y"}]}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"c3835d87-acb3-435a-a66e-b106892b6c65"],
 "\nfor different constants ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],ExpressionUUID->
  "b69b797d-0675-401d-ac0c-1fcaab1230bb"],
 ".  A Power Series obtained by substituting the Frobenius expansion\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", 
    RowBox[{
     SubsuperscriptBox["\[Sum]", 
      RowBox[{"k", "=", "0"}], "\[Infinity]"], 
     RowBox[{
      SubscriptBox["a", "k"], 
      SuperscriptBox["x", 
       RowBox[{"k", "+", "r"}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "cf118a4d-0c54-40c9-9f9b-04ae82ce80a2"],
 "\ninto the ODE and equating coefficients gives the definition\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["J", "\[Alpha]"], "(", "x", ")"}], "=", 
    RowBox[{
     SubscriptBox["\[Sum]", "m"], " ", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "m"], 
       RowBox[{
        RowBox[{"m", "!"}], " ", 
        RowBox[{"\[CapitalGamma]", "(", 
         RowBox[{"m", "+", "\[Alpha]", "+", "1"}], ")"}]}]], 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["X", "2"], ")"}], 
       RowBox[{
        RowBox[{"2", " ", "m"}], "+", "\[Alpha]"}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"a4d56547-1804-4357-a586-b325439f1f31"],
 "\nfor solution that are non singular at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "6bb69254-b557-4964-826b-c8de0823c331"],
 ".\nhttps://en.wikipedia.org/wiki/Frobenius_method\n\
https://en.wikipedia.org/wiki/Bessel_function\n"
}], "Text",
 CellChangeTimes->{{3.9780040544115963`*^9, 3.978004127379944*^9}, {
  3.978005543743207*^9, 3.978005827009409*^9}, {3.9780058695727577`*^9, 
  3.978006036962454*^9}, {3.9780127945801134`*^9, 
  3.9780127945801134`*^9}},ExpressionUUID->"3c1880ac-300f-4593-b76b-\
44ea85674b94"],

Cell[CellGroupData[{

Cell["Bessel Plots", "Section",
 CellChangeTimes->{{3.9772216363136516`*^9, 3.977221637169465*^9}, {
