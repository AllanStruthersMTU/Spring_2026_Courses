  3.9780066286305265`*^9}},ExpressionUUID->"d1e86a8b-f4ed-4c55-890a-\
09821f7c2cc0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"BesselJ", "[", 
      RowBox[{"0", ",", "x"}], "]"}], ",", 
     RowBox[{"BesselJ", "[", 
      RowBox[{"1", ",", "x"}], "]"}], ",", 
     RowBox[{"BesselJ", "[", 
      RowBox[{"2", ",", "x"}], "]"}], ",", 
     RowBox[{"BesselJ", "[", 
      RowBox[{"3", ",", "x"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "20"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "3"}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9780060559882536`*^9, 3.9780061307050023`*^9}, {
  3.9780065810305758`*^9, 3.9780065898363657`*^9}},
