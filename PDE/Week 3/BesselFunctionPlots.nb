Cell[CellGroupData[{

Cell["Mode Plots", "Section",
 CellChangeTimes->{{3.9772216363136516`*^9, 3.977221637169465*^9}, {
  3.978006627107469*^9, 3.9780066286305265`*^9}, {3.9780071859857845`*^9, 
