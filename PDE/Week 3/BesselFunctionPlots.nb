Cell[TextData[{
 "In our new notation the cosine eigenmodes for the drum head are\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", 
     RowBox[{"i", ",", "k"}]], "=", " ", 
    RowBox[{
     RowBox[{"cos", "(", 
      RowBox[{"i", " ", "\[Theta]"}], ")"}], 
     RowBox[{
      SubscriptBox["J", "i"], "(", 
      RowBox[{"r", " ", 
       SubscriptBox["j", 
        RowBox[{"i", ",", "k"}]]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"813eeb0d-42ce-48a8-94b8-9d0904352c28"]
}], "Text",
 CellChangeTimes->{{3.9780071937875433`*^9, 3.978007328513095*^9}, {
  3.978007419834377*^9, 
  3.9780074202044683`*^9}},ExpressionUUID->"f7350730-91f7-4ee7-bc48-\
f42eab954ecc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"j", "[", 
      RowBox[{"i", ",", "k"}], "]"}], "=", 
     RowBox[{"N", "[", 
      RowBox[{"BesselJZero", "[", 
       RowBox[{"i", ",", "k"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", "3"}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", 
    RowBox[{"i_", ",", "k_"}], "]"}], "[", 
   RowBox[{"r_", ",", "\[Theta]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Cos", "[", " ", 
    RowBox[{"i", " ", "\[Theta]"}], "]"}], " ", 
   RowBox[{"BesselJ", "[", 
    RowBox[{"i", ",", 
     RowBox[{"r", " ", 
      RowBox[{"j", "[", 
       RowBox[{"i", ",", "k"}], "]"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ParametricPlot3D", "[", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r", " ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ",", " ", 
         RowBox[{"r", " ", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"i", ",", "k"}], "]"}], "[", 
          RowBox[{"r", ",", "\[Theta]"}], "]"}]}], " ", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", " ", 
         RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", "3"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "3"}], "}"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "3"}], "]"}], ",", 
      RowBox[{"Range", "[", 
       RowBox[{"1", ",", "3"}], "]"}]}], "}"}]}]}], "]"}]}], "Input",
