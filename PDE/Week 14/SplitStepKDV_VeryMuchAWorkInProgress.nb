Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tSteps", " ", "=", 
    RowBox[{"Round", "[", 
     RowBox[{"T", "/", "dt"}], "]"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<=", "tSteps"}], ",", 
   RowBox[{"i", "++"}], ",", 
   RowBox[{
    RowBox[{"uhat", " ", "=", " ", 
     RowBox[{
      RowBox[{"FourierShift", "[", 
       RowBox[{"Fourier", "[", "udot", "]"}], "]"}], "*", "fExp"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"ustar", "=", 
     RowBox[{"InverseFourier", "[", "uhat", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"ustar", " ", "=", " ", 
     RowBox[{"ustar", " ", "+", " ", 
      RowBox[{"3", "*", "cfl", "*", "ustar", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"RotateLeft", "[", "ustar", "]"}], "-", 
         RowBox[{"RotateRight", "[", "ustar", "]"}]}], ")"}]}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"uhat", " ", "=", " ", 
     RowBox[{
      RowBox[{"FourierShift", "[", 
       RowBox[{"Fourier", "[", "u", "]"}], "]"}], "*", "fExp"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"udot", "=", 
     RowBox[{"InverseFourier", "[", "uhat", "]"}]}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "[", "u", "]"}], ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"Re", "[", "udot", "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9851733794244785`*^9, 3.9851733796940155`*^9}},
 CellLabel->
  "In[1343]:=",ExpressionUUID->"ae419f50-41a7-444c-909c-fad89fe780f9"],

