Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"FourierShift", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"ResourceFunction", "[", "\"\<FourierShift\>\"", "]"}], "[", "x", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9851733035928955`*^9, 
  3.985173307817871*^9}},ExpressionUUID->"10f1f84c-303e-9642-8f5c-\
790cff5528e7"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "n", ",", "L", ",", "dx", ",", "dt", ",", "x", ",", "k", ",", "u", ",", 
   "U1", ",", "U2", ",", "unew", ",", "ustar", ",", "unews", ",", "uhat", ",",
    "uhats", ",", "udot", ",", "T"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "256"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", "=", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T", "=", "1.35264"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cfl", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dx", " ", "=", " ", 
   RowBox[{"L", "/", "n"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dt", " ", "=", " ", 
   RowBox[{"cfl", "*", "dx"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "L"}], "/", "2"}], "+", 
      RowBox[{"i", "*", "dx"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"k", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "n"}], "/", "2"}], "+", "i", "-", "1"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Initial", " ", 
     RowBox[{"condition", ":", " ", 
      RowBox[{"u", 
       RowBox[{"(", 
        RowBox[{"x", ",", "0"}], ")"}]}]}]}], "=", 
    RowBox[{
     RowBox[{"sech", "^", "2"}], 
     RowBox[{"(", "x", ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u", " ", "=", 
   RowBox[{
    RowBox[{"Sech", "[", "x", "]"}], "^", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fExp", " ", "=", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[ImaginaryI]", "*", 
     SuperscriptBox["k", "3"], "*", 
     FractionBox["dt", "2"]}]]}], ";"}]}], "Input",
 CellChangeTimes->{3.9851733247019463`*^9},
 CellLabel->
  "In[1323]:=",ExpressionUUID->"b893d9e2-5bca-194c-b7d7-7fcd72288603"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"Re", "[", "u", "]"}], "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uhat", " ", "=", " ", 
   RowBox[{
    RowBox[{"Chop", "[", 
     RowBox[{
      RowBox[{"FourierShift", "[", 
       RowBox[{"Fourier", "[", "u", "]"}], "]"}], ",", 
      SuperscriptBox["10", 
       RowBox[{"-", "8"}]]}], "]"}], "*", "fExp"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ustar", "=", 
   RowBox[{"InverseFourier", "[", "uhat", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ustar", " ", "=", " ", 
   RowBox[{"ustar", " ", "+", " ", 
    RowBox[{"3", "*", "cfl", "*", "ustar", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"RotateLeft", "[", "ustar", "]"}], "-", 
       RowBox[{"RotateRight", "[", "ustar", "]"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uhat", " ", "=", " ", 
   RowBox[{
    RowBox[{"Chop", "[", 
     RowBox[{
      RowBox[{"FourierShift", "[", 
       RowBox[{"Fourier", "[", "u", "]"}], "]"}], ",", 
      SuperscriptBox["10", 
       RowBox[{"-", "8"}]]}], "]"}], "*", "fExp"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"udot", "=", 
   RowBox[{"InverseFourier", "[", "uhat", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"Re", "[", "u", "]"}], "]"}], ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"Re", "[", "udot", "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellLabel->
  "In[1334]:=",ExpressionUUID->"e10ed92b-887e-9c4c-a60a-2affc217c6f2"],

