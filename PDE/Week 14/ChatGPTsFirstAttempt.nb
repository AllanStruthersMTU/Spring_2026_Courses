Cell[CellGroupData[{
Cell[TextData[{
 "Numerical methods for\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", 
       SubscriptBox["u", "t"]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["u", "xx"]}], "+"}], "|", "u", 
     SuperscriptBox["|", "2"], "u"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"227144a6-0e5b-402b-b2d6-663b94c4e94e"],
 "\non ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "<", "x", "<", "b"}], TraditionalForm]],ExpressionUUID->
  "2f63e0da-06ed-4fe5-90dc-d80abd0169ea"],
 " with periodic BC."
}], "Title",
 CellChangeTimes->{{3.983619129089838*^9, 3.983619141082221*^9}, {
  3.983619202520323*^9, 3.983619219165579*^9}, {3.9836193506183805`*^9, 
  3.983619373435424*^9}},ExpressionUUID->"4fbe4fe6-ebc6-42e3-9e70-\
c050cc2ce895"],

Cell["\<\
I thought I would see how well ChatGPT would do on our task at hand.   I \
changed N to n\
\>", "Text",
 CellChangeTimes->{{3.985090436525848*^9, 3.985090478166445*^9}, 
   3.985090544734501*^9},ExpressionUUID->"d699c737-62ce-4adb-aa39-\
c8da9b474419"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Strang", " ", "Splitting", " ", "Fourier", " ", "Solver", " ", "for", " ",
     "NLS", " ", 
    RowBox[{"on", "[", 
     RowBox[{
      RowBox[{"-", "L"}], ",", "L"}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "StrangNLS", "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"StrangNLS", "[", 
     RowBox[{
     "f_", ",", "L_", ",", "n_", ",", "dt_", ",", "nt_", ",", "kappa_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "dx", ",", "x", ",", "k", ",", "u", ",", "uhat", ",", "step", ",", 
        "j"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Spatial", " ", "grid"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dx", "=", 
        RowBox[{"2", " ", 
         RowBox[{"L", "/", "n"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"x", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "L"}], "+", 
           RowBox[{"j", " ", "dx"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Fourier", " ", "modes", " ", 
         RowBox[{"(", 
          RowBox[{"Mathematica", " ", "ordering"}], ")"}]}], "*)"}], 
       RowBox[{"k", "=", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", 
             RowBox[{
              RowBox[{"n", "/", "2"}], "-", "1"}]}], "]"}], ",", 
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "n"}], "/", "2"}], ",", 
             RowBox[{"-", "1"}]}], "]"}]}], "]"}], "*", 
         RowBox[{"(", 
          RowBox[{"Pi", "/", "L"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Initial", " ", "condition"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"u", "=", 
        RowBox[{"f", "/@", "x"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"One", " ", "Strang", " ", "step"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"step", "[", "u_", "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"u1", ",", "uhat"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Half", " ", "nonlinear", " ", "step"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"u1", "=", 
            RowBox[{"u", "*", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", "*", "kappa", "*", 
               RowBox[{
                RowBox[{"Abs", "[", "u", "]"}], "^", "2"}], "*", 
               RowBox[{"dt", "/", "2"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Linear", " ", "step", " ", "in", " ", "Fourier", " ", "space"}], 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{"uhat", "=", 
            RowBox[{"Fourier", "[", "u1", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"uhat", "=", 
            RowBox[{"uhat", "*", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], "*", 
               RowBox[{"(", 
                RowBox[{"k", "^", "2"}], ")"}], "*", 
               RowBox[{"dt", "/", "2"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"u1", "=", 
            RowBox[{"InverseFourier", "[", "uhat", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Half", " ", "nonlinear", " ", "step"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"u1", "=", 
            RowBox[{"u1", "*", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", "*", "kappa", "*", 
               RowBox[{
                RowBox[{"Abs", "[", "u1", "]"}], "^", "2"}], "*", 
               RowBox[{"dt", "/", "2"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", "u1"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Time", " ", "stepping"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "=", 
           RowBox[{"step", "[", "u", "]"}]}], ";"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "nt"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<x\>\"", "->", "x"}], ",", 
         RowBox[{"\"\<u\>\"", "->", "u"}]}], "|>"}]}]}], "]"}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.985090507644766*^9, 3.985090595661628*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"d277c4d9-8845-48e0-a1d7-a2ddc95c08ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Example", " ", "usage"}], "*)"}], "\n", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L", "=", "20"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", "256"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dt", "=", "0.01"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nt", "=", "10"}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"kappa", "=", "1"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], ":=", 
     RowBox[{"Sech", "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"result", "=", 
     RowBox[{"StrangNLS", "[", 
      RowBox[{"f", ",", "L", ",", "n", ",", "dt", ",", "nt", ",", "kappa"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xgrid", "=", 
     RowBox[{"result", "[", "\"\<x\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"uFinal", "=", 
     RowBox[{"result", "[", "\"\<u\>\"", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"xgrid", ",", 
        RowBox[{"Abs", "[", "uFinal", "]"}]}], "}"}], "]"}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Optional", ":", "diagnostics"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Mass", "[", 
      RowBox[{"u_", ",", "dx_"}], "]"}], ":=", 
     RowBox[{"dx", " ", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"Abs", "[", "u", "]"}], "^", "2"}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Energy", "[", 
      RowBox[{"u_", ",", "k_", ",", "dx_", ",", "kappa_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "uhat", "}"}], ",", 
       RowBox[{
        RowBox[{"uhat", "=", 
         RowBox[{"Fourier", "[", "u", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dx", " ", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"k", "^", "2"}], ")"}], "*", 
             RowBox[{
              RowBox[{"Abs", "[", "uhat", "]"}], "^", "2"}]}], "]"}], "/", 
           "2"}]}], "-", 
         RowBox[{"dx", "*", "kappa", " ", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "u", "]"}], "^", "4"}], "]"}], "/", 
           "2"}]}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Track", " ", "invariants", " ", "over", " ", "time"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TrackSolution", "[", 
     RowBox[{
     "f_", ",", "L_", ",", "n_", ",", "dt_", ",", "nt_", ",", "kappa_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dx", ",", "x", ",", "k", ",", "u", ",", 
        RowBox[{"masses", "=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"energies", "=", 
         RowBox[{"{", "}"}]}], ",", "step", ",", "j"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dx", "=", 
        RowBox[{"2", " ", 
         RowBox[{"L", "/", "n"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"x", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "L"}], "+", 
           RowBox[{"j", " ", "dx"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"k", "=", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", 
             RowBox[{
              RowBox[{"n", "/", "2"}], "-", "1"}]}], "]"}], ",", 
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "n"}], "/", "2"}], ",", 
             RowBox[{"-", "1"}]}], "]"}]}], "]"}], "*", 
         RowBox[{"(", 
          RowBox[{"Pi", "/", "L"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"u", "=", 
        RowBox[{"f", "/@", "x"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"step", "[", "u_", "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"u1", ",", "uhat"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"u1", "=", 
            RowBox[{"u", "*", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", "*", "kappa", "*", 
               RowBox[{
                RowBox[{"Abs", "[", "u", "]"}], "^", "2"}], "*", 
               RowBox[{"dt", "/", "2"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"uhat", "=", 
            RowBox[{"Fourier", "[", "u1", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"uhat", "=", 
            RowBox[{"uhat", "*", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], "*", 
               RowBox[{"(", 
                RowBox[{"k", "^", "2"}], ")"}], "*", 
               RowBox[{"dt", "/", "2"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"u1", "=", 
            RowBox[{"InverseFourier", "[", "uhat", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"u1", "=", 
            RowBox[{"u1", "*", 
             RowBox[{"Exp", "[", 
              RowBox[{"I", "*", "kappa", "*", 
               RowBox[{
                RowBox[{"Abs", "[", "u1", "]"}], "^", "2"}], "*", 
               RowBox[{"dt", "/", "2"}]}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", "u1"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"masses", ",", 
            RowBox[{"Mass", "[", 
             RowBox[{"u", ",", "dx"}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"energies", ",", 
            RowBox[{"Energy", "[", 
             RowBox[{"u", ",", "k", ",", "dx", ",", "kappa"}], "]"}]}], "]"}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"u", "=", 
           RowBox[{"step", "[", "u", "]"}]}], ";"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "nt"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<mass\>\"", "->", "masses"}], ",", 
         RowBox[{"\"\<energy\>\"", "->", "energies"}]}], "|>"}]}]}], "]"}]}], 
   "\n"}]}]], "Input",
 CellChangeTimes->{{3.985090507644766*^9, 3.9850905226954737`*^9}, {
  3.985090611191411*^9, 3.985090623333703*^9}, {3.985090658214489*^9, 
  3.9850906832065687`*^9}, {3.985090724546795*^9, 3.9850907247336817`*^9}},
 CellLabel->"In[60]:=",ExpressionUUID->"63a9d7df-edc3-41bd-8cdb-68ae62fe37e7"],

