Cell["\<\
There is a simple brutal solution to the amplification of the high \
frequencies. Zero out the middle chunk of high frequencies in the FFT and \
take the real part if you need to. \
\>", "Text",
 CellChangeTimes->{{3.9851826011593647`*^9, 3.9851826130734844`*^9}, {
  3.985183652686596*^9, 3.9851836567546587`*^9}, {3.985183701038981*^9, 
  3.9851837361050453`*^9}, {3.985186796897707*^9, 3.985186877544736*^9}, {
  3.985186929361431*^9, 
  3.9851869488326015`*^9}},ExpressionUUID->"4db4f1eb-bc6f-40c3-a591-\
2b10965dcfa5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"AAS", ":", " ", 
    RowBox[{
    "reordered", " ", "the", " ", "wave", " ", "numbers", " ", "to", " ", 
     "be", " ", "in", " ", "the", " ", "standard", " ", 
     RowBox[{"(", 
      RowBox[{"all", " ", "be", " ", "it", " ", "weird", " ", "order"}], 
      " "}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"AAS", ":", " ", 
    RowBox[{
    "zeroed", " ", "out", " ", "the", " ", "Highest", " ", "Nyquist", " ", 
     "frequency"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"AAS", ":", " ", 
    RowBox[{
    "Take", " ", "a", " ", "look", " ", "at", " ", "the", " ", "k", " ", "to",
      " ", "see", " ", "the", " ", "only", " ", "change"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"k", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{
          RowBox[{"n", "/", "2"}], "-", "1"}]}], "]"}], ",", 
       RowBox[{"{", "0", "}"}], ",", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"1", "-", 
          RowBox[{"n", "/", "2"}]}], ",", 
         RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mask", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Boole", "[", 
         RowBox[{"#", "<", 
          RowBox[{"n", "/", "3"}]}], "]"}], "&"}], ",", "k"}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"AAS", ":", " ", 
     RowBox[{
     "Not", " ", "sure", " ", "if", " ", "I", " ", "messed", " ", "up", " ", 
      "the", " ", "2", " ", "or", " ", "it", " ", "was", " ", "in", " ", 
      "what", " ", "you", " ", "sent", " ", "me"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DerMul1", "=", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "k", "*", 
      FractionBox[
       RowBox[{"2", "\[Pi]"}], "L"]}]}], ";", " ", 
    RowBox[{"DerMul2", "=", 
     SuperscriptBox["DerMul1", "2"]}], ";", 
    RowBox[{"DerMul3", "=", 
     SuperscriptBox["DerMul1", "3"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"uF", "=", 
     RowBox[{"mask", "*", 
      RowBox[{"Fourier", "[", "u", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"up", "=", 
     RowBox[{"Re", "[", 
      RowBox[{"InverseFourier", "[", 
       RowBox[{"DerMul1", "*", "uF"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"upp", "=", 
     RowBox[{"Re", "[", 
      RowBox[{"InverseFourier", "[", 
       RowBox[{"DerMul2", "*", "uF"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"uppp", "=", 
     RowBox[{"Re", "[", 
      RowBox[{"InverseFourier", "[", 
       RowBox[{"DerMul3", "*", "uF"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"TabView", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<Pow Spec u\>\"", "->", 
        RowBox[{"ListLogPlot", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "uF", "]"}], ",", 
          RowBox[{"GridLines", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               FractionBox["n", "3"], ",", 
               RowBox[{"2", 
                FractionBox["n", "3"]}]}], "}"}], ",", "Automatic"}], 
            "}"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<F Ders\>\"", "->", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", "up"}], "}"}], "\[Transpose]"}], ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", "upp"}], "}"}], "\[Transpose]"}], ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", "uppp"}], "}"}], "\[Transpose]"}]}], "}"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"PlotLegends", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
            "\"\<1st Der\>\"", ",", "\"\<2nd Der\>\"", ",", 
             "\"\<3rd Der\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<Der Errs\>\"", "->", 
        RowBox[{"ListLogPlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"Abs", "[", 
                RowBox[{"up", "-", "uP"}], "]"}]}], "}"}], "\[Transpose]"}], 
            ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"Abs", "[", 
                RowBox[{"upp", "-", "uPP"}], "]"}]}], "}"}], "\[Transpose]"}],
             ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"Abs", "[", 
                RowBox[{"uppp", "-", "uPPP"}], "]"}]}], "}"}], 
             "\[Transpose]"}]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"PlotLegends", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
            "\"\<1st Der Err\>\"", ",", "\"\<2nd Der Err\>\"", ",", 
             "\"\<3rd Der Err\>\""}], "}"}]}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "}"}], ",", "2"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9851829603546715`*^9, 3.9851829808064194`*^9}, {
   3.9851830592233715`*^9, 3.9851835987035327`*^9}, 3.9851836294892006`*^9, {
