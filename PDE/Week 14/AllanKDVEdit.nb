Notebook[{
Cell[TextData[{
 "Checking we have the correct constants for a single soliton.   Our equation \
is \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["u", "t"], "+", 
     RowBox[{"6", " ", "u", " ", 
      SubscriptBox["u", "x"]}], "+", 
     SubscriptBox["u", "xxx"]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0d159380-09e6-4023-88c6-bbdaf5550f2e"]
}], "Text",
 CellChangeTimes->{{3.985180249482173*^9, 3.9851802882500906`*^9}, {
  3.9851803254336233`*^9, 3.9851803453362656`*^9}, {3.985180692017398*^9, 
  3.985180693598171*^9}, {3.9851807627394123`*^9, 
  3.98518076457255*^9}},ExpressionUUID->"a2c9ab59-d886-4fc8-b8f9-\
07b185bad69e"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "t"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"uSoliton", "[", "c_", "]"}], "[", 
   RowBox[{"x_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["c", "2"], 
   SuperscriptBox[
    RowBox[{"Sech", "[", 
     RowBox[{
      FractionBox[
       SqrtBox["c"], "2"], 
      RowBox[{"(", 
       RowBox[{"x", "-", 
        RowBox[{"c", " ", "t"}]}], ")"}]}], "]"}], "2"], " "}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.985180170346252*^9, 3.9851802428058915`*^9}, {
   3.9851803515476713`*^9, 3.9851804944408455`*^9}, {3.985180530765463*^9, 
   3.9851806199719048`*^9}, 3.9851806977447057`*^9, {3.9851807386355906`*^9, 
   3.985181010284707*^9}, 3.9851811831142206`*^9, 
   3.9851812324276743`*^9},ExpressionUUID->"035b9a72-c9f7-4d15-85fb-\
a80a6c99b354"],

Cell["Checking the formula and looking at the forms.", "Text",
 CellChangeTimes->{{3.9851812701221685`*^9, 
  3.9851812850985394`*^9}},ExpressionUUID->"783c5e99-e436-4be2-ba86-\
ab0585ad2ef3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "30"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Hmm", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"uSoliton", "[", "c", "]"}], "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "+", 
    RowBox[{"6", " ", 
     RowBox[{
      RowBox[{"uSoliton", "[", "c", "]"}], "[", 
      RowBox[{"x", ",", "t"}], "]"}], "*", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"uSoliton", "[", "c", "]"}], "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", "x"}], "]"}]}], "+", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"uSoliton", "[", "c", "]"}], "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "3"}], "}"}]}], "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"uSoliton", "[", "2", "]"}], "[", 
      RowBox[{
       RowBox[{"x", "-", "7"}], ",", "0"}], "]"}], ",", 
     RowBox[{
      RowBox[{"uSoliton", "[", "4", "]"}], "[", 
      RowBox[{"x", ",", "0"}], "]"}], ",", 
     RowBox[{
      RowBox[{"uSoliton", "[", "8", "]"}], "[", 
      RowBox[{
       RowBox[{"x", "+", "5"}], ",", "0"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{
      RowBox[{"-", "L"}], "/", "2"}], ",", 
     RowBox[{"L", "/", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<c=8\>\"", ",", "\"\<c=4\>\"", ",", "\"\<c=2\>\""}], 
     "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.985180170346252*^9, 3.9851802428058915`*^9}, {
   3.9851803515476713`*^9, 3.9851804944408455`*^9}, {3.985180530765463*^9, 
   3.9851806199719048`*^9}, 3.9851806977447057`*^9, {3.9851807386355906`*^9, 
   3.985181010284707*^9}, 3.9851811831142206`*^9, 
   3.9851812324276743`*^9},ExpressionUUID->"031e3af0-d71f-4641-8ce9-\
54cffc11b1b9"],

Cell["\<\
Checking that the sampling and differentiation formulas are correct. I made \
sure everything was a floating point number by putting decimal points in the \
appropriate pieces.  \
\>", "Text",
 CellChangeTimes->{{3.985181295060255*^9, 
  3.9851813646729918`*^9}},ExpressionUUID->"ebfd8f59-6e91-42c1-a5cc-\
e610367d27e6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "n", ",", "L", ",", "T", ",", "dx", ",", "dt", ",", "x", ",", "k"}], "]"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"AAS", " ", "Combined", " ", "defs", " ", "for", " ", 
       RowBox[{"space", ".", " ", "I"}], " ", "think", " ", "interval", " ", 
       "is"}], " ", "-", 
      RowBox[{"L", "/", "2"}]}], " ", "<", " ", "x", "<", " ", 
     RowBox[{"L", "/", "2"}]}], ",", " ", 
    RowBox[{
    "eliminated", " ", "cfl", " ", "and", " ", "just", " ", "defined", " ", 
     "dx", " ", "and", " ", "dt"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", ",", "L", ",", "T"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"2", "*", "512"}], ",", "20.0", ",", "1.35264"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dx", ",", "dt"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["L", "n"], ",", "0.1"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "AAS", " ", "added", " ", "decimal", " ", "points", " ", "to", " ", "make",
     " ", "sure", " ", "they", " ", "are", " ", 
    RowBox[{"floats", ".", " ", "Visually"}], " ", "checked", " ", "k"}], " ",
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "L"}], "/", "2.0"}], "+", 
       RowBox[{"i", "*", "dx"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Define", " ", "a", " ", "soliton", " ", "profile", " ", "for", " ", "an", 
    " ", "IC"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"uSoliton", "[", "2", "]"}], "[", 
    RowBox[{"x", ",", "0"}], "]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"AAS", ":", " ", 
    RowBox[{
    "f", " ", "is", " ", "a", " ", "function", " ", "u", " ", "is", " ", "a", 
     " ", "vector", " ", "of", " ", "function", " ", "values"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u", "=", 
   RowBox[{"f", "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uP", "=", 
   RowBox[{
    RowBox[{"f", "'"}], "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uPP", "=", 
   RowBox[{
    RowBox[{"f", "''"}], "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uPPP", "=", 
   RowBox[{
    RowBox[{"f", "'''"}], "[", "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "u"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "uP"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "uPP"}], "}"}], "\[Transpose]"}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "uPPP"}], "}"}], "\[Transpose]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<f\>\"", ",", "\"\<f'\>\"", ",", "\"\<f''\>\"", ",", 
      "\"\<f'''\>\""}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{
  3.9851733247019463`*^9, {3.985179749080158*^9, 3.9851797873476806`*^9}, {
   3.98517984730639*^9, 3.9851799147787547`*^9}, {3.985179946232486*^9, 
