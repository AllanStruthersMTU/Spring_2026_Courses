Cell["\<\
Check that we can compute derivatives correctly.  If we include all the modes \
the noise in the high frequency modes gets amplified badly.  Those high \
frequency modes are localized at the ends of our interval. \
\>", "Text",
 CellChangeTimes->{{3.9851826011593647`*^9, 3.9851826130734844`*^9}, {
  3.985183652686596*^9, 3.9851836567546587`*^9}, {3.985183701038981*^9, 
  3.9851837361050453`*^9}, {3.985186796897707*^9, 
  3.985186824635194*^9}},ExpressionUUID->"0c303c80-7a92-4a6b-89ec-\
73870987a872"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"AAS", ":", " ", 
    RowBox[{
    "reordered", " ", "the", " ", "wave", " ", "numbers", " ", "to", " ", 
     "be", " ", "in", " ", "the", " ", "standard", " ", 
     RowBox[{"(", 
      RowBox[{"all", " ", "be", " ", "it", " ", "weird", " ", "order"}], 
      " "}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"AAS", ":", " ", 
    RowBox[{
    "zeroed", " ", "out", " ", "the", " ", "Highest", " ", "Nyquist", " ", 
     "frequency"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"AAS", ":", " ", 
    RowBox[{
    "Take", " ", "a", " ", "look", " ", "at", " ", "the", " ", "k", " ", "to",
      " ", "see", " ", "the", " ", "only", " ", "change"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"k", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{
          RowBox[{"n", "/", "2"}], "-", "1"}]}], "]"}], ",", 
       RowBox[{"{", "0", "}"}], ",", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"1", "-", 
          RowBox[{"n", "/", "2"}]}], ",", 
         RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"AAS", ":", " ", 
     RowBox[{
     "Not", " ", "sure", " ", "if", " ", "I", " ", "messed", " ", "up", " ", 
      "the", " ", "2", " ", "or", " ", "it", " ", "was", " ", "in", " ", 
      "what", " ", "you", " ", "sent", " ", "me"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DerMul1", "=", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "k", "*", 
      FractionBox[
       RowBox[{"2", "\[Pi]"}], "L"]}]}], ";", " ", 
    RowBox[{"DerMul2", "=", 
     SuperscriptBox["DerMul1", "2"]}], ";", 
    RowBox[{"DerMul3", "=", 
     SuperscriptBox["DerMul1", "3"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"uF", "=", 
     RowBox[{"Fourier", "[", "u", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"up", "=", 
     RowBox[{"InverseFourier", "[", 
      RowBox[{"DerMul1", "*", "uF"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"upp", "=", 
     RowBox[{"InverseFourier", "[", 
      RowBox[{"DerMul2", "*", "uF"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"uppp", "=", 
     RowBox[{"InverseFourier", "[", 
      RowBox[{"DerMul3", "*", "uF"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"TabView", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<Pow Spec u\>\"", "->", 
        RowBox[{"ListLogPlot", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "uF", "]"}], ",", 
          RowBox[{"GridLines", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               FractionBox["n", "3"], ",", 
               RowBox[{"2", 
                FractionBox["n", "3"]}]}], "}"}], ",", "Automatic"}], 
            "}"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<F Ders\>\"", "->", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", "up"}], "}"}], "\[Transpose]"}], ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", "upp"}], "}"}], "\[Transpose]"}], ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", "uppp"}], "}"}], "\[Transpose]"}]}], "}"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"PlotLegends", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
            "\"\<1st Der\>\"", ",", "\"\<2nd Der\>\"", ",", 
             "\"\<3rd Der\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<Der Errs\>\"", "->", 
        RowBox[{"ListLogPlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"Abs", "[", 
                RowBox[{"up", "-", "uP"}], "]"}]}], "}"}], "\[Transpose]"}], 
            ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"Abs", "[", 
                RowBox[{"upp", "-", "uPP"}], "]"}]}], "}"}], "\[Transpose]"}],
             ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"Abs", "[", 
                RowBox[{"uppp", "-", "uPPP"}], "]"}]}], "}"}], 
             "\[Transpose]"}]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"PlotLegends", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
            "\"\<1st Der Err\>\"", ",", "\"\<2nd Der Err\>\"", ",", 
             "\"\<3rd Der Err\>\""}], "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"GridLines", "->", "Automatic"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "}"}], ",", "2"}], "]"}]}]}]], "Input",
