Notebook[{

Cell[CellGroupData[{
Cell["\<\
Strang Splitting for NLS
\
\>", "Section",
 CellChangeTimes->{{3.9828522048633337`*^9, 3.982852214940895*^9}, {
  3.983264009139923*^9, 
  3.9832640202797794`*^9}},ExpressionUUID->"6635e341-6d85-4539-a13c-\
7d3eee86012e"],

Cell[TextData[{
 "Code is for \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", 
       SubscriptBox["u", "t"]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["u", "xx"]}], "+"}], "|", "u", 
     SuperscriptBox["|", "2"], "u"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "db76007b-5938-4b33-8219-23186c7897cf"],
 "\nSplitting \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ImaginaryI]", " ", 
     SubscriptBox["u", "t"]}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     SubscriptBox["u", "xx"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "08a11d70-2a53-4ccf-b031-c25024b15d79"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ImaginaryI]", " ", 
     SubscriptBox["u", "t"]}], "=", 
    RowBox[{"-", 
     RowBox[{"|", "u", 
      SuperscriptBox["|", "2"], "u"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eab1b0c4-5e61-4950-a190-ef81c6bad1d1"]
}], "Text",
 CellChangeTimes->{{3.982851969165657*^9, 3.9828521195262604`*^9}, {
   3.9828521676976357`*^9, 3.982852195078617*^9}, 3.9832640306702943`*^9, {
   3.9832640843421664`*^9, 
   3.9832642139513884`*^9}},ExpressionUUID->"5c2f5688-858f-44e6-8aa7-\
22082ca73b6c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NLSStep", "[", 
    RowBox[{"dt_", ",", "LPhase_"}], "]"}], "[", "uIn_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "uHalf", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Convert", " ", "to", " ", "Fourier", " ", "Space", " ", "advance", " ", 
      "by", " ", 
      RowBox[{"\[CapitalDelta]t", "/", "2"}], " ", "using", " ", "k"}], " ", 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"uHalf", "=", 
      RowBox[{
       RowBox[{"Fourier", "[", 
        RowBox[{"uIn", ",", 
         RowBox[{"FourierParameters", "->", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], "*", "LPhase"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Convert", " ", "back", " ", "to", " ", "Physical", " ", "Space", " ", 
       "and", " ", "advance", " ", "by", " ", "\[CapitalDelta]t"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"uHalf", "=", 
      RowBox[{"InverseFourier", "[", 
       RowBox[{"uHalf", ",", 
        RowBox[{"FourierParameters", "->", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uHalf", "=", 
      RowBox[{"uHalf", "+", 
       RowBox[{"dt", " ", 
        SuperscriptBox[
         RowBox[{"Abs", "[", "uHalf", "]"}], "2"], "*", "uHalf"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Back", " ", "to", " ", "Fourier", " ", "and", " ", "complete", " ", 
       "linear", " ", "advance", " ", "by", " ", 
       RowBox[{"\[CapitalDelta]t", "/", "2"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"uHalf", "=", 
      RowBox[{
       RowBox[{"Fourier", "[", 
        RowBox[{"uHalf", ",", 
         RowBox[{"FourierParameters", "->", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], "*", "LPhase"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "back", " ", "to", " ", "physical", " ", "sapce", " ", "and", " ", 
       "return"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"InverseFourier", "[", 
      RowBox[{"uHalf", ",", 
       RowBox[{"FourierParameters", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9832647057648044`*^9, 3.9832651757177563`*^9}, {
  3.983265963342796*^9, 3.9832659808117*^9}},
 CellLabel->
  "In[192]:=",ExpressionUUID->"d14805af-ded4-4fc5-b404-700b82ed27c2"],

Cell["Testing", "Text",
 CellChangeTimes->{{3.9832651962606153`*^9, 
  3.9832651984512477`*^9}},ExpressionUUID->"02f25896-80f3-4443-a862-\
6df2d3d355f6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"Sol", ",", "IC"}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Sol", "[", 
    RowBox[{"{", 
     RowBox[{"\[Eta]_", ",", "v_", ",", "x0_"}], "}"}], "]"}], "[", "x_", 
   "]"}], ":=", 
  RowBox[{"\[Eta]", " ", 
   RowBox[{"Sech", "[", 
    RowBox[{"\[Eta]", " ", 
     RowBox[{"(", 
      RowBox[{"x", "-", "x0"}], ")"}]}], "]"}], " ", 
   RowBox[{"Exp", "[", 
    RowBox[{"I", " ", 
     RowBox[{"(", 
      RowBox[{"v", "/", "2"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"x", "-", "x0"}], ")"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"L", ",", " ", "Nx"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"20.0", ",", "1000"}], "}"}]}], ";", " ", 
  RowBox[{"dx", "=", 
   FractionBox[
    RowBox[{"2.0", "L"}], "Nx"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Eta]1", ",", "v1", ",", "x1"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "0", ",", 
     RowBox[{"-", "10"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Eta]2", ",", "v2", ",", "x2"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "10"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"IC", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Sol", "[", 
        RowBox[{"{", 
         RowBox[{"\[Eta]1", ",", "v1", ",", "x1"}], "}"}], "]"}], "[", "x", 
       "]"}], "+", 
      RowBox[{
       RowBox[{"Sol", "[", 
        RowBox[{"{", 
         RowBox[{"\[Eta]2", ",", "v2", ",", "x2"}], "}"}], "]"}], "[", "x", 
       "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "L"}], ",", 
       RowBox[{"L", "-", "dx"}], ",", "dx"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Abs", "[", "IC", "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<IC\>\""}], ",", 
   RowBox[{"DataRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "L"}], ",", "L"}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Pi", "/", "L"}], ")"}], " ", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"Nx", "/", "2"}], "-", "1"}]}], "]"}], ",", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "Nx"}], "/", "2"}], ",", 
        RowBox[{"-", "1"}]}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dt", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LPhase", "=", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}], " ", 
     RowBox[{"k", "^", "2"}], " ", "dt"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u", "=", 
   RowBox[{
    RowBox[{"NLSStep", "[", 
     RowBox[{"dt", ",", "LPhase"}], "]"}], "[", "IC", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Abs", "[", "IC", "]"}], ",", 
     RowBox[{"Abs", "[", "u", "]"}]}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<IC\>\"", ",", "\"\<\!\(\*SubscriptBox[\(u\), \(1\)]\)\>\""}], 
     "}"}]}], ",", 
   RowBox[{"DataRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "L"}], ",", "L"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9832644262480392`*^9, 3.9832644322643533`*^9}, {
  3.983264473998086*^9, 3.9832644951395807`*^9}, {3.9832653593582306`*^9, 
