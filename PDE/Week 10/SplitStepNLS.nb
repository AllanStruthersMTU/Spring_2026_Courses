Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Parameters", " ", "and", " ", "Grid"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L", "=", "50.0"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Domain", " ", "Size"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "256"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Fourier", " ", "Modes"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dt", "=", "0.001"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Time", " ", "Step"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmax", "=", "10.0"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Total", " ", "Time"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dx", "=", 
     RowBox[{"L", "/", "n"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "L"}], "/", "2"}], "+", 
        RowBox[{"i", "*", "dx"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", 
         RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Initial", " ", 
     RowBox[{"Condition", ":", 
      RowBox[{"Single", " ", "Soliton"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"u", "=", 
     RowBox[{
      RowBox[{"-", "0.5"}], "*", 
      RowBox[{
       RowBox[{"Sech", "[", 
        RowBox[{"0.5", "*", 
         RowBox[{"(", 
          RowBox[{"x", "-", "0"}], ")"}]}], "]"}], "^", "2"}]}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Spectral", " ", "Grid", " ", "and", " ", "Dispersion", " ", 
     "Linear", " ", "Operator"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"k", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "<=", 
           RowBox[{"n", "/", "2"}]}], ",", "i", ",", 
          RowBox[{"i", "-", "n"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"2", "*", 
        RowBox[{"Pi", "/", "L"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"u_xxx", "=", 
     RowBox[{
      RowBox[{"-", "i"}], " ", 
      RowBox[{"k", "^", "3"}], " ", "in", " ", "spectral", " ", "space"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"dispersion", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"I", "*", 
          RowBox[{"k", "^", "3"}]}], ")"}]}], "*", 
       RowBox[{"dt", "/", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"3.", " ", "Split"}], "-", 
     RowBox[{"Step", " ", "Fourier", " ", "Algorithm"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"steps", "=", 
     RowBox[{"Round", "[", 
      RowBox[{"tmax", "/", "dt"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Step", "[", "uIn_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
