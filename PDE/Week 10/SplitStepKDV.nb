Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Step", " ", 
       RowBox[{"A", ":", 
        RowBox[{"Half", " ", "dispersion", " ", "Step"}]}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"uhat", "=", 
        RowBox[{"Fourier", "[", "u", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"uhat", "=", 
        RowBox[{"uhat", "*", "dispersion"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"u", "=", 
        RowBox[{"InverseFourier", "[", "uhat", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Step", " ", 
         RowBox[{"B", ":", 
          RowBox[{"Nonlinear", " ", "Step", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"using", " ", "6", 
              SubscriptBox["uu", "x"]}], "=", 
             RowBox[{"3", 
              SubscriptBox[
               RowBox[{"(", 
                RowBox[{"u", "^", "2"}], ")"}], "x"]}]}]}]}]}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Using", " ", "real", " ", "space", " ", "for", " ", "quadratic", 
          " ", "non"}], "-", "linearity"}], "*)"}], 
       RowBox[{"u", "=", 
        RowBox[{"u", "-", 
         RowBox[{"dt", "*", 
          RowBox[{"(", 
           RowBox[{"3", "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"RotateLeft", "[", "u", "]"}], "-", 
               RowBox[{"RotateRight", "[", "u", "]"}]}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"2", "*", "dx"}], ")"}]}], "*", "2", "*", "u"}], 
           ")"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Simple", " ", "nonlinear", " ", 
          RowBox[{"approximation", ":", "u"}]}], "=", 
         RowBox[{"u", "-", 
          RowBox[{"3", "dt", " ", "u", " ", "ux"}]}]}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{"Step", " ", 
         RowBox[{"C", ":", 
          RowBox[{"Half", " ", "dispersion", " ", "Step"}]}]}], "*)"}], 
       RowBox[{"uhat", "=", 
        RowBox[{"Fourier", "[", "u", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"uhat", "=", 
        RowBox[{"uhat", "*", "dispersion"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"u", "=", 
        RowBox[{"InverseFourier", "[", "uhat", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"i", ",", "100"}], "]"}], "==", "0"}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"solution", ",", 
           RowBox[{"Re", "[", "u", "]"}]}], "]"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "steps"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Visualization"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{"solution", ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}], ",", 
     RowBox[{"Mesh", "->", "None"}], ",", 
     RowBox[{"InterpolationOrder", "->", "2"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<KdV Soliton\>\""}]}], "]"}], 
   "\n"}]}]], "Input",
