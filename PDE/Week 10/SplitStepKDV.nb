Cell[TextData[{
 "Code is for \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "t"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"6", " ", "u", " ", 
       SubscriptBox["u", "x"]}], "-", 
      SubscriptBox["u", "xxx"]}], "=", 
     RowBox[{
      RowBox[{"3", " ", 
       SubscriptBox[
        RowBox[{"(", 
         SuperscriptBox["u", "2"], ")"}], "x"]}], "-", 
      SubscriptBox["u", "xxx"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "df5aadcd-7528-4282-b8df-e5b49c3ada49"],
 "\nDispersion exact in Physical Space. Centered difference for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "x"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "14f5161d-3517-4d81-b2cd-87e1296f35c0"],
 " computed in physical space.  Product ",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", " ", 
    SubscriptBox["u", "x"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a783fdd6-6497-4b40-8e55-2f5c4743a3e8"],
 " computed in physica space. \nStrang Splitting F/2 + N + F/2"
}], "Text",
 CellChangeTimes->{{3.982851969165657*^9, 3.9828521195262604`*^9}, {
  3.9828521676976357`*^9, 
  3.982852195078617*^9}},ExpressionUUID->"5c2f5688-858f-44e6-8aa7-\
22082ca73b6c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Parameters", " ", "and", " ", "Grid"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L", "=", "50.0"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Domain", " ", "Size"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "256"}], ";", 
    RowBox[{"(*", 
     RowBox[{"Fourier", " ", "Modes"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"dt", "=", "0.001"}], ";", 
    RowBox[{"(*", 
     RowBox[{"Time", " ", "Step"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"tmax", "=", "10.0"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Total", " ", "Time"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dx", "=", 
     RowBox[{"L", "/", "n"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "L"}], "/", "2"}], "+", 
        RowBox[{"i", "*", "dx"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", 
         RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Initial", " ", 
     RowBox[{"Condition", ":", 
      RowBox[{"Single", " ", "Soliton"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"u", "=", 
     RowBox[{
      RowBox[{"-", "0.5"}], "*", 
      RowBox[{
       RowBox[{"Sech", "[", 
        RowBox[{"0.5", "*", 
         RowBox[{"(", 
          RowBox[{"x", "-", "0"}], ")"}]}], "]"}], "^", "2"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Spectral", " ", "Grid", " ", "and", " ", "Dispersion", " ", 
     "Linear", " ", "Operator"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"k", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "<=", 
           RowBox[{"n", "/", "2"}]}], ",", "i", ",", 
          RowBox[{"i", "-", "n"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"2", "*", 
        RowBox[{"Pi", "/", "L"}]}], ")"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"u_xxx", "=", 
     RowBox[{
      RowBox[{"-", "i"}], " ", 
      RowBox[{"k", "^", "3"}], " ", "in", " ", "spectral", " ", "space"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dispersion", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"I", "*", 
          RowBox[{"k", "^", "3"}]}], ")"}]}], "*", 
       RowBox[{"dt", "/", "2"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"3.", " ", "Split"}], "-", 
     RowBox[{"Step", " ", "Fourier", " ", "Algorithm"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"steps", "=", 
     RowBox[{"Round", "[", 
      RowBox[{"tmax", "/", "dt"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Step", "[", "uIn_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"uHat", ",", "uOut"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"uHat", "=", 
        RowBox[{"Fourier", "[", "u", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"uHat", "=", 
        RowBox[{"uHat", "*", "dispersion"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"uOut", "=", 
        RowBox[{"InverseFourier", "[", "uHat", "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"uHat", "=", 
        RowBox[{"Fourier", "[", "uOut", "]"}]}]}]}], "\[IndentingNewLine]", 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9828514751263995`*^9, 3.982851538433009*^9}, {
  3.98285158370439*^9, 3.9828516010693984`*^9}, {3.982851650143536*^9, 
  3.982851686404559*^9}, {3.9828517166584864`*^9, 3.982851814893188*^9}, {
  3.9828519300478983`*^9, 3.98285194590879*^9}, {3.9828521396907806`*^9, 
  3.982852140362296*^9}},
