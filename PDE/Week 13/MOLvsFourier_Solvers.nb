Cell[CellGroupData[{

Cell["Phase Shifts and Spectral Methods", "Section",
 CellChangeTimes->{{3.984226818681608*^9, 3.9842268415126524`*^9}, {
  3.9842275608860393`*^9, 3.984227563599924*^9}, {3.9846552590869656`*^9, 
  3.984655263759056*^9}},ExpressionUUID->"398a49aa-bffd-493d-b17d-\
fbd9642456be"],

Cell[TextData[{
 "We want to be able to understand what differentiating with respect to x \
looks like in transform land.  We are going to use the definition pair \
counting from j=1 and k=1 with the scaling on the inverse transform\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["U", "k"], "=", 
    RowBox[{
     SubsuperscriptBox["\[Sum]", 
      RowBox[{"j", "=", "1"}], "n"], 
     RowBox[{
      SubscriptBox["u", "j"], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "2", "\[Pi]", " ", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", "-", "1"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"j", "-", "1"}], ")"}]}], "n"]}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"9bac9b0f-092d-4f7b-9c3a-23818ebe417c"],
 "\nand\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "j"], "=", 
    RowBox[{
     FractionBox["1", "n"], 
     RowBox[{
      SubsuperscriptBox["\[Sum]", 
       RowBox[{"k", "=", "1"}], "n"], 
      RowBox[{
       SubscriptBox["U", "k"], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", "2", "\[Pi]", " ", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"k", "-", "1"}], ")"}], 
           RowBox[{"(", 
            RowBox[{"j", "-", "1"}], ")"}]}], "n"]}]]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"30e72760-10e7-49d3-8992-5216db8d8021"],
 "\nThere are a couple of way to see what this looks like.  I am going to try \
to keep it simple.  "
}], "Text",
 CellChangeTimes->{{3.98448241793021*^9, 3.9844825241543703`*^9}, {
  3.9844825645229716`*^9, 3.9844829561545324`*^9}, {3.984483093755215*^9, 
  3.9844835429955754`*^9}, {3.984483589604799*^9, 3.9844836725556555`*^9}, {
  3.984484095076533*^9, 3.984484098507492*^9}, {3.984484137515668*^9, 
  3.98448421817076*^9}, {3.984484257269266*^9, 3.98448446485298*^9}, {
  3.9844846740443983`*^9, 3.9844846743350945`*^9}, {3.9844860593719234`*^9, 
  3.984486062711611*^9}, {3.9846552795335746`*^9, 
  3.984655283332945*^9}},ExpressionUUID->"3bb5e453-c69c-440a-a9b0-\
f48b21cc3372"],

Cell[TextData[{
 "Since the derivative is \n\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"u", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{
     SubscriptBox["lim", 
      RowBox[{"h", "->", "0"}]], 
     FractionBox[
      RowBox[{
       RowBox[{"u", 
        RowBox[{"(", 
         RowBox[{"x", "+", "h"}], ")"}]}], "-", 
       RowBox[{"u", "(", "x", ")"}]}], "h"]}]}], TraditionalForm]],
  ExpressionUUID->"d924ac9d-db58-4ec2-bbd8-865497a0368e"],
 "\nwe can work out what happens when we sample and take the FFT by shift \
then subtracting and scaling.  This is all easier (and more natural) in the \
complex exponential version. To shift the sines and cosines over by a shift h \
we do \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"cos", "(", 
      RowBox[{"\[DoubleStruckK]", " ", "x"}], ")"}], "+", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"sin", "(", " ", 
       RowBox[{"\[DoubleStruckK]", " ", "x"}], ")"}]}]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[DoubleStruckK]", " ", "x"}]], 
      "\[Rule]", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[DoubleStruckK]", " ", 
        RowBox[{"(", 
         RowBox[{"x", "+", "h"}], ")"}]}]]}], "=", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[DoubleStruckK]"}]], 
      SuperscriptBox["e", 
       RowBox[{"\[ImaginaryI]", " ", "\[DoubleStruckK]", " ", "h"}]]}]}]}], 
   TraditionalForm]],ExpressionUUID->"7ef9108b-22da-446c-82d4-ca3838a0e942"],
 "\nUsing the version starting with the index 1 we have\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"u", "(", 
     SubscriptBox["x", 
      RowBox[{"j", "+", "s"}]], ")"}], "=", 
    RowBox[{
     FractionBox["1", "n"], 
     RowBox[{
      SubsuperscriptBox["\[Sum]", 
       RowBox[{"k", "=", "1"}], "n"], 
      RowBox[{
       StyleBox[
        SubscriptBox["U", "k"],
        FontColor->RGBColor[1, 0, 0]], 
       StyleBox[
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "2", "\[Pi]", " ", 
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{"k", "-", "1"}], ")"}], "s"}], "n"]}]],
        FontColor->RGBColor[1, 0, 0]], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", "2", "\[Pi]", " ", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"k", "-", "1"}], ")"}], 
           RowBox[{"(", 
            RowBox[{"j", "-", "1"}], ")"}]}], "n"]}]]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"df5875c4-2b87-409d-9dca-bc3df84708d5"],
 "\nwhere we have used to short hand ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", "+", "h"}], TraditionalForm]],ExpressionUUID->
  "bd65ae13-211c-427d-b0b3-4f102262d9cd"],
 " subscript to indicate moving the sample points to \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", 
     RowBox[{"j", "+", "h"}]], "=", 
    RowBox[{"a", "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"j", "+", "s"}], ")"}], "\[CapitalDelta]x"}]}]}], 
   TraditionalForm]],ExpressionUUID->"45389162-bebe-4d1b-ab56-f0d6bffba7bd"],
 "\nThis is easy enough to implement and check.  All we really need to do is \
implement the single step version ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "aefc96dc-77e9-429e-8910-403c6e5b2b4a"],
 ". To shift by s points we just multiply the transformed data by the mask \n\
\t\t",
 Cell[BoxData[
  RowBox[{"Table", "[", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k", "-", "1"}], ")"}], "/", "n"}]}]], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]],
  CellChangeTimes->{{3.9844846981723413`*^9, 3.984485147448104*^9}, {
    3.984485232024602*^9, 3.9844853721065197`*^9}, {3.9844854507842255`*^9, 
    3.984486014227292*^9}, 3.9844860692945185`*^9, {3.9844861569507284`*^9, 
    3.9844862418490105`*^9}, {3.984486393222452*^9, 3.984486417296545*^9}, {
    3.984487747202979*^9, 3.984487753425053*^9}, 3.984488514869259*^9, 
    3.9844895807097163`*^9, {3.9844896800957966`*^9, 
    3.9844896804967766`*^9}, {3.984489835967325*^9, 3.984489914511484*^9}, {
    3.984489957039394*^9, 3.984489960810487*^9}, {3.9844900151008773`*^9, 
    3.984490030752429*^9}, {3.984655681448372*^9, 3.98465580481231*^9}, {
    3.9846560929948535`*^9, 3.984656200739812*^9}, {3.984656231900524*^9, 
    3.984656232062476*^9}, {3.984656279425479*^9, 3.984656297499073*^9}, {
    3.984656352916978*^9, 3.98465635509007*^9}, {3.9846564913428946`*^9, 
    3.9846564946700225`*^9}, {3.9847467027675066`*^9, 3.984746779194718*^9}, {
    3.9847468328322086`*^9, 3.9847468484160476`*^9}, {3.9847477149725075`*^9, 
    3.984747866613564*^9}, {3.9847479420994186`*^9, 3.9847479457005925`*^9}, {
    3.984747983847249*^9, 3.984747992926853*^9}, {3.9847480449915075`*^9, 
    3.9847480685658665`*^9}, {3.9847481213245068`*^9, 3.984748166532064*^9}, {
    3.984748234628046*^9, 3.984748235051363*^9}, {3.98474907910843*^9, 
    3.9847490793731947`*^9}, {3.9847492141077957`*^9, 
    3.9847492143890514`*^9}},ExpressionUUID->
  "fba9b9b0-437e-4cf9-ba82-f9f108045ff2"],
 "\nfor a single shift s times.  Even large integer shifts are exact!"
}], "Text",
 CellChangeTimes->{{3.98448241793021*^9, 3.9844825241543703`*^9}, {
