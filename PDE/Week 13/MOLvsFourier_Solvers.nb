     RowBox[{"f", "[", 
      RowBox[{"x", "[", "j", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FData", "=", 
   RowBox[{"Fourier", "[", "fVec", "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ShiftedFData", "=", 
     RowBox[{
      SuperscriptBox["baseshift", "s"], "*", "FData"}]}], ";", 
    "\[IndentingNewLine]", 
