Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", "=", "128"}], ";", 
  RowBox[{"n", "=", 
   RowBox[{
    RowBox[{"2", "*", "m"}], "+", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]x", "=", 
   RowBox[{"2.0", 
    RowBox[{"L", "/", "n"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"2", "+", " ", 
   RowBox[{"7.3", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"5", "\[Pi]", " ", 
      RowBox[{"x", "/", "L"}]}], "]"}]}], "-", 
   RowBox[{"7.7", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"6", "\[Pi]", " ", 
      RowBox[{"x", "/", "L"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "[", "j_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "L"}], "+", 
   RowBox[{"j", " ", "\[CapitalDelta]x"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fix", "[", "n_", "]"}], "[", "m_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"0", "\[LessEqual]", "m", "\[LessEqual]", 
     RowBox[{"n", "/", "2"}]}], ",", "m", ",", " ", 
    RowBox[{"m", "-", "n"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fVec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", "[", "j", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fShiftVec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{
       RowBox[{"x", "[", "j", "]"}], "+", "h"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FData", "=", 
   RowBox[{"Fourier", "[", "fVec", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FShiftData", "=", 
   RowBox[{"Fourier", "[", "fShiftVec", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ShiftMask", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     StyleBox[
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "2", "\[Pi]", " ", 
        FractionBox[
         RowBox[{
          RowBox[{
           RowBox[{"fix", "[", "n", "]"}], "[", 
           RowBox[{"k", "-", "1"}], "]"}], "h"}], "n"]}]],
      FontColor->RGBColor[1, 0, 0]], 
     StyleBox[",",
      FontColor->GrayLevel[0]], 
     StyleBox[
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "n"}], "}"}],
      FontColor->GrayLevel[0]]}], 
    StyleBox["]",
     FontColor->GrayLevel[0]]}]}], 
  StyleBox[";",
   FontColor->GrayLevel[0]]}], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{"ListLogPlot", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Abs", "[", "FData", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Abs", "[", 
      RowBox[{"FShiftData", "-", 
       RowBox[{"ShiftMask", "*", "FData"}]}], "]"}]}], "}"}], 
   "\[IndentingNewLine]", "]"}],
  FontColor->GrayLevel[0]]}], "Input",
 CellChangeTimes->{{3.9844837141507044`*^9, 3.9844839663395033`*^9}, {
