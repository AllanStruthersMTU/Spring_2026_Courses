Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "128"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"baseshift", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2.0", "\[Pi]", " ", "\[ImaginaryI]", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}], "/", "n"}]}]], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", "=", "6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]x", "=", 
   RowBox[{"2.0", 
    RowBox[{"L", "/", "n"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "[", "j_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "L"}], "+", 
   RowBox[{"j", " ", "\[CapitalDelta]x"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", " ", 
  RowBox[{"Sech", "[", 
   RowBox[{"2.3", " ", "x"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fVec", "=", 
   RowBox[{"Table", "[", 
