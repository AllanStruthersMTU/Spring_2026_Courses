Cell["\<\
It is however exact on the sum of wiggles encoded in the first FFT\
\>", "Text",
 CellChangeTimes->{{3.9847547713111696`*^9, 
  3.984754844163454*^9}},ExpressionUUID->"4e535d39-4abb-448b-807a-\
05c62a5021ca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"F", "[", "x_", "]"}], "=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox["n"]], 
    RowBox[{"FData", ".", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
          RowBox[{"x", "/", "L"}], " ", "#"}], "]"}], "&"}], ",", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", 
           RowBox[{
            FractionBox["n", "2"], "-", "1"}], ",", "1"}], "]"}], ",", 
         RowBox[{"{", "0", "}"}], ",", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             FractionBox["n", "2"]}], "+", "1"}], ",", 
           RowBox[{"-", "1"}]}], "]"}]}], "]"}]}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"F", "[", 
      RowBox[{"x", "-", "L"}], "]"}], ",", 
     RowBox[{"f", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "L"}], ",", "L"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9847565813080673`*^9, 3.9847568038949747`*^9}, {
  3.9847641110613413`*^9, 3.9847641250394015`*^9}},
