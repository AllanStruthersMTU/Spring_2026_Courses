Cell["\<\
Remembering that frequencies above n/2 match up with negative frequencies we \
can do the same thing for the derivative.  It will match perfectly with the \
derivative for a pure sin/cosine wiggle.  \
\>", "Text",
 CellChangeTimes->{{3.9847505581442413`*^9, 3.984750703087544*^9}, {
  3.9847507518258495`*^9, 3.9847508294732666`*^9}, {3.9847510536958246`*^9, 
  3.9847510693529525`*^9}, {3.984752393789442*^9, 3.9847524166099977`*^9}, {
  3.9847537669722977`*^9, 3.9847537676906543`*^9}, {3.984754450841784*^9, 
  3.984754497139332*^9}},ExpressionUUID->"bc8784c4-4f4c-4737-88e9-\
da375151a18c"],

Cell[TextData[{
 "Warnings,  Our interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "L"}], "<", "x", "<", "L", " "}], TraditionalForm]],
  ExpressionUUID->"4879ca5f-0209-42e3-b970-87d091968416"],
 "is length 2L.  Many texts have an interval of length L. Half of the FFTs in \
the world have one sign on the exponent. Half have the other.  A sign \
mismatch in a reconstructed derivative means you should flip the green sign \
below. A scaling mismatch means you have the interval length scaling (in red \
below) wrong!"
}], "Text",
 CellChangeTimes->{{3.9847545012953663`*^9, 
  3.9847546871939754`*^9}},ExpressionUUID->"cc419845-3dfd-461e-9d0a-\
fa5e1d588463"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"2", "*", "256"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", "=", "6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]x", "=", 
    RowBox[{"2.0", 
     RowBox[{"L", "/", "n"}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Note", " ", "the", " ", "physical", " ", "wiggle", " ", "counts", " ", 
    "are", " ", "the", " ", "scaling"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", "=", 
   RowBox[{
    RowBox[{
     StyleBox["-",
      FontColor->RGBColor[0, 1, 0]], "\[ImaginaryI]"}], " ", 
    FractionBox[
     RowBox[{"2.0", "\[Pi]"}], 
     StyleBox[
      RowBox[{"2", "L"}],
      FontColor->RGBColor[1, 0, 0]]], 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{
         FractionBox["n", "2"], "-", "1"}], ",", "1"}], "]"}], ",", 
      RowBox[{"{", "0", "}"}], ",", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          FractionBox["n", "2"]}], "+", "1"}], ",", 
        RowBox[{"-", "1"}]}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "[", "j_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "L"}], "+", 
   RowBox[{"j", " ", "\[CapitalDelta]x"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", " ", 
