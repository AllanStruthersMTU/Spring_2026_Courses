Cell[CellGroupData[{

Cell["DFT and FFT", "Subsection",
 CellChangeTimes->{{3.984228108490113*^9, 
  3.9842281161111617`*^9}},ExpressionUUID->"ee610aa4-b748-491b-b6cd-\
b898bfd6288e"],

Cell[TextData[{
 "\nThe FFT is simply a family of efficient recursive implementation of the \
DFT\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", "k"], "=", 
    RowBox[{
     SubsuperscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], 
      RowBox[{"n", "-", "1"}]], 
     RowBox[{
      SubscriptBox["x", "j"], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "2", "\[Pi]", " ", 
        FractionBox["k", "n"], "j"}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "44f006d5-547a-4fe7-bc70-f83c94cf3da3"],
 "\nit splits the n-vector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"0", ":", 
     RowBox[{"n", "-", "1"}]}]], TraditionalForm]],ExpressionUUID->
  "4005a79b-8e47-4f47-bcfb-97e3b43c6c09"],
 " into a sum of wiggles\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "j"], "=", 
    RowBox[{
     FractionBox["1", "n"], 
     RowBox[{
      SubsuperscriptBox["\[Sum]", 
       RowBox[{"k", "=", "0"}], 
       RowBox[{"n", "-", "1"}]], 
      RowBox[{
       SubscriptBox["X", "j"], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", "2", "\[Pi]", " ", 
         FractionBox["j", "n"], "k"}]]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"10cfe77d-6e79-492f-b0b9-4a427d34b91e"],
 ".\nIt is possible (and common) to put the scaling ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "n"], TraditionalForm]],ExpressionUUID->
  "76bd5ab7-03ee-431c-9e0c-9816e070a19a"],
 " in different places!  Since most linear algebra starts at counting at 1.  \
The same transform recipe can look like\n\t   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", "k"], "=", 
    RowBox[{
     SubsuperscriptBox["\[Sum]", 
      RowBox[{"j", "=", "1"}], "n"], 
     RowBox[{
      SubscriptBox["x", "j"], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "2", "\[Pi]", " ", 
        FractionBox[
         RowBox[{"(", 
          RowBox[{"k", "-", "1"}], ")"}], "n"], 
        RowBox[{"(", 
         RowBox[{"j", "-", "1"}], ")"}]}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"ff602f3b-dae6-4446-b55e-5671f7ea5e3a"],
 ".\nAll this does is make counting the wiggles harder. \n1) In the FFT the \
DC component turns up in the first entry of the vector.  This first entry \
should really be labelled with a zero for zero wiggles.\n2) All the wiggle \
counts are off by one as a result.\n3) Aliasing means that the highest wiggle \
counts can be appropriately interpreted as negative wiggle counts since.\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "2", 
      RowBox[{"\[Pi]", "(", 
       RowBox[{
        FractionBox["k", "n"], "j"}], ")"}]}]], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "2", 
        RowBox[{"\[Pi]", "(", 
         RowBox[{
          FractionBox["k", "n"], "j"}], ")"}]}]], ".", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]"}]]}], "=", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "2", 
        RowBox[{"\[Pi]", "(", 
         RowBox[{
          RowBox[{
           FractionBox["k", "n"], "j"}], "-", "1"}], ")"}]}]], "=", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "2", 
        RowBox[{"\[Pi]", "(", 
         RowBox[{
          RowBox[{
           FractionBox["k", "n"], "j"}], "-", "1"}], ")"}]}]]}]}]}], 
   TraditionalForm]],ExpressionUUID->"1f9f1e26-54a0-4006-8d73-f0efa8fd87b7"],
 "\n4) The FFT of a signal with lots of low wiggle counts has symmetry (odd \
and even) about the mid points.\n5) The real and imaginary parts of the FFT \
encode the phase shift of a wave. \nLots of engineering fields like the \
symmetric or almost symmetric version. "
}], "Text",
 CellChangeTimes->{{3.984225053238487*^9, 3.9842251435106115`*^9}, {
  3.984225224534876*^9, 3.98422627874221*^9}, {3.984226310431225*^9, 
  3.9842264169585195`*^9}, {3.9842292846074224`*^9, 3.984229285937834*^9}, {
  3.984229336491335*^9, 
  3.9842293398590517`*^9}},ExpressionUUID->"51c98949-6d05-48d0-bc1e-\
86bba8a2e4c6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", "=", "128"}], ";", 
  RowBox[{"n", "=", 
   RowBox[{"2", "*", "m"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]x", "=", 
   RowBox[{"2.0", 
    RowBox[{"L", "/", "n"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"2", "+", " ", 
   RowBox[{"7.3", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"6", "\[Pi]", " ", 
      RowBox[{"x", "/", "L"}]}], "]"}]}], "-", 
   RowBox[{"7.7", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"6", "\[Pi]", " ", 
      RowBox[{"x", "/", "L"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "[", "j_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "L"}], "+", 
   RowBox[{"j", " ", "\[CapitalDelta]x"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fVec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", "[", "j", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FData", "=", 
   RowBox[{"Fourier", "[", "fVec", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<All\>\"", "->", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "[", "FData", "]"}], ",", 
         RowBox[{"Im", "[", "FData", "]"}]}], "}"}], ",", " ", 
       RowBox[{"PlotLegends", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<re\>\"", ",", "\"\<im\>\""}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<Low\>\"", "->", " ", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "[", "FData", "]"}], ",", 
         RowBox[{"Im", "[", "FData", "]"}]}], "}"}], ",", " ", 
       RowBox[{"PlotLegends", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<re\>\"", ",", "\"\<im\>\""}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "10"}], "}"}], ",", "All"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"PointSize", "[", "0.02", "]"}]}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<High\>\"", "->", " ", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "[", "FData", "]"}], ",", 
         RowBox[{"Im", "[", "FData", "]"}]}], "}"}], ",", " ", 
       RowBox[{"PlotLegends", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<re\>\"", ",", "\"\<im\>\""}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", "-", "10"}], ",", "n"}], "}"}], ",", "All"}], 
         "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"PointSize", "[", "0.02", "]"}]}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "}"}], "]"}]}], "Input",
 CellChangeTimes->{{3.98422642717086*^9, 3.9842267281963453`*^9}, {
