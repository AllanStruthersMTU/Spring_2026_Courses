Cell["\<\
For something that is not a perfect sum of wiggles it is not exact any more. \
\>", "Text",
 CellChangeTimes->{{3.9847547713111696`*^9, 
  3.9847548042338576`*^9}},ExpressionUUID->"aa526d8b-692a-45ee-a2e6-\
84733c1449bf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "128"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", "=", "6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]x", "=", 
   RowBox[{"2.0", 
    RowBox[{"L", "/", "n"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", "=", 
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], " ", 
    FractionBox[
     RowBox[{"2.0", "\[Pi]"}], 
     RowBox[{"2", "L"}]], 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{
         FractionBox["n", "2"], "-", "1"}], ",", "1"}], "]"}], ",", 
      RowBox[{"{", "0", "}"}], ",", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          FractionBox["n", "2"]}], "+", "1"}], ",", 
        RowBox[{"-", "1"}]}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "[", "j_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "L"}], "+", 
   RowBox[{"j", " ", "\[CapitalDelta]x"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", " ", 
  RowBox[{"Sech", "[", "x", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fVec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", "[", "j", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fPrimeVec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "'"}], "[", 
      RowBox[{"x", "[", "j", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fPrimePrimeVec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "''"}], "[", 
      RowBox[{"x", "[", "j", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fPrimePrimePrimeVec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "'''"}], "[", 
      RowBox[{"x", "[", "j", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FData", "=", 
   RowBox[{"Fourier", "[", "fVec", "]"}]}], ";"}], "\n", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<f'\>\"", "->", 
     RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"fPrimeVec", ",", 
         RowBox[{"InverseFourier", "[", 
          RowBox[{"m", "*", "FData"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotLabel", "->", 
        FractionBox[
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"InverseFourier", "[", 
            RowBox[{"m", "*", "FData"}], "]"}], "-", "fPrimeVec"}], "]"}], 
         RowBox[{"Norm", "[", "fPrimeVec", "]"}]]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
          RowBox[{"PointSize", "[", "0.01", "]"}]}], "}"}]}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<f''\>\"", "->", 
     RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"fPrimePrimeVec", ",", 
         RowBox[{"InverseFourier", "[", 
          RowBox[{"m", "*", "m", "*", "FData"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotLabel", "->", 
        FractionBox[
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"InverseFourier", "[", 
            RowBox[{"m", "*", "m", "*", "FData"}], "]"}], "-", 
           "fPrimePrimeVec"}], "]"}], 
         RowBox[{"Norm", "[", "fPrimePrimeVec", "]"}]]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
          RowBox[{"PointSize", "[", "0.01", "]"}]}], "}"}]}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<f'''\>\"", "->", 
     RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"fPrimePrimePrimeVec", ",", 
         RowBox[{"InverseFourier", "[", 
          RowBox[{
           SuperscriptBox["m", "3"], "*", "FData"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotLabel", "->", 
        FractionBox[
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"InverseFourier", "[", 
            RowBox[{
             SuperscriptBox["m", "3"], "*", "FData"}], "]"}], "-", 
           "fPrimePrimePrimeVec"}], "]"}], 
         RowBox[{"Norm", "[", "fPrimePrimePrimeVec", "]"}]]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
          RowBox[{"PointSize", "[", "0.01", "]"}]}], "}"}]}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "}"}], "]"}]}], "Input",
