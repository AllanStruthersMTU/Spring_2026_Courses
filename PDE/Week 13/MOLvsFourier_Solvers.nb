Cell[TextData[{
 "Numerical methods for\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", 
       SubscriptBox["u", "t"]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["u", "xx"]}], "+"}], "|", "u", 
     SuperscriptBox["|", "2"], "u"}], "=", "0"}], TraditionalForm]],
