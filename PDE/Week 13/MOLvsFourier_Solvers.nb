Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":"}]], "Input",
 CellChangeTimes->{{3.9844836763020563`*^9, 
  3.984483679123705*^9}},ExpressionUUID->"4ca77ad2-a9af-4c98-b749-\
e5a4fccd4d44"],

Cell[TextData[{
 "I can shift the function over by h by simply shifting all the sines and \n",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", "(", 
    RowBox[{"x", "+", "h"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "74a61932-3bea-4d14-a309-c8a4f55b24ad"],
 " \n\nIf I shift all the points in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "j"], "=", 
    RowBox[{"a", "+", 
     RowBox[{"j", " ", "\[CapitalDelta]x"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d64076ed-8967-484b-930a-3a07bbbba98a"],
 " over by \[CapitalDelta]x then I get ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", 
     RowBox[{"j", "+", "1"}]], "=", 
    RowBox[{"a", "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"j", "+", "1"}], ")"}], " ", "\[CapitalDelta]x"}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9b4e2151-7b3c-4b80-9130-9d925f943010"],
 ".  Since we are periodi "
}], "Text",
 CellChangeTimes->{{3.98448241793021*^9, 3.9844825241543703`*^9}, {
  3.9844825645229716`*^9, 
  3.9844829438990965`*^9}},ExpressionUUID->"0cd42c39-bad7-4b6f-8622-\
3743928943c9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", "=", "256"}], ";", 
  RowBox[{"n", "=", 
   RowBox[{"2", "*", "m"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]x", "=", 
   RowBox[{"2.0", 
    RowBox[{"L", "/", "n"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"2", "+", 
   RowBox[{"Sin", "[", "\[IndentingNewLine]", 
    RowBox[{"\[AliasDelimiter]", 
     RowBox[{
      RowBox[{
       RowBox[{"]", "\[IndentingNewLine]", 
        RowBox[{"x", "[", "j_", "]"}]}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "L"}], "+", 
         RowBox[{
         "j", " ", "\[CapitalDelta]x", "\[IndentingNewLine]", "fVec"}]}], "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"x", "[", "j", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ListPlot", "[", 
       RowBox[{"fVec", ",", 
        RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
        RowBox[{"DataRange", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "L"}], ",", "L"}], "}"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"FData", "=", 
       RowBox[{"Fourier", "[", "fVec", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"TabView", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\"\<All\>\"", "->", 
          RowBox[{"ListPlot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Re", "[", "FData", "]"}], ",", 
              RowBox[{"Im", "[", "FData", "]"}], ",", 
              RowBox[{"Abs", "[", "FData", "]"}]}], "}"}], ",", " ", 
            RowBox[{"PlotLegends", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<re\>\"", ",", "\"\<im\>\"", ",", "\"\<abs\>\""}], 
              "}"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<All-Abs\>\"", "->", 
          RowBox[{"ListLogPlot", "[", 
           RowBox[{
            RowBox[{"Abs", "[", "FData", "]"}], ",", " ", 
            RowBox[{"PlotLegends", "\[Rule]", 
             RowBox[{"{", "\"\<abs\>\"", "}"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<All-Arg\>\"", "->", 
          RowBox[{"ListPlot", "[", 
           RowBox[{
            RowBox[{"Arg", "[", "FData", "]"}], ",", " ", 
            RowBox[{"PlotLegends", "\[Rule]", 
             RowBox[{"{", "\"\<arg\>\"", "}"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<Low\>\"", "->", " ", 
          RowBox[{"ListPlot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Re", "[", "FData", "]"}], ",", 
              RowBox[{"Im", "[", "FData", "]"}]}], "}"}], ",", " ", 
            RowBox[{"PlotLegends", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<re\>\"", ",", "\"\<im\>\""}], "}"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"PlotRange", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"1", ",", "20"}], "}"}], ",", "All"}], "}"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"PlotStyle", "\[Rule]", 
             RowBox[{"PointSize", "[", "0.02", "]"}]}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<High\>\"", "->", " ", 
          RowBox[{"ListPlot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Re", "[", "FData", "]"}], ",", 
              RowBox[{"Im", "[", "FData", "]"}]}], "}"}], ",", " ", 
            RowBox[{"PlotLegends", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"\"\<re\>\"", ",", "\"\<im\>\""}], "}"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"PlotRange", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"n", "-", "20"}], ",", "n"}], "}"}], ",", "All"}], 
              "}"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"PlotStyle", "\[Rule]", 
             RowBox[{"PointSize", "[", "0.02", "]"}]}]}], "]"}]}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}]}]}]}]}]}], "Input",
 CellChangeTimes->{{3.9842268659798594`*^9, 3.9842270146637955`*^9}, {
