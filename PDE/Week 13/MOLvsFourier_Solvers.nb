Cell["\<\
We need to understand (in as many ways as possible) the effects of our \
different approximate differentiation matrices.   \
\>", "Text",
 CellChangeTimes->{{3.9836197179241514`*^9, 3.983619743298258*^9}, {
  3.9836199953979006`*^9, 3.9836200114132075`*^9}, {3.9836200550017977`*^9, 
  3.9836200630665855`*^9}, {3.983620111696805*^9, 
  3.983620188844254*^9}},ExpressionUUID->"a22bd2b3-e6cc-4569-baf4-\
950547b751a2"],

Cell[TextData[{
 "Here is what a MOL formulation looks like for the heat equation\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "t"], "=", 
    SubscriptBox["u", "xx"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "57f2b3a8-042f-4d62-be60-280d2297a487"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"u", "(", 
     RowBox[{"x", ",", "0"}], ")"}], "=", 
    RowBox[{"f", "(", "x", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "67dacf58-d333-48ff-8524-2664d633b823"],
 "\non the interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "29973102-7e63-4dc6-8298-9efabb949dba"],
 " with periodic boundary conditions.  Approximate the solution at the \
spatial points\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "j"], "=", 
    RowBox[{"a", "+", 
     RowBox[{"j", " ", "\[CapitalDelta]x"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d8d18546-0fe1-4192-afa5-cf8a871a01c9"],
 "\nwith ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]x", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"b", "-", "a"}], ")"}], "/", "n"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "67db2aac-6f60-4172-be13-bcca4aeb081a"],
 "  and assemble the approximations\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["u", "j"], "(", "t", ")"}], "\[TildeTilde]", 
    RowBox[{"u", "(", 
     RowBox[{
      RowBox[{"a", "+", 
       RowBox[{"j", " ", "\[CapitalDelta]x"}]}], ",", "t"}], ")"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "00715f50-e318-44fa-8793-559d56d76aa1"],
 "\ninto  the vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"u", "(", "t", ")"}], "=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["u", "1"], "(", "t", ")"}], ",", "\[Ellipsis]", ",", 
      RowBox[{
       SubscriptBox["u", "n"], "(", "t", ")"}]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e36d9c0e-4433-45d7-a172-9b0121ecdd91"],
 " the approximate the second derivative operator with your choice of the \
second derivative matrices. You get \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"u", "'"}], "=", 
    RowBox[{
     SubscriptBox["D", "2"], ".", "u"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e5aba123-3952-44ef-a4c0-91b2326b6c0e"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"u", "(", "0", ")"}], "=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"f", "(", 
       SubscriptBox["x", "1"], ")"}], ",", 
      RowBox[{"f", "(", 
       SubscriptBox["x", "2"], ")"}], ",", "\[Ellipsis]", ",", 
      RowBox[{"f", "(", 
       SubscriptBox["x", "n"], ")"}]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "49fd123d-e9f2-446a-87e5-df91efc0a67e"]
}], "Text",
 CellChangeTimes->{{3.984049765106259*^9, 3.9840500405518637`*^9}, {
  3.9840505502061706`*^9, 
  3.984050853705865*^9}},ExpressionUUID->"b42ee675-38e0-480a-824b-\
4fcaaba416a4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "12"}], ";", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "L"}], ",", "L"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"2", "*", "128"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]x", "=", 
   RowBox[{"2.0", " ", 
    RowBox[{"L", "/", "n"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "[", "j_", "]"}], ":=", " ", 
  RowBox[{"a", "+", " ", 
   RowBox[{"\[CapitalDelta]x", " ", "j"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"2", "+", 
   RowBox[{"1.2", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"3", " ", "\[Pi]", " ", 
      RowBox[{"x", "/", "L"}]}], "]"}]}], "-", 
   RowBox[{"0.4", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"2", " ", "\[Pi]", " ", 
      RowBox[{"x", "/", "L"}]}], "]"}]}], "+", 
   RowBox[{"3.2", 
    RowBox[{"Sin", "[", 
     RowBox[{"5", " ", "\[Pi]", " ", 
      RowBox[{"x", "/", "L"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u0", "=", 
   RowBox[{"Table", "[", " ", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", "[", "j", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"D2", "=", 
   RowBox[{"D2v", "[", 
    RowBox[{"\[CapitalDelta]x", ",", "n"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TMax", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"uSol", "=", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"u", "'"}], "[", "t", "]"}], "==", 
       RowBox[{"D2", ".", 
        RowBox[{"u", "[", "t", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"u", "[", "0", "]"}], "==", "u0"}]}], "}"}], ",", "u", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "0", ",", " ", "TMax"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TSteps", "=", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"uSol", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", " ", "TMax", ",", " ", 
       RowBox[{"TMax", "/", "TSteps"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ListPlot3D", "[", 
   RowBox[{"Data", ",", 
    RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9840508929933076`*^9, 3.984050933625082*^9}, {
   3.98405096876724*^9, 3.984051131975933*^9}, {3.9840515385219793`*^9, 
   3.9840518039683456`*^9}, {3.984056123092594*^9, 3.984056263797956*^9}, {
   3.9840563478608212`*^9, 3.9840563484011745`*^9}, {3.9840564147414136`*^9, 
   3.9840564151438713`*^9}, {3.9840564544763765`*^9, 3.984056455445243*^9}, {
   3.984056764679676*^9, 3.9840567653191643`*^9}, 3.984056872956736*^9},
 CellLabel->
  "In[623]:=",ExpressionUUID->"789f8cf4-3651-4a09-995e-b1262f3e9e9d"],

