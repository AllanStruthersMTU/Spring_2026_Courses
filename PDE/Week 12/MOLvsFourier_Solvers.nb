Cell["\<\
We need to understand (in as many ways as possible) the effects of our \
different approximate differentiation matrices.   \
\>", "Text",
 CellChangeTimes->{{3.9836197179241514`*^9, 3.983619743298258*^9}, {
  3.9836199953979006`*^9, 3.9836200114132075`*^9}, {3.9836200550017977`*^9, 
