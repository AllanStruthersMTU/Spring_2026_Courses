}, Open  ]],

Cell[CellGroupData[{

Cell["Spectral Methods", "Section",
 CellChangeTimes->{{3.9828522048633337`*^9, 3.982852214940895*^9}, {
   3.983264009139923*^9, 3.9832640202797794`*^9}, {3.9836200323626432`*^9, 
