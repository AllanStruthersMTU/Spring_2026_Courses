   3.9836202398018503`*^9},ExpressionUUID->"6635e341-6d85-4539-a13c-\
7d3eee86012e"],

Cell[TextData[{
 "We need to understand and check the Fourier solvers for linear PDEs.  The \
first thing we need to understand is the order that our FFT puts the pieces \
in.   We decided we are doing a periodic problem on the interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "L"}], "<", "x", "<", "L"}], TraditionalForm]],
  ExpressionUUID->"df12728e-f4b2-4fb4-ba07-ce42bae3c171"],
 ".  We are going to assume our data is of length ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "7ddc3f4d-d77b-48fb-8cbf-5c091b205185"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "=", 
    RowBox[{
     RowBox[{"-", "L"}], "+", "\[CapitalDelta]x"}]}], TraditionalForm]],
  ExpressionUUID->"c4ca87df-883a-4ff2-8c10-c8e11a0f5a4a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], "=", 
    RowBox[{
     RowBox[{"-", "L"}], "+", 
     RowBox[{"2", " ", "\[CapitalDelta]x"}]}]}], TraditionalForm]],
  ExpressionUUID->"c86a6cc9-ddd2-48f8-b4cb-8b0a4ad751d3"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "n"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "L"}], "+", 
      RowBox[{"n", " ", "\[CapitalDelta]x"}]}], "=", "L"}]}], 
   TraditionalForm]],ExpressionUUID->"3fb6f353-d6c9-4d48-94d6-946a7a4add65"],
 " "
}], "Text",
 CellChangeTimes->{{3.9836197179241514`*^9, 3.983619743298258*^9}, {
  3.9836199953979006`*^9, 3.9836200114132075`*^9}, {3.9836200550017977`*^9, 
  3.9836200630665855`*^9}, {3.983620159201912*^9, 3.9836201612726865`*^9}, {
  3.983620250179385*^9, 
  3.98362047204679*^9}},ExpressionUUID->"ca56e35b-7ce9-4083-9171-\
da63d854c7e6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"FourierShift", "[", 
   RowBox[{"data_", "?", "ArrayQ"}], "]"}], ":=", 
  RowBox[{"FourierShift", "[", 
   RowBox[{"data", ",", "All"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FourierShift", "[", 
   RowBox[{
    RowBox[{"data_", "?", "ArrayQ"}], ",", "dim_"}], "]"}], ":=", 
  RowBox[{"Block", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"ArrayDepth", "@", "data"}]}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"n", "[", 
       RowBox[{"[", "dim", "]"}], "]"}], "=", 
      RowBox[{"Check", "[", "\n", "      ", 
       RowBox[{
        RowBox[{
         RowBox[{"Ceiling", "[", 
          RowBox[{
           RowBox[{"Dimensions", "[", "data", "]"}], "/", "2"}], "]"}], "[", 
         RowBox[{"[", "dim", "]"}], "]"}], ",", "\n", "      ", 
        RowBox[{"Return", "[", 
         RowBox[{"data", ",", "Block"}], "]"}]}], "\n", "  ", "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"RotateLeft", "[", 
      RowBox[{"data", ",", "n"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellLabel->
  "In[438]:=",ExpressionUUID->"3b6e61fe-aa27-496f-928a-d27a6d5d8a3d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", "=", "128"}], ";", 
  RowBox[{"n", "=", 
   RowBox[{"2", "*", "m"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]x", "=", 
   RowBox[{"2.0", 
    RowBox[{"L", "/", "n"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"2", "+", " ", 
   RowBox[{"7.3", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"6", "\[Pi]", " ", 
      RowBox[{"x", "/", "L"}]}], "]"}]}], "-", 
   RowBox[{"7.7", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"4", " ", "\[Pi]", " ", 
      RowBox[{"x", "/", "L"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "[", "j_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "L"}], "+", 
   RowBox[{"j", " ", "\[CapitalDelta]x"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fVec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", "[", "j", "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", "fVec", "]"}]}], "Input",
 CellChangeTimes->{{3.983620486383108*^9, 3.9836206259300966`*^9}, {
