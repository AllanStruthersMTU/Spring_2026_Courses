Cell["The outside of the unit circle.", "Subsection",
 CellChangeTimes->{{3.9843942877790337`*^9, 
  3.9843943146078677`*^9}},ExpressionUUID->"98e63fdf-15af-419c-949d-\
6d9eff26ef7b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "z_", "]"}], ":=", 
  RowBox[{"z", "+", 
   RowBox[{"1", "/", "z"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rMin", ",", "rMax"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Theta]Min", ",", "\[Theta]Max"}], "}"}]}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1.1", ",", "3.2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"2", "\[Pi]"}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"ReIm", "[", 
    RowBox[{"f", "[", 
     RowBox[{"r", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "rMin", ",", "rMax"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "\[Theta]Min", ",", "\[Theta]Max"}], "}"}], ",", 
   RowBox[{"Mesh", "->", "Automatic"}]}], "]"}]}], "Input",
