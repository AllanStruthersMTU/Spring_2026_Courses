Cell[CellGroupData[{

Cell["The Joukowski airfoil", "Subsection",
 CellChangeTimes->{{3.9843942877790337`*^9, 3.984394324839347*^9}, {
  3.9843945901703978`*^9, 
  3.9843945946541615`*^9}},ExpressionUUID->"6ff3b398-2653-46c0-8e10-\
67e9c6e0c75d"],

Cell[TextData[{
 "Apparently the image of any circle passing through ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["z", "1"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ff43e573-a745-4b93-b03c-11305a4ea48d"],
 " and enclosing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["z", "2"], "=", 
    RowBox[{"-", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3a2671de-2684-4503-9a05-3b44edb5867b"],
 " is mapped onto something that looks like an airfoil!  The center of the \
circle is a single complex parameter.  The radius ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0a0d7a33-88e7-4533-a672-d4a148db6359"],
 " is the distance to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "88dca3e6-bbd4-432a-a349-8198740faa22"],
 ". Of course, to be useful the radius needs to be large enough to enclose \
the non-conformal point at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", 
    RowBox[{"-", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f904c53-8da3-4919-b932-ebd02e0e28e3"],
 " in the mapping ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "+", 
    FractionBox["1", "z"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2bc5a3ab-3e03-4a59-8a86-cdd55a4e582a"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", 
    RowBox[{"-", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c4697192-993c-4f37-ad1e-bbcba3d2baf0"]
}], "Text",
