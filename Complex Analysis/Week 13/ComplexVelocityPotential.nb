Cell[TextData[{
 "are one complex parameter c The center of a circle through ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "82f1cb9d-1c6e-464c-93eb-b7bf7defff7c"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eba83bfe-5cb1-4060-8887-4f70955cac92"],
 " is \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"center", " ", "=", 
    RowBox[{"0", "+", 
     RowBox[{"\[ImaginaryI]", " ", "c"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "259fc324-c874-4bbb-a89f-44fd203405a3"],
 " \nfor some c because it lies on the perpendicular to the bisector. Our \
three equations for the circle through a third point ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "+", 
    RowBox[{"\[ImaginaryI]", " ", "y"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d4dd316b-cf51-4284-8ac5-f587b7a91f69"],
 " are \n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {"1", "+", 
      SuperscriptBox["c", "2"], "=", 
      SuperscriptBox["r", "2"]},
     {
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "2"], "+", 
      SuperscriptBox["c", "2"], "=", 
      SuperscriptBox["r", "2"]},
     {
      SuperscriptBox["x", "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"c", "-", "y"}], ")"}], "2"], "=", 
      SuperscriptBox["r", "2"]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0b823271-f6e5-4f9c-9049-1df1424bdf13"],
 "\nSolving the first two gives \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["r", "2"], "=", 
    RowBox[{
     SuperscriptBox["c", "2"], "+", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e46d578a-b6be-4618-ac45-6f3c6cd5e8fb"],
 "\nand plugging into the last equation gives\n\t",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      SuperscriptBox["x", "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"c", "-", "y"}], ")"}], "2"], "=", 
      RowBox[{
       SuperscriptBox["c", "2"], "+", "1"}]}
    }], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "978fde96-87c0-4750-8bb2-cf86cbb7db2c"],
 "\nExpanding and canceling the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5096376d-1d6d-4bd8-8a7f-a10e22aad737"],
 " on both sides gives \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "2"], "+", 
       SuperscriptBox["y", "2"]}], ")"}], "-", 
     RowBox[{"2", " ", "c", " ", "y"}]}], " ", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "815d861c-1a01-4fb1-920a-027086b316bb"],
 "\nwhich gives (provided ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "\[NotEqual]", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "df4cd247-2250-4fc6-90f2-0487b9f31e10"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", 
    FractionBox[
     RowBox[{
      SuperscriptBox["x", "2"], "+", 
      SuperscriptBox["y", "2"], "-", "1"}], 
     RowBox[{"2", " ", "y"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "21b066eb-7b9b-4ea0-a4ed-666dfe77eec4"],
 " and of course ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["c", "2"], "+", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "44075c91-4db9-4ff7-859a-436acb6f4914"],
 ". "
}], "Text",
 CellChangeTimes->{{3.9843946026550484`*^9, 3.984394672405312*^9}, {
  3.9843950174675226`*^9, 3.9843950841454344`*^9}, {3.9843951405919547`*^9, 
