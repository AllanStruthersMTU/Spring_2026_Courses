5219c4932559"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "xMin", ",", "xMax", ",", "yMin", ",", "yMax", ",", "vel", ",", "x", ",", 
   "y", ",", "div", ",", "curl"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xMin", ",", "xMax"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"yMin", ",", "yMax"}], "}"}]}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vel", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Sin", "[", 
     RowBox[{"x", " ", "+", "y"}], "]"}], ",", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"x", "-", 
      SuperscriptBox["y", "2"]}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"div", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], "]"}], "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"vel", "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], "]"}], "\[LeftDoubleBracket]", "1", 
       "\[RightDoubleBracket]"}], ",", "x"}], "]"}], "+", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"vel", "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], "]"}], "\[LeftDoubleBracket]", "2", 
       "\[RightDoubleBracket]"}], ",", "y"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"curl", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], "]"}], "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"vel", "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], "]"}], "\[LeftDoubleBracket]", "2", 
       "\[RightDoubleBracket]"}], ",", "x"}], "]"}], "-", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"vel", "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], "]"}], "\[LeftDoubleBracket]", "1", 
       "\[RightDoubleBracket]"}], ",", "y"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<vel\>\"", "->", 
      RowBox[{"(", 
       RowBox[{"streamPic", "=", 
        RowBox[{"StreamPlot", "[", 
         RowBox[{
          RowBox[{"vel", "[", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", "yMin", ",", "yMax"}], "}"}]}], "]"}]}], ")"}]}],
      ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<div\>\"", "->", 
      RowBox[{"(", 
       RowBox[{"curlPic", "=", 
        RowBox[{"ContourPlot", "[", 
         RowBox[{
          RowBox[{"div", "[", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", "yMin", ",", "yMax"}], "}"}], ",", 
          RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}], ")"}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"\"\<curl\>\"", "->", 
      RowBox[{"(", 
       RowBox[{"curlPic", "=", 
        RowBox[{"ContourPlot", "[", 
         RowBox[{
          RowBox[{"curl", "[", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", "yMin", ",", "yMax"}], "}"}], ",", 
          RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}], ")"}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"\"\<vel & div\>\"", " ", "->", 
      RowBox[{"Show", "[", 
       RowBox[{"divPic", ",", "streamPic"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<vel & curl\>\"", " ", "->", 
      RowBox[{"Show", "[", 
       RowBox[{"curlPic", ",", "streamPic"}], "]"}]}]}], 
    "\[IndentingNewLine]", "}"}], ",", "4"}], "]"}]}], "Input",
