Cell[TextData[{
 "The conformal mapping\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "\[Rule]", 
    RowBox[{"z", "+", 
     RowBox[{"1", "/", "z"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "00912573-35ea-4284-91ec-6473e7a114e5"],
 "\ndoes nice things to the inside and outside of the unit circle!"
}], "Text",
 CellChangeTimes->{{3.984394064889411*^9, 3.9843941150144014`*^9}, {
  3.98439453314579*^9, 
  3.9843945337171297`*^9}},ExpressionUUID->"7c2d7b12-bb1d-4db7-8819-\
0816054f374a"],

