Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "z_", "]"}], ":=", 
  RowBox[{"z", "+", 
   RowBox[{"1", "/", "z"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rMin", ",", "rMax"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Theta]Min", ",", "\[Theta]Max"}], "}"}]}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.1", ",", "0.9"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"2", "\[Pi]"}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"ReIm", "[", 
    RowBox[{"f", "[", 
     RowBox[{"r", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "rMin", ",", "rMax"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "\[Theta]Min", ",", "\[Theta]Max"}], "}"}], ",", 
   RowBox[{"Mesh", "->", "Automatic"}]}], "]"}]}], "Input",
