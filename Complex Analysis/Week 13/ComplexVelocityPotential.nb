       "\[RightDoubleBracket]"}], ",", "x"}], "]"}], "-", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"vel", "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], "]"}], "\[LeftDoubleBracket]", "1", 
       "\[RightDoubleBracket]"}], ",", "y"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<vel\>\"", "->", 
      RowBox[{"(", 
       RowBox[{"streamPic", "=", 
        RowBox[{"StreamPlot", "[", 
         RowBox[{
          RowBox[{"vel", "[", 
