Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"paddleWheel", "=", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"(*", "Axle", "*)"}], 
      RowBox[{"Gray", ",", 
       RowBox[{"Cylinder", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", 
             RowBox[{"-", "0.5"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0.5"}], "}"}]}], "}"}], ",", "0.1"}],
         "]"}], ",", 
       RowBox[{"(*", "Hub", "*)"}], 
       RowBox[{"Darker", "[", "Gray", "]"}], ",", 
       RowBox[{"Cylinder", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", 
             RowBox[{"-", "0.1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0.1"}], "}"}]}], "}"}], ",", "0.3"}],
         "]"}], ",", 
       RowBox[{"(*", "Blades", "*)"}], 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"LightBlue", ",", 
           RowBox[{"Rotate", "[", 
            RowBox[{
             RowBox[{"Cuboid", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "0.05"}], ",", "0.3", ",", 
                 RowBox[{"-", "0.4"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"0.05", ",", "1.2", ",", "0.4"}], "}"}]}], "]"}], ",", 
             RowBox[{"i", "*", "2", " ", 
              RowBox[{"Pi", "/", "6"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "5"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"Boxed", "->", "False"}], ",", 
     RowBox[{"Lighting", "->", "\"\<Neutral\>\""}]}], "]"}]}], 
  "\n"}]], "Input",
 CellChangeTimes->{{3.9844637524040804`*^9, 3.9844637524040804`*^9}},
