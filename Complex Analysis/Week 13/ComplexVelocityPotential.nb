Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "xMin", ",", "xMax", ",", "yMin", ",", "yMax", ",", "vel", ",", "x", ",", 
   "y", ",", "curl"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xMin", ",", "xMax"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"yMin", ",", "yMax"}], "}"}]}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vel", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"y", " ", 
     RowBox[{"ArcTan", "[", "x", " ", "]"}]}], ",", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"Sin", "[", 
      RowBox[{"x", "-", 
       SuperscriptBox["y", "2"]}], "]"}], "]"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"curl", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], "]"}], "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"vel", "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], "]"}], "\[LeftDoubleBracket]", "2", 
       "\[RightDoubleBracket]"}], ",", "x"}], "]"}], "-", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"vel", "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], "]"}], "\[LeftDoubleBracket]", "1", 
       "\[RightDoubleBracket]"}], ",", "y"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<vel\>\"", "->", 
      RowBox[{"(", 
       RowBox[{"streamPic", "=", 
        RowBox[{"StreamPlot", "[", 
         RowBox[{
          RowBox[{"vel", "[", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", "yMin", ",", "yMax"}], "}"}]}], "]"}]}], ")"}]}],
      ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<curl\>\"", "->", 
      RowBox[{"(", 
       RowBox[{"curlPic", "=", 
        RowBox[{"ContourPlot", "[", 
         RowBox[{
          RowBox[{"curl", "[", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}], "]"}], ",", 
