Cell["\<\
It might help visualization to have a draggable 2D square and/or circle to \
see circulation and accumulation.  A drop down with some sample functions \
would be useful with a \[OpenCurlyDoubleQuote]pop-up\[CloseCurlyDoubleQuote] \
entry box. Are the colors OK? \
\>", "Text",
 CellChangeTimes->{{3.9844645141693115`*^9, 
  3.984464646109312*^9}},ExpressionUUID->"594b9a74-3c16-4d50-b470-\
aff1edfcfe07"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "Dimensions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"hubRadius", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "size", " ", "of", " ", "the", " ", "center", " ", 
     "cylinder"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hubThickness", "=", "0.4"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
    "How", " ", "thick", " ", "the", " ", "center", " ", "hub", " ", "is"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bladeLength", "=", "0.8"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
    "How", " ", "far", " ", "each", " ", "blade", " ", "sticks", " ", "out", 
     " ", "from", " ", "the", " ", "hub"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bladeWidth", "=", "0.4"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"The", " ", 
     RowBox[{"height", "/", "width"}], " ", "of", " ", "the", " ", "flat", 
     " ", "blade", " ", "face"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bladeThickness", "=", "0.05"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "thickness", " ", "of", " ", "the", " ", "blade", " ", 
     "material"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numBlades", "=", "5"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"Total", " ", "number", " ", "of", " ", "blades"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "the", " ", "3", "D", " ", "Model"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Center", " ", "Hub"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"EdgeForm", "[", "Red", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"Gray", ",", 
         RowBox[{"Cylinder", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", 
               RowBox[{
                RowBox[{"-", "hubThickness"}], "/", "2"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", 
               RowBox[{"hubThickness", "/", "2"}]}], "}"}]}], "}"}], ",", 
           "hubRadius"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Individual", " ", "Blades"}], "*)"}], 
       RowBox[{"{", 
        RowBox[{"LightGray", ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Rotate", "[", 
            RowBox[{
             RowBox[{"Cuboid", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"hubRadius", ",", 
                 RowBox[{
                  RowBox[{"-", "bladeThickness"}], "/", "2"}], ",", 
                 RowBox[{
                  RowBox[{"-", "bladeWidth"}], "/", "2"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"hubRadius", "+", "bladeLength"}], ",", 
                 RowBox[{"bladeThickness", "/", "2"}], ",", 
                 RowBox[{"bladeWidth", "/", "2"}]}], "}"}]}], "]"}], ",", "a",
              ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "0", ",", 
             RowBox[{
              RowBox[{"2", " ", "Pi"}], "-", 
              RowBox[{"(", 
               RowBox[{"2", " ", 
                RowBox[{"Pi", "/", "numBlades"}]}], ")"}]}], ",", 
             RowBox[{"2", " ", 
              RowBox[{"Pi", "/", "numBlades"}]}]}], "}"}]}], "]"}]}], "}"}]}],
       "}"}], ",", 
     RowBox[{"Boxed", "->", "True"}], ",", 
     RowBox[{"Lighting", "->", "\"\<Neutral\>\""}]}], "]"}], 
   "\n"}]}]], "Input",
 CellChangeTimes->{{3.984463844448134*^9, 3.9844639425055*^9}, {
  3.984463979565378*^9, 3.9844640474014044`*^9}},
 CellLabel->
  "In[397]:=",ExpressionUUID->"fc4362a2-ad13-429c-ac4b-a1826a624c47"],

