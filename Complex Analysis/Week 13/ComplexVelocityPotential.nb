Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xMin", ",", "xMax"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"yMin", ",", "yMax"}], "}"}]}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Epsilon]", "=", "0.001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "z_", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1.2", "+", "\[ImaginaryI]"}], ")"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"3.2", " ", "-", 
      RowBox[{"2", " ", "\[ImaginaryI]"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"z", "+", 
        RowBox[{"\[Epsilon]", " ", "\[ImaginaryI]"}]}]], "-", 
      FractionBox["1", 
       RowBox[{"z", "-", 
        RowBox[{"\[Epsilon]", " ", "\[ImaginaryI]"}]}]]}], 
     ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vel", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"ReIm", "[", 
    RowBox[{
     RowBox[{"f", "'"}], "[", 
     RowBox[{"x", "+", 
      RowBox[{"\[ImaginaryI]", " ", "y"}]}], "]"}], "]"}], "*", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"-", "1"}]}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"Im", "[", 
      RowBox[{"f", "[", 
       RowBox[{"x", "+", 
        RowBox[{"\[ImaginaryI]", " ", "y"}]}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "yMin", ",", "yMax"}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
