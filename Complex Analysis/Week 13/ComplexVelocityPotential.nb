Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "xMin", ",", "xMax", ",", "yMin", ",", "yMax", ",", "vel", ",", "x", ",", 
   "y", ",", "div", ",", "curl"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xMin", ",", "xMax"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"yMin", ",", "yMax"}], "}"}]}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vel", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Sin", "[", 
     RowBox[{"x", " ", "+", "y"}], "]"}], ",", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"x", "-", 
      SuperscriptBox["y", "2"]}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"div", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], "]"}], "=", 
   RowBox[{
    RowBox[{"D", "[", 
