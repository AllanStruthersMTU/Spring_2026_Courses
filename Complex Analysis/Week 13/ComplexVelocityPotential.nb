Cell[CellGroupData[{

Cell[TextData[{
 "Complex Velocity Potential and Streamlines\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "z", ")"}], "=", 
    RowBox[{
     RowBox[{"\[Phi]", "(", 
      RowBox[{"x", ",", "y"}], ")"}], "+", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"\[Psi]", "(", 
       RowBox[{"x", ",", "y"}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7c2eba70-a90c-481e-bee3-687b582a60b2"]
}], "Section",
 CellChangeTimes->{{3.984392432224165*^9, 3.984392465357293*^9}, {
  3.9843928731706944`*^9, 3.984392895732264*^9}, {3.9843932809368825`*^9, 
  3.9843932889283*^9}},ExpressionUUID->"aed76d1e-4756-4a6e-bc31-a0105f848f70"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xMin", ",", "xMax"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"yMin", ",", "yMax"}], "}"}]}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "z_", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1.2", "+", "\[ImaginaryI]"}], ")"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"3.2", " ", "-", 
      RowBox[{"2", " ", "\[ImaginaryI]"}]}], ")"}], "/", 
    "z"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vel", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"ReIm", "[", 
    RowBox[{
     RowBox[{"f", "'"}], "[", 
     RowBox[{"x", "+", 
      RowBox[{"\[ImaginaryI]", " ", "y"}]}], "]"}], "]"}], "*", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"-", "1"}]}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<flow\>\"", "->", 
     RowBox[{"(", 
      RowBox[{"flowPic", "=", 
       RowBox[{"StreamPlot", "[", 
        RowBox[{
         RowBox[{"vel", "[", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "yMin", ",", "yMax"}], "}"}]}], "]"}]}], ")"}]}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<\[Phi] = re(f)\>\"", "->", 
     RowBox[{"(", 
      RowBox[{"\[Phi]Pic", "=", "\[IndentingNewLine]", 
       RowBox[{"ContourPlot", "[", 
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"f", "[", 
           RowBox[{"x", "+", 
            RowBox[{"\[ImaginaryI]", " ", "y"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "yMin", ",", "yMax"}], "}"}], ",", 
         RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}], ")"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<\[Psi] = im(f)\>\"", "->", 
     RowBox[{"(", 
      RowBox[{"\[Psi]Pic", "=", "\[IndentingNewLine]", 
       RowBox[{"ContourPlot", "[", 
        RowBox[{
         RowBox[{"Im", "[", 
          RowBox[{"f", "[", 
           RowBox[{"x", "+", 
            RowBox[{"\[ImaginaryI]", " ", "y"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "yMin", ",", "yMax"}], "}"}], ",", 
         RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}], ")"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<flow & \[Phi]\>\"", "->", 
     RowBox[{"Show", "[", 
      RowBox[{"\[Phi]Pic", ",", "flowPic"}], "]"}]}], ",", 
