Cell[TextData[{
 "An analytic function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "z", ")"}], "=", 
    RowBox[{
     RowBox[{"\[Phi]", "(", 
      RowBox[{"x", ",", "y"}], ")"}], "+", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"\[Psi]", "(", 
       RowBox[{"x", ",", "y"}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "55b43019-39c7-4856-ab06-0a60c8c2870c"],
 " gives a fluid velocity field\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "z", ")"}]}], "=", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "y"}], ")"}], "-", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"v", "(", 
       RowBox[{"x", ",", "y"}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e8565747-ec56-4da3-aa4d-1697d2284e6e"],
 "\nsatisfying the incompressibility equation\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], "u"}], "+", 
     RowBox[{
      SubscriptBox["\[PartialD]", "y"], "v"}]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c1cd3157-a3a0-4487-80f7-bbbbeed42bc5"],
 "\nand the irrotational equation\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "x"], "v"}], "-", 
     RowBox[{
      SubscriptBox["\[PartialD]", "y"], "u"}]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3bc48185-9868-4dc4-967e-f9c222b904b1"],
 ".\nIf you have never seen the 2D curl is is just the third component of the \
3D curl of \[OpenCurlyDoubleQuote]2D\[CloseCurlyDoubleQuote] velocity field \t\
\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "y"}], ")"}], ",", 
     RowBox[{"v", "(", 
      RowBox[{"x", ",", "y"}], ")"}], ",", "0"}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9b174b9f-e0c7-47e5-b864-bfd917fef300"],
 " \t   "
}], "Text",
 CellChangeTimes->{{3.9843899987017283`*^9, 3.984390270764145*^9}, {
  3.984390341857332*^9, 
  3.9843904536234045`*^9}},ExpressionUUID->"bdc0e180-ac60-49e2-8ac1-\
23b68b189803"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Curl", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"v", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.984390303451399*^9, 3.984390335177726*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"9072d99d-fe2e-460e-9173-9fd1fbb2f544"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      SuperscriptBox["u", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"0", ",", "1"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"x", ",", "y"}], "]"}]}], "+", 
    RowBox[{
     SuperscriptBox["v", 
      TagBox[
       RowBox[{"(", 
        RowBox[{"1", ",", "0"}], ")"}],
       Derivative],
      MultilineFunction->None], "[", 
     RowBox[{"x", ",", "y"}], "]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.98439032352992*^9, 3.9843903358258495`*^9}},
 CellLabel->"Out[2]=",ExpressionUUID->"c671dbf1-31d3-4a3e-ac15-6c789dfa9feb"]
}, Open  ]],

Cell[TextData[{
 "The point is that the velocity potential ",
 Cell[BoxData[
  FormBox["\[Phi]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d78a1d9a-1e8e-4011-ac48-fb2f09bc2484"],
 " and the stream function ",
 Cell[BoxData[
  FormBox["\[Psi]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8bcaffae-bdf7-41c8-9125-995963675534"],
 "  are automatic given any analytic function.  This is like finding a huge \
library of 2D flows.  Some of those flows were useful in the relatively early \
development of flight. We do need to be careful about the minis sign on the \
y-component of the velocity.  "
}], "Text",
 CellChangeTimes->{{3.984390468861195*^9, 3.984390641190241*^9}, {
  3.984391289736518*^9, 
  3.984391337535316*^9}},ExpressionUUID->"72045bff-cc92-435e-981f-\
9e04d97cbdfe"]
}, Closed]]
}, Open  ]]
},
