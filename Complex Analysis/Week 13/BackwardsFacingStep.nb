Cell[TextData[{
 "We are going to simply integrate numerically starting (on the positive \
side) at the middle of the branch cut ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", ".", "e", ".", " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d74f189d-f5d6-4246-9c44-bc6fcb6e62aa"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["z", "0"], "=", 
    RowBox[{"0.5", "+", 
     RowBox[{"\[Epsilon]", " ", "\[ImaginaryI]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c53fba9e-ddee-4a92-a663-932dbb47af9b"],
 ".   As a first pass we are going to integrate along the straight line ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Zeta]", "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["z", "0"], "(", 
      RowBox[{"1", "-", "t"}], ")"}], "+", 
     RowBox[{"z", " ", "t"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "31f14210-5b54-4573-9eac-2cbae86c84a7"],
 "  for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "t", "\[LessEqual]", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0a2ce8ab-d51d-47cc-adee-d0b91e0cb700"],
 ". Our parametric definition of the integral gives simply\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"F", "(", "z", ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", "1"], 
     RowBox[{
      RowBox[{
       RowBox[{"fPrime", "[", 
        RowBox[{"\[Zeta]", "(", "t", ")"}], "]"}], ".", 
       RowBox[{"\[Zeta]", "'"}]}], 
      RowBox[{"(", "t", ")"}], "dt"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dca5f1f3-b3af-4334-a136-6642249f475b"]
}], "Text",
 CellChangeTimes->{{3.984645390959627*^9, 3.9846456920600133`*^9}, {
  3.984646182721768*^9, 
  3.9846461888804407`*^9}},ExpressionUUID->"daafc058-0139-419f-b1ca-\
934bc3ed5227"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"F", ",", "z"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fPrime", "[", "z_", "]"}], ":=", 
   FormBox[
    SqrtBox[
     FractionBox["z", 
      RowBox[{"z", "-", "1"}]]],
    TraditionalForm]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"F", "[", "z_", "]"}], ":=", " ", 
  RowBox[{
   FractionBox["2", "\[Pi]"], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Epsilon]", "=", 
          SuperscriptBox["10", 
           RowBox[{"-", "12"}]]}], ",", "z0"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"z0", "=", 
         RowBox[{"0.5", "+", " ", "I"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"fPrime", "[", 
            RowBox[{
             RowBox[{"z0", "*", 
              RowBox[{"(", 
               RowBox[{"1", "-", "t"}], ")"}]}], "+", 
             RowBox[{"z", " ", "t"}]}], "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"z", "-", "z0"}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}], "-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "0.7218177375894088`"}], "-", 
       RowBox[{"0.332635825352444`", " ", "\[ImaginaryI]"}]}], ")"}]}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"F", "[", "1", "]"}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"ReIm", "[", 
    RowBox[{"F", "[", 
     RowBox[{"x", "+", " ", 
      RowBox[{"\[ImaginaryI]", " ", "y"}]}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "3"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Mesh", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9846451912564535`*^9, 3.98464519885413*^9}, {
   3.984645725119258*^9, 3.9846459465569715`*^9}, {3.984645985586828*^9, 
   3.9846459912987165`*^9}, {3.9846460216211834`*^9, 3.984646022722313*^9}, {
   3.984651604146429*^9, 3.9846516097386465`*^9}, 3.984651875719247*^9, {
   3.9846519561757154`*^9, 3.9846520229270177`*^9}, {3.9846520576742697`*^9, 
   3.984652065510331*^9}},
 CellLabel->
  "In[149]:=",ExpressionUUID->"a5ff892b-bf16-4a32-801d-144a58cd2d7e"],

Cell[BoxData[
 RowBox[{"6.933226832238761`*^-10", "-", 
  RowBox[{"1.000000000677309`", " ", "\[ImaginaryI]"}]}]], "Output",
 CellChangeTimes->{3.984652067072488*^9},
 CellLabel->
  "Out[152]=",ExpressionUUID->"a4a41a76-fd55-4e34-93a2-0cd48652473a"],

