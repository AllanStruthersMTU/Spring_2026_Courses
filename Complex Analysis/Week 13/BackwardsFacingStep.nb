Notebook[{

Cell[CellGroupData[{
Cell["Backwards Facing Step", "Title",
 CellChangeTimes->{{3.977221536103969*^9, 3.9772215393612146`*^9}, {
  3.983794043000835*^9, 3.983794083982617*^9}, {3.984129904724113*^9, 
  3.984129915291833*^9}, {3.9843899755313625`*^9, 3.9843899936703787`*^9}, {
  3.9846435854939632`*^9, 3.9846436153336935`*^9}, {3.984644340355582*^9, 
  3.9846443438846674`*^9}},ExpressionUUID->"e92b3264-461f-412b-be27-\
7a2944d06a78"],

Cell[TextData[{
 "The SC map should have \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "z", ")"}]}], "=", 
    RowBox[{"C", " ", 
     SqrtBox[
      FractionBox["z", 
       RowBox[{"z", "-", "1"}]]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "20cdd565-635c-4409-a674-b623786706ba"],
 "\nThe backwards facing step should have a corner with angle ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[Pi]"}], "/", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "701b1ec9-28f0-4531-a01a-3f0a09559442"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "245556ba-e900-433d-b4d2-eaa2c3810bef"],
 " and a corner with angle ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Pi]", "/", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9d2168be-3217-479a-a847-e63c596e9c3d"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", "1."}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fe52cda0-9600-46bc-8968-a241504ad857"],
 " "
}], "Text",
 CellChangeTimes->{{3.9846452086849174`*^9, 3.984645345151674*^9}, {
   3.9846462114714346`*^9, 3.984646353297124*^9}, 
   3.984647937481819*^9},ExpressionUUID->"5fbf76aa-534a-429b-9b9b-\
e698b7e3df4b"],

Cell["\<\
It is a pain to make an analytic integral which respects the appropriate \
branch cut\
\>", "Text",
 CellChangeTimes->{{3.9846452086849174`*^9, 3.984645345151674*^9}, {
  3.9846462114714346`*^9, 
  3.984646353297124*^9}},ExpressionUUID->"0a792b2e-2836-43a0-844d-\
6c9216289646"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"F", ",", "z"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"F", "[", "z_", "]"}], "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    FormBox[
     SqrtBox[
      FractionBox["z", 
       RowBox[{"z", "-", "1"}]]],
     TraditionalForm], ",", "z"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"F", "'"}], "[", "z", "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", 
  RowBox[{"F", ",", "z"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9846506660823298`*^9, 3.984650672774642*^9}, {
  3.984650779321906*^9, 3.984650820276601*^9}, {3.9846508899950757`*^9, 
  3.9846509033147497`*^9}},
 CellLabel->
  "In[121]:=",ExpressionUUID->"ab2e7ab9-ad69-48ae-8692-c8167ee356a7"],

Cell[BoxData[
 FractionBox[
  RowBox[{"z", " ", 
   RowBox[{"(", 
    RowBox[{
     SqrtBox[
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "z"}], ")"}], " ", "z"}], ")"}]}]], "+", 
     RowBox[{"ArcSin", "[", 
      SqrtBox[
       RowBox[{"1", "-", "z"}]], "]"}]}], ")"}]}], 
  RowBox[{
   SqrtBox[
    FractionBox["z", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "z"}]]], " ", 
   SqrtBox[
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "z"}], ")"}], " ", "z"}], 
      ")"}]}]]}]]], "Output",
 CellChangeTimes->{
  3.9846506890704856`*^9, {3.9846507841592937`*^9, 3.9846508209058094`*^9}, 
   3.9846509038500495`*^9},
 CellLabel->
  "Out[122]=",ExpressionUUID->"2d92420c-3438-4269-993b-ff21c4cf2ab6"],

Cell[BoxData[
 SqrtBox[
  FractionBox["z", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "z"}]]]], "Output",
 CellChangeTimes->{
  3.9846506890704856`*^9, {3.9846507841592937`*^9, 3.9846508209058094`*^9}, 
   3.9846509038670416`*^9},
 CellLabel->
  "Out[123]=",ExpressionUUID->"f040e04b-5286-405b-9f5c-4c814b677844"]
}, Open  ]],

