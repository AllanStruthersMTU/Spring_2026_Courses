Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"c", "=", "1"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Define", " ", "a", " ", "new", " ", "log", " ", "like", " ", "function"}],
    " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logcut", "[", "z_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Log", "[", 
    RowBox[{"z", "-", "1"}], "]"}], "-", 
   RowBox[{"Log", "[", "z", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "z_", "]"}], ":=", 
  RowBox[{"c", 
   RowBox[{"(", 
    RowBox[{
     SqrtBox[
      RowBox[{"z", 
       RowBox[{"(", 
        RowBox[{"z", "-", "1"}], ")"}]}]], "-", 
     RowBox[{"logcut", "[", 
      RowBox[{
       SqrtBox["z"], "+", 
       SqrtBox[
        RowBox[{"z", "-", "1"}]]}], "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", " ", 
