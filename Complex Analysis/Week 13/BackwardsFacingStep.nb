          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "z"}], ")"}], " ", "z"}], ")"}]}]], "+", 
      RowBox[{"ArcSin", "[", 
       SqrtBox[
        RowBox[{"1", "-", "z"}]], "]"}]}], ")"}]}], 
