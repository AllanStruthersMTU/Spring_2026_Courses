90c3cddf422b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   SqrtBox[
    FractionBox["z", 
     RowBox[{"z", "-", "1"}]]], ",", "z"}], "]"}]], "Input",
 CellChangeTimes->{{3.984644755114009*^9, 3.984644790080658*^9}, {
  3.9846450526494064`*^9, 3.984645065063964*^9}, {3.9846460569472127`*^9, 
  3.9846460572933846`*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"a80c4a6e-6b21-41ef-944a-83eb493daee4"],

Cell[BoxData[
 FractionBox[
  RowBox[{"z", " ", 
   RowBox[{"(", 
    RowBox[{
     SqrtBox[
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "z"}], ")"}], " ", "z"}], ")"}]}]], "+", 
     RowBox[{"ArcSin", "[", 
      SqrtBox[
       RowBox[{"1", "-", "z"}]], "]"}]}], ")"}]}], 
  RowBox[{
   SqrtBox[
    FractionBox["z", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "z"}]]], " ", 
   SqrtBox[
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "z"}], ")"}], " ", "z"}], 
      ")"}]}]]}]]], "Output",
 CellChangeTimes->{3.9846450661097527`*^9, 3.9846460580007772`*^9},
 CellLabel->
  "Out[106]=",ExpressionUUID->"1a333e1a-7114-4280-b38b-e7fc1609a353"]
}, Open  ]],

