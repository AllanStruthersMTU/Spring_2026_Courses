Notebook[{

Cell[CellGroupData[{
Cell["Newton\[CloseCurlyQuote]s Method in \[DoubleStruckCapitalC]", "Title",
 CellChangeTimes->{{3.977221536103969*^9, 3.9772215393612146`*^9}, {
  3.9785261618603115`*^9, 
  3.9785261692503614`*^9}},ExpressionUUID->"e92b3264-461f-412b-be27-\
7a2944d06a78"],

Cell[TextData[{
 "Newton\[CloseCurlyQuote]s method \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["z", 
     RowBox[{"n", "+", "1"}]], "=", 
    RowBox[{
     SubscriptBox["z", "n"], "-", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "(", 
        SubscriptBox["z", "n"], ")"}], "/", 
       RowBox[{"f", "'"}]}], 
      RowBox[{"(", 
       SubscriptBox["z", "n"], ")"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "a810b031-dac9-4b4b-ad7b-912bfcd17c58"],
 "\nproduces a sequence of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["z", "n"], "\[Element]", "\[DoubleStruckCapitalC]"}], 
   TraditionalForm]],ExpressionUUID->"6fb2749b-ca03-48f3-985b-6a0c754c6118"],
 " for any ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "0"], TraditionalForm]],ExpressionUUID->
  "d239b4ff-86a1-4ec2-867a-5dd10b15920d"],
 " that hopefully converges to a root of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "z", ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"3c96c515-c92c-4d1b-b77b-144a3e828c6d"],
 ". "
}], "Text",
 CellChangeTimes->{{3.97852617488507*^9, 
  3.978526292449755*^9}},ExpressionUUID->"28c5a02c-5af6-435b-910f-\
d28219e4197c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["z", "3"], "-", "1"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NewtonStep", "[", "f_", "]"}], "[", "z_", "]"}], ":=", 
  RowBox[{"z", "-", 
   RowBox[{
    RowBox[{"f", "[", "z", "]"}], "/", 
    RowBox[{
     RowBox[{"f", "'"}], "[", "z", "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z0", "=", 
   RowBox[{
    RowBox[{"-", "1.0"}], "I"}]}], " ", ";", " ", 
  RowBox[{"nMax", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"NestList", "[", 
  RowBox[{
   RowBox[{"NewtonStep", "[", "f", "]"}], ",", "z0", ",", "nMax"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Nest", "[", 
  RowBox[{
   RowBox[{"NewtonStep", "[", "f", "]"}], ",", "z0", ",", "nMax"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.978526294923954*^9, 3.978526298584879*^9}, {
