Cell[TextData[{
 "The equation ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox["z", "3"], "-", "1"}], " ", "=", "0"}]],
  CellChangeTimes->{{3.978526294923954*^9, 3.978526298584879*^9}, {
   3.978526364278699*^9, 3.9785264708341985`*^9}, {3.9785265074503613`*^9, 
   3.978526573610855*^9}},ExpressionUUID->
  "058c8045-d4c4-4444-bff8-f5906f8311c4"],
 " has three roots ",
 Cell[BoxData[
  FormBox["1.0", TraditionalForm]],ExpressionUUID->
  "7359db71-42d2-4db0-a22d-1ebe494bc8dc"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "0.5"}], "\[PlusMinus]", 
    RowBox[{"0.866025", " ", "\[ImaginaryI]"}]}], TraditionalForm]],
  ExpressionUUID->"6eb44879-0771-49f9-879e-93dcdf3d3045"],
 ".  Here is what happens if you run Newton\[CloseCurlyQuote]s method a bunch \
of times on a grid of points in the complex plane.  "
}], "Text",
 CellChangeTimes->{{3.9785264960864344`*^9, 3.9785265008901253`*^9}, {
  3.978526584539606*^9, 3.978526602944699*^9}, {3.978527736842987*^9, 
  3.978527867402011*^9}, {3.9787803575482388`*^9, 
  3.9787803575482388`*^9}},ExpressionUUID->"c86436d5-ac62-4f27-afe8-\
f84e8d292461"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"IterMax", "=", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "[", "z_", "]"}], ":=", " ", 
  RowBox[{"z", "-", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["z", "3"], "-", "1"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"3", 
      SuperscriptBox["z", "2"]}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"0.0", "+", 
     RowBox[{"0.0", " ", "\[ImaginaryI]"}]}], "]"}], " ", "=", " ", 
   RowBox[{"0.0", " ", "+", 
    RowBox[{"0.0", " ", "\[ImaginaryI]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "100"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xMax", ",", "yMax"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"2.0", ",", "2.0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xMin", ",", "yMin"}], "}"}], "=", 
   RowBox[{"-", 
    RowBox[{"{", 
     RowBox[{"xMax", ",", "yMax"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[CapitalDelta]x", ",", "\[CapitalDelta]y"}], "}"}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"xMax", ",", "yMax"}], "}"}], "/", "n"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Data", "=", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"Nest", "[", 
       RowBox[{"g", ",", 
        RowBox[{"x", " ", "+", " ", 
         RowBox[{"I", " ", "y"}]}], ",", "IterMax"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
       "y", ",", " ", "yMin", ",", " ", "yMax", ",", " ", 
        "\[CapitalDelta]y"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", "yMin", ",", "xMax", ",", " ", "\[CapitalDelta]x"}], 
       "}"}]}], "]"}]}], ";"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixPlot", "[", 
  RowBox[{"Data", ",", "\[IndentingNewLine]", 
   RowBox[{"ColorRules", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "0.5`"}], "-", 
        RowBox[{"0.8660254037844386`", " ", "\[ImaginaryI]"}]}], "->", 
       "Red"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "0.5`"}], "+", 
        RowBox[{"0.8660254037844386`", " ", "\[ImaginaryI]"}]}], "->", 
       "Green"}], ",", " ", 
      RowBox[{
       RowBox[{"1.0", "+", 
        RowBox[{"0.0", " ", "\[ImaginaryI]"}]}], "->", "Blue"}]}], "}"}]}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"DataRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "xMax"}], ",", "xMax"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "yMax"}], ",", "yMax"}], "}"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9785266102434597`*^9, 3.978526797408265*^9}, {
