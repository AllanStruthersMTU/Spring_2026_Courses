Notebook[{

Cell[CellGroupData[{
Cell["\<\
Power Series 
atan(z)\
\>", "Title",
 CellChangeTimes->{{3.977221536103969*^9, 3.9772215393612146`*^9}, {
  3.9785261618603115`*^9, 3.9785261692503614`*^9}, {3.979205453784933*^9, 
  3.9792054731761045`*^9}},ExpressionUUID->"e92b3264-461f-412b-be27-\
7a2944d06a78"],

Cell[TextData[{
 "We had several different representations of atan(z) for complex z\n1) \
Whatever the computer does ArcTan[z].\n2) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["\[ImaginaryI]", 
     RowBox[{"2", " "}]], 
    RowBox[{"Log", "[", 
     FractionBox[
      RowBox[{"\[ImaginaryI]", "+", "z"}], 
      RowBox[{"\[ImaginaryI]", "-", "z"}]], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "82dd34bd-d73e-404f-913f-b7faaf28ef93"],
 "\n3) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Sum]", 
      RowBox[{"n", "=", "0"}], "\[Infinity]"], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "n"], 
      FractionBox[
       SuperscriptBox["z", 
        RowBox[{
         RowBox[{"2", "n"}], "+", "1"}]], 
       RowBox[{
        RowBox[{"2", "n"}], "+", "1"}]]}]}], " ", "=", " ", 
    RowBox[{"z", " ", "-", " ", 
     FractionBox[
      SuperscriptBox["z", "3"], "3"], " ", "+", 
     FractionBox[
      SuperscriptBox["z", "5"], "5"], "+", "\[Ellipsis]"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7207349c-096e-4963-a20f-bc9ddd2566e5"],
 "\n4) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["\[Pi]", "4"], "+", 
    FractionBox[
     RowBox[{"z", "-", "1"}], "2"], "-", 
    RowBox[{
     FractionBox["1", "4"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"z", "-", "1"}], ")"}], "2"]}], "+", 
    RowBox[{
     FractionBox["1", "12"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"z", "-", "1"}], ")"}], "3"]}], "+", "\[Ellipsis]"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "139b3acf-1d6b-435b-bbb2-6983cf103949"]
}], "Text",
 CellChangeTimes->{{3.9792054788721933`*^9, 3.9792055793357315`*^9}, {
  3.9792056118944016`*^9, 3.9792056566387663`*^9}, {3.979205756766982*^9, 
  3.9792057611052723`*^9}, {3.97920579689699*^9, 3.9792058330967455`*^9}, {
  3.979206014992742*^9, 
  3.979206016945656*^9}},ExpressionUUID->"bdc7eeb2-3553-4e22-a6b6-\
ae5b62a40f45"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"ArcTan", "[", "z", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"z", ",", "0", ",", "5"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"ArcTan", "[", "z", "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"z", ",", "1", ",", "4"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.979205666400755*^9, 3.97920567284914*^9}, {
  3.979205705305277*^9, 3.9792057348073163`*^9}, {3.9792057659668226`*^9, 
  3.9792058099607544`*^9}},
 CellLabel->"In[60]:=",ExpressionUUID->"0f61c8f3-4f7f-4de9-9a4b-7634b56213ee"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"z", "-", 
   FractionBox[
    SuperscriptBox["z", "3"], "3"], "+", 
   FractionBox[
    SuperscriptBox["z", "5"], "5"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "z", "]"}], "6"],
    SeriesData[$CellContext`z, 0, {}, 1, 6, 1],
    Editable->False]}],
  SeriesData[$CellContext`z, 0, {1, 0, 
    Rational[-1, 3], 0, 
    Rational[1, 5]}, 1, 6, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.9792057088873186`*^9, 3.979205735625723*^9}, {
  3.979205766677854*^9, 3.979205810315507*^9}},
 CellLabel->"Out[60]=",ExpressionUUID->"5399a525-d14e-444a-82d1-83f652c747c8"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox["\[Pi]", "4"], "+", 
   FractionBox[
    RowBox[{"z", "-", "1"}], "2"], "-", 
   RowBox[{
    FractionBox["1", "4"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"z", "-", "1"}], ")"}], "2"]}], "+", 
   RowBox[{
    FractionBox["1", "12"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"z", "-", "1"}], ")"}], "3"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", 
      RowBox[{"z", "-", "1"}], "]"}], "5"],
    SeriesData[$CellContext`z, 1, {}, 0, 5, 1],
    Editable->False]}],
  SeriesData[$CellContext`z, 1, {Rational[1, 4] Pi, 
    Rational[1, 2], 
    Rational[-1, 4], 
    Rational[1, 12]}, 0, 5, 1],
  Editable->False]], "Output",
 CellChangeTimes->{{3.9792057088873186`*^9, 3.979205735625723*^9}, {
  3.979205766677854*^9, 3.9792058103194976`*^9}},
 CellLabel->"Out[61]=",ExpressionUUID->"07729d9a-d4d2-44fc-b410-377857c274d2"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{"f1", "[", "z_", "]"}], ":=", 
  RowBox[{"ArcTan", "[", "z", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f2", "[", "z_", "]"}], ":=", 
  RowBox[{
   FractionBox["\[ImaginaryI]", 
    RowBox[{"2", " "}]], 
   RowBox[{"Log", "[", 
    FractionBox[
     RowBox[{"\[ImaginaryI]", "+", "z"}], 
     RowBox[{"\[ImaginaryI]", "-", "z"}]], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f3", "[", "z_", "]"}], ":=", 
   RowBox[{
    SubsuperscriptBox["\[Sum]", 
     RowBox[{"n", "=", "0"}], "5"], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "n"], 
     FractionBox[
      SuperscriptBox["z", 
       RowBox[{
        RowBox[{"2", "n"}], "+", "1"}]], 
      RowBox[{
       RowBox[{"2", "n"}], "+", "1"}]]}]}]}], "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f4", "[", "z_", "]"}], ":=", 
  RowBox[{
   FractionBox["\[Pi]", "4"], "+", 
   FractionBox[
    RowBox[{"z", "-", "1"}], "2"], "-", 
   RowBox[{
    FractionBox["1", "4"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"z", "-", "1"}], ")"}], "2"]}], "+", 
   RowBox[{
    FractionBox["1", "12"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"z", "-", "1"}], ")"}], "3"]}]}]}]}], "Input",
 CellChangeTimes->{{3.9792058658444138`*^9, 3.979205930632653*^9}, {
  3.9792059995166907`*^9, 3.9792060019514074`*^9}},
