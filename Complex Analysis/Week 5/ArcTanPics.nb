Cell[BoxData[
 InterpretationBox[
  RowBox[{"z", "-", 
   FractionBox[
    SuperscriptBox["z", "3"], "3"], "+", 
   FractionBox[
    SuperscriptBox["z", "5"], "5"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "z", "]"}], "6"],
    SeriesData[$CellContext`z, 0, {}, 1, 6, 1],
    Editable->False]}],
  SeriesData[$CellContext`z, 0, {1, 0, 
    Rational[-1, 3], 0, 
