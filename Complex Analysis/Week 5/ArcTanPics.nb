      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "n"], 
     FractionBox[
      SuperscriptBox["z", 
       RowBox[{
        RowBox[{"2", "n"}], "+", "1"}]], 
      RowBox[{
       RowBox[{"2", "n"}], "+", "1"}]]}]}]}], "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f4", "[", "z_", "]"}], ":=", 
  RowBox[{
   FractionBox["\[Pi]", "4"], "+", 
