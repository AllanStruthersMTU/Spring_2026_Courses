Cell[BoxData[{
 RowBox[{
  RowBox[{"f1", "[", "z_", "]"}], ":=", 
  RowBox[{"ArcTan", "[", "z", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f2", "[", "z_", "]"}], ":=", 
  RowBox[{
   FractionBox["\[ImaginaryI]", 
    RowBox[{"2", " "}]], 
   RowBox[{"Log", "[", 
    FractionBox[
     RowBox[{"\[ImaginaryI]", "+", "z"}], 
     RowBox[{"\[ImaginaryI]", "-", "z"}]], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f3", "[", "z_", "]"}], ":=", 
   RowBox[{
    SubsuperscriptBox["\[Sum]", 
     RowBox[{"n", "=", "0"}], "5"], 
    RowBox[{
