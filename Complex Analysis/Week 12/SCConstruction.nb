Notebook[{

Cell[CellGroupData[{
Cell["\<\
THE SC construction for the unit triangle 0, 1, \[ImaginaryI] from the \
pre-vertices 0, 1, and -1\
\>", "Title",
 CellChangeTimes->{{3.977221536103969*^9, 3.9772215393612146`*^9}, {
  3.983794043000835*^9, 
  3.983794083982617*^9}},ExpressionUUID->"e92b3264-461f-412b-be27-\
7a2944d06a78"],

Cell[TextData[{
 "I need to find an f that matches. \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "z", ")"}]}], "=", 
    RowBox[{"C", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"z", "+", "1"}], ")"}], 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}]], 
     SuperscriptBox[
      RowBox[{
       SuperscriptBox["z", 
        RowBox[{
         RowBox[{"-", "3"}], "/", "4"}]], "(", 
       RowBox[{"z", "-", "1"}], ")"}], 
      RowBox[{
       RowBox[{"-", "3"}], "/", "4"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b4476bf7-65e1-4052-8e4a-10097ddca046"],
 ".\nWe need f to be analytic in the upper half plane.  A symbolic \
integration does not necessarily respect these branch cuts.  It is also #$#@ \
slow. "
}], "Text",
 CellChangeTimes->{{3.9837940881662207`*^9, 3.983794109437974*^9}, {
   3.983794144470055*^9, 3.9837941788545265`*^9}, {3.9837942775267763`*^9, 
   3.983794327582103*^9}, {3.983794797670309*^9, 3.9837948588304024`*^9}, {
   3.9837949359888496`*^9, 3.983794947844551*^9}, {3.983869243270206*^9, 
   3.983869256103011*^9}, 
   3.983872118116434*^9},ExpressionUUID->"e707a821-8924-4dd4-9c15-\
31ab319a10c0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fPrime", "[", "z_", "]"}], ":=", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"z", "+", "1"}], ")"}], 
    RowBox[{
     RowBox[{"-", "1"}], "/", "2"}]], 
   SuperscriptBox[
    RowBox[{
     SuperscriptBox["z", 
      RowBox[{
       RowBox[{"-", "3"}], "/", "4"}]], "(", 
     RowBox[{"z", "-", "1"}], ")"}], 
    RowBox[{
     RowBox[{"-", "3"}], "/", "4"}]]}]}], "\[IndentingNewLine]", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"fPrime", "[", "z", "]"}], ",", "z"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f1", "[", "z_", "]"}], ":=", 
  FractionBox[
   RowBox[{"16", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", "z"}], ")"}], 
     RowBox[{"3", "/", "4"}]], " ", "z", " ", 
    RowBox[{"AppellF1", "[", 
     RowBox[{
      FractionBox["25", "16"], ",", 
      FractionBox["3", "4"], ",", 
      FractionBox["1", "2"], ",", 
      FractionBox["41", "16"], ",", "z", ",", 
      RowBox[{"-", "z"}]}], "]"}]}], 
   RowBox[{"25", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "1"}], "+", "z"}], 
       SuperscriptBox["z", 
        RowBox[{"3", "/", "4"}]]], ")"}], 
     RowBox[{"3", "/", "4"}]]}]]}]}], "Input",
 CellChangeTimes->{{3.983794207635127*^9, 3.983794256413197*^9}, {
  3.983794338749955*^9, 3.983794494980568*^9}, {3.983794863129434*^9, 
  3.9837948787774315`*^9}, {3.9837950260025043`*^9, 3.983795044321414*^9}, {
  3.983795101486084*^9, 3.9837951052450733`*^9}, {3.983795642686659*^9, 
  3.9837957439127216`*^9}, {3.9837957989706364`*^9, 3.983795873616234*^9}, {
  3.983795938485149*^9, 3.983796036369116*^9}, {3.983869148405488*^9, 
  3.983869155938982*^9}, {3.9838698173992925`*^9, 3.9838698628208246`*^9}},
 CellLabel->
  "In[178]:=",ExpressionUUID->"d02b7a06-470a-4fd7-b45f-b2e31f43f696"],

Cell[BoxData[
 FractionBox[
  RowBox[{"16", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", "z"}], ")"}], 
    RowBox[{"3", "/", "4"}]], " ", "z", " ", 
   RowBox[{"AppellF1", "[", 
    RowBox[{
     FractionBox["25", "16"], ",", 
     FractionBox["3", "4"], ",", 
     FractionBox["1", "2"], ",", 
     FractionBox["41", "16"], ",", "z", ",", 
     RowBox[{"-", "z"}]}], "]"}]}], 
  RowBox[{"25", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{
       RowBox[{"-", "1"}], "+", "z"}], 
      SuperscriptBox["z", 
       RowBox[{"3", "/", "4"}]]], ")"}], 
    RowBox[{"3", "/", "4"}]]}]]], "Output",
 CellChangeTimes->{3.983872158757275*^9},
 CellLabel->
  "Out[179]=",ExpressionUUID->"2ea1bee9-89f0-4ecc-80ff-e7c5b88efe00"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"z0", "=", 
   RowBox[{"0.01", " ", "+", 
    RowBox[{"0.9", "\[ImaginaryI]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{"f1", "[", "z0", "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  SuperscriptBox["10", "3"], "*", 
  RowBox[{"AbsoluteTiming", "[", 
   RowBox[{"fPrime", "[", "z0", "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  SuperscriptBox["10", "3"], "*", 
  RowBox[{"AbsoluteTiming", "[", 
   RowBox[{"Cos", "[", "z0", "]"}], "]"}]}], "\[IndentingNewLine]", 
