Cell[TextData[{
 "So we have fixed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "->", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "229ae6c5-3905-4401-9d64-d10a38e24c0a"],
 ".  We still need to choose the scaling and rotation ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7fecba22-8ee2-4f70-9d68-87fb5a92cfff"],
 "  so that \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "z", ")"}], "=", 
    RowBox[{"C", " ", 
     RowBox[{"f1", "(", "z", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "522785c7-01dd-4823-aa29-fa91b187f1b7"],
 " \nsatisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "1", ")"}], "=", 
    RowBox[{
     RowBox[{"C", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2.3223872236868894`"}], "-", 
        RowBox[{"2.3223872236872976`", " ", "\[ImaginaryI]"}]}], ")"}]}], "=",
      "\[ImaginaryI]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "359a322c-7747-42c0-bb2a-9349c9a48723"],
 ".  We need \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "=", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2.3223872236868894`"}], "-", 
        RowBox[{"2.3223872236872976`", " ", "\[ImaginaryI]"}]}], ")"}]}], "=", 
     RowBox[{
      RowBox[{"-", "0.21529570732232522`"}], "-", 
      RowBox[{"0.2152957073222874`", " ", "\[ImaginaryI]"}]}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bedd459e-2b59-4f95-be4a-31b6e65c733e"]
}], "Text",
