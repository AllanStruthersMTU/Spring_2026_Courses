 RowBox[{
  RowBox[{"\[Epsilon]", "=", 
   SuperscriptBox["10.0", 
    RowBox[{"-", "50"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f1", "[", 
    RowBox[{"0", " ", "+", " ", 
     RowBox[{"\[Epsilon]", " ", "\[ImaginaryI]"}]}], "]"}], ",", 
