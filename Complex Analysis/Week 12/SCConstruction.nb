Cell[TextData[{
 "I am choosing a small ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", ">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c5d050d6-e77e-4920-883e-1112919a4407"],
 " to make sure we stay in the upper half plane!  These are the corners of \
our output triangle!  "
}], "Text",
 CellChangeTimes->{{3.9841319673237605`*^9, 3.984132050738139*^9}, {
  3.984132138121862*^9, 3.9841321457076473`*^9}, {3.9841321781908813`*^9, 
