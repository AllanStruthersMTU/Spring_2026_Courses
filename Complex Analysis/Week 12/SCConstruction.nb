 CellChangeTimes->{3.9838727916044807`*^9},
 CellLabel->
  "Out[191]=",ExpressionUUID->"29c3189e-fa6f-4efa-b6eb-c6a0a0f6f982"],

Cell[TextData[{
 "We can avoid the @#@# function by just integrating the derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "'"}], " "}], TraditionalForm]],ExpressionUUID->
  "169e46da-92bb-40e6-9336-fc344e7aeae6"],
 "directly.  Since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"F", "(", "z", ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", "z"], 
     RowBox[{
      RowBox[{"f", "'"}], 
      RowBox[{"(", "\[Zeta]", ")"}], "d\[Zeta]"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6767da8e-7808-4826-a67a-5532c4806e27"],
 " is independent of path in the upper half plane if we have a regularly \
spaced grid of value of the derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ebc5f8b1-5076-4ca6-befe-66bfe589ed13"],
 " then we can use horizontal aka real trapezoid steps\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{"x", "+", "\[CapitalDelta]x", " ", "+", " ", 
      RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}], "\[TildeTilde]", 
    RowBox[{
     RowBox[{"f", "(", 
      RowBox[{"x", "+", 
       RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"f", "'"}], 
         RowBox[{"(", 
          RowBox[{"x", "+", 
           RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"f", "'"}], 
         RowBox[{"(", 
          RowBox[{"x", "+", " ", "\[CapitalDelta]x", " ", "+", " ", 
           RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}]}], "2"], 
      "\[CapitalDelta]x"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "73cb4355-c364-4d84-833d-fd283e94107b"],
 "\nand vertical aka imaginary trapezoid steps\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{"x", " ", "+", " ", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"(", 
        RowBox[{"y", "+", "\[CapitalDelta]y"}], ")"}]}]}], ")"}], 
    "\[TildeTilde]", 
    RowBox[{
     RowBox[{"f", "(", 
      RowBox[{"x", "+", 
       RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"f", "'"}], 
         RowBox[{"(", 
          RowBox[{"x", "+", 
           RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"f", "'"}], 
         RowBox[{"(", 
          RowBox[{"x", "+", " ", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{"(", 
             RowBox[{"y", "+", "\[CapitalDelta]y"}], ")"}]}]}], ")"}]}]}], 
       "2"], "\[ImaginaryI]", " ", "\[CapitalDelta]y"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "182b1410-9a9a-489d-81af-aa9f55f112bb"],
 "\nto step to any grid point starting from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "0", ")"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "21e39569-dd75-40b6-bb1c-65c32e6c19fe"],
 ".  The branch cuts along the real axis suggest we first step up vertically \
from the origin to build a table of values along the positive imaginary axis. \
We can then step of the imaginary axis (in the positive and negative \
directions) to fill in the values of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9e855d85-7c48-45f2-b6f2-66a59e82c006"],
 " on horizontal lines.   For the numerically inclined it is indeed true that \
it would be better to think about this in the centered form \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{"x", "+", 
      RowBox[{"\[CapitalDelta]x", "/", "2"}], " ", "+", " ", 
      RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}], "\[TildeTilde]", 
    RowBox[{
     RowBox[{"f", "(", 
      RowBox[{"x", "+", 
       RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"f", "'"}], 
         RowBox[{"(", 
          RowBox[{"x", "+", 
           RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"f", "'"}], 
         RowBox[{"(", 
          RowBox[{"x", "+", " ", "\[CapitalDelta]x", " ", "+", " ", 
           RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}]}], "2"], 
      "\[CapitalDelta]x"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "052c4b7b-7531-4e94-a433-9de8e10a5e28"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{"x", " ", "+", " ", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"(", 
        RowBox[{"y", "+", 
         RowBox[{"\[CapitalDelta]y", "/", "2"}]}], ")"}]}]}], ")"}], 
    "\[TildeTilde]", 
    RowBox[{
     RowBox[{"f", "(", 
      RowBox[{"x", "+", 
       RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"f", "'"}], 
         RowBox[{"(", 
          RowBox[{"x", "+", 
           RowBox[{"\[ImaginaryI]", " ", "y"}]}], ")"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"f", "'"}], 
         RowBox[{"(", 
          RowBox[{"x", "+", " ", 
           RowBox[{"\[ImaginaryI]", " ", 
            RowBox[{"(", 
             RowBox[{"y", "+", "\[CapitalDelta]y"}], ")"}]}]}], ")"}]}]}], 
       "2"], "\[ImaginaryI]", " ", "\[CapitalDelta]y"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c30155ed-8c96-4299-90da-e65d075f3d10"],
 "."
}], "Text",
 CellChangeTimes->{{3.9838697692503767`*^9, 3.9838698024947214`*^9}, {
  3.9839690960426254`*^9, 3.983969135808202*^9}, {3.9839727310057187`*^9, 
  3.9839727441014347`*^9}, {3.9840330859821544`*^9, 3.9840338338051786`*^9}, {
  3.984034983291534*^9, 
  3.9840350948753004`*^9}},ExpressionUUID->"a3eb2793-c325-4b28-aae8-\
bc7ead7bb255"],

Cell["\<\
I want this to look good at the end!  In this context this means that: \
\>", "Text",
 CellChangeTimes->{{3.984033895518282*^9, 3.984034014326699*^9}, {
  3.98403412907788*^9, 3.9840344476883335`*^9}, {3.9840345433068967`*^9, 
  3.9840345436083193`*^9}, {3.984035101665526*^9, 
  3.984035178378888*^9}},ExpressionUUID->"0a1a198f-3296-4fc0-87cd-\
8bff521f9c89"],

Cell["\<\
I need lots of values near the real axis y = 0 which is the boundary of the \
triangle!\
\>", "Item",
 CellChangeTimes->{{3.984033895518282*^9, 3.984034014326699*^9}, {
  3.98403412907788*^9, 3.9840344476883335`*^9}, {3.9840345433068967`*^9, 
  3.9840345436083193`*^9}, {3.984035101665526*^9, 
  3.984035220819945*^9}},ExpressionUUID->"d5a1a26f-b5e6-4bf1-b284-\
d67302551499"],

Cell[TextData[{
 "I need lots of values near the singularities aka pre-vertices ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"-", "1"}]}], ",", "0", ",", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "50793078-6009-491d-a17d-7ae9d33dfa46"],
 " which are the corners of the triangle. "
}], "Item",
 CellChangeTimes->{{3.984033895518282*^9, 3.984034014326699*^9}, {
  3.98403412907788*^9, 3.9840344476883335`*^9}, {3.9840345433068967`*^9, 
  3.9840345436083193`*^9}, {3.984035101665526*^9, 
  3.9840352426790495`*^9}},ExpressionUUID->"10583fed-6b93-4eed-815b-\
23e22f68271a"],

Cell["\<\
I need to get well out the real axis to fill in the last edge of the triangle.\
\>", "Item",
 CellChangeTimes->{{3.984033895518282*^9, 3.984034014326699*^9}, {
  3.98403412907788*^9, 3.9840344476883335`*^9}, {3.9840345433068967`*^9, 
  3.9840345436083193`*^9}, {3.984035101665526*^9, 
  3.9840352609730387`*^9}},ExpressionUUID->"9e62ff67-037f-4400-bffd-\
33f05a5fe150"],

Cell["\<\
 I need to get well out the positive imaginary axis to fill in the middle of \
the triangle.  \
\>", "Item",
 CellChangeTimes->{{3.984033895518282*^9, 3.984034014326699*^9}, {
  3.98403412907788*^9, 3.9840344476883335`*^9}, {3.9840345433068967`*^9, 
  3.9840345436083193`*^9}, {3.984035101665526*^9, 
  3.9840352678072004`*^9}},ExpressionUUID->"3b178209-3af5-442f-9153-\
2548d079182a"],

Cell["\<\
To do this with a reasonable number of points we need a grid with different \
sized gaps.  \
\>", "Text",
 CellChangeTimes->{{3.984033895518282*^9, 3.984034014326699*^9}, {
  3.98403412907788*^9, 3.9840344476883335`*^9}, {3.9840345433068967`*^9, 
  3.9840345436083193`*^9}, {3.984035101665526*^9, 
  3.9840352605023375`*^9}},ExpressionUUID->"6faa4cd5-5948-4355-9f2c-\
f7f4d4f0cb05"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Epsilon]", "=", 
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{"fPrime", "[", 
       RowBox[{"x", " ", "+", " ", 
        RowBox[{"\[Epsilon]", " ", "\[ImaginaryI]"}]}], "]"}], "]"}], ",", 
     RowBox[{"Im", "[", 
