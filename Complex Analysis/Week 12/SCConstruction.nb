Cell[TextData[{
 "Do not attempt to plot  AppellF1 unless you have a several spare minutes! \
Search \[OpenCurlyDoubleQuote]Why is AppellF1 slow?\[CloseCurlyDoubleQuote] \
in Google for an explanation.  The plot below shows the derivative function \
is automatically nice in the upper half plane and has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["lim", 
      RowBox[{"z", "->", "0"}]], 
     RowBox[{"f", "(", "z", ")"}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"73a2b179-b75e-4091-9289-6ac47db651c7"],
 "."
}], "Text",
 CellChangeTimes->{{3.983869210887783*^9, 3.9838692321810417`*^9}, {
  3.983869369563249*^9, 3.983869399049502*^9}, {3.9838694587697268`*^9, 
