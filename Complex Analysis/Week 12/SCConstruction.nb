    RowBox[{"1", "+", 
     RowBox[{"\[Epsilon]", " ", "\[ImaginaryI]"}]}], "]"}], ",", 
   RowBox[{"f1", "[", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{"\[Epsilon]", " ", "\[ImaginaryI]"}]}], "]"}]}], "}"}]}], "Input",
