Notebook[{

Cell[CellGroupData[{
Cell["\<\
THE SC construction for the unit triangle 0, 1, \[ImaginaryI] from the \
pre-vertices 0, 1, and -1\
\>", "Title",
 CellChangeTimes->{{3.977221536103969*^9, 3.9772215393612146`*^9}, {
  3.983794043000835*^9, 
  3.983794083982617*^9}},ExpressionUUID->"e92b3264-461f-412b-be27-\
7a2944d06a78"],

Cell[TextData[{
 "I need to find an f that matches. \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "z", ")"}]}], "=", 
    RowBox[{"C", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"z", "+", "1"}], ")"}], 
      RowBox[{
       RowBox[{"-", "1"}], "/", "2"}]], 
     SuperscriptBox[
      RowBox[{
       SuperscriptBox["z", 
        RowBox[{
         RowBox[{"-", "3"}], "/", "4"}]], "(", 
       RowBox[{"z", "-", "1"}], ")"}], 
      RowBox[{
       RowBox[{"-", "3"}], "/", "4"}]]}]}], TraditionalForm]],ExpressionUUID->
  "b4476bf7-65e1-4052-8e4a-10097ddca046"],
 ".\nWe need f to be analytic in the upper half plane.  A symbolic \
integration does not necessarily respect these branch cuts.  It is also #$#@ \
slow. "
}], "Text",
 CellChangeTimes->{{3.9837940881662207`*^9, 3.983794109437974*^9}, {
   3.983794144470055*^9, 3.9837941788545265`*^9}, {3.9837942775267763`*^9, 
   3.983794327582103*^9}, {3.983794797670309*^9, 3.9837948588304024`*^9}, {
   3.9837949359888496`*^9, 3.983794947844551*^9}, {3.983869243270206*^9, 
   3.983869256103011*^9}, 
   3.983872118116434*^9},ExpressionUUID->"e707a821-8924-4dd4-9c15-\
31ab319a10c0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fPrime", "[", "0.0", "]"}], "=", "0.0"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fPrime", "[", "z_", "]"}], ":=", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"z", "+", "1"}], ")"}], 
    RowBox[{
     RowBox[{"-", "1"}], "/", "2"}]], 
   SuperscriptBox[
    RowBox[{
     SuperscriptBox["z", 
      RowBox[{
       RowBox[{"-", "3"}], "/", "4"}]], "(", 
     RowBox[{"z", "-", "1"}], ")"}], 
    RowBox[{
     RowBox[{"-", "3"}], "/", "4"}]]}]}], "\[IndentingNewLine]", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"fPrime", "[", "z", "]"}], ",", "z"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f1", "[", "z_", "]"}], ":=", 
  FractionBox[
   RowBox[{"16", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", "z"}], ")"}], 
     RowBox[{"3", "/", "4"}]], " ", "z", " ", 
    RowBox[{"AppellF1", "[", 
     RowBox[{
      FractionBox["25", "16"], ",", 
      FractionBox["3", "4"], ",", 
      FractionBox["1", "2"], ",", 
      FractionBox["41", "16"], ",", "z", ",", 
      RowBox[{"-", "z"}]}], "]"}]}], 
   RowBox[{"25", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "1"}], "+", "z"}], 
       SuperscriptBox["z", 
        RowBox[{"3", "/", "4"}]]], ")"}], 
     RowBox[{"3", "/", "4"}]]}]]}]}], "Input",
 CellChangeTimes->{{3.983794207635127*^9, 3.983794256413197*^9}, {
  3.983794338749955*^9, 3.983794494980568*^9}, {3.983794863129434*^9, 
  3.9837948787774315`*^9}, {3.9837950260025043`*^9, 3.983795044321414*^9}, {
  3.983795101486084*^9, 3.9837951052450733`*^9}, {3.983795642686659*^9, 
  3.9837957439127216`*^9}, {3.9837957989706364`*^9, 3.983795873616234*^9}, {
  3.983795938485149*^9, 3.983796036369116*^9}, {3.983869148405488*^9, 
  3.983869155938982*^9}, {3.9838698173992925`*^9, 3.9838698628208246`*^9}, {
  3.983971233049054*^9, 3.9839712454192147`*^9}, {3.983974496600528*^9, 
  3.983974522699974*^9}, {3.983974589324105*^9, 3.983974628049445*^9}, {
  3.983974829837261*^9, 3.9839748374934826`*^9}, {3.983974888183012*^9, 
  3.9839748940531635`*^9}, {3.984031401986967*^9, 3.9840314062971325`*^9}, {
  3.9840318348768563`*^9, 3.9840319312372303`*^9}, {3.984032999419019*^9, 
  3.984032999710196*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"d02b7a06-470a-4fd7-b45f-b2e31f43f696"],

Cell[BoxData[
 FractionBox[
  RowBox[{"16", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", "z"}], ")"}], 
    RowBox[{"3", "/", "4"}]], " ", "z", " ", 
   RowBox[{"AppellF1", "[", 
    RowBox[{
     FractionBox["25", "16"], ",", 
     FractionBox["3", "4"], ",", 
     FractionBox["1", "2"], ",", 
     FractionBox["41", "16"], ",", "z", ",", 
     RowBox[{"-", "z"}]}], "]"}]}], 
  RowBox[{"25", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{
       RowBox[{"-", "1"}], "+", "z"}], 
      SuperscriptBox["z", 
       RowBox[{"3", "/", "4"}]]], ")"}], 
    RowBox[{"3", "/", "4"}]]}]]], "Output",
 CellChangeTimes->{
  3.983872158757275*^9, 3.9839686266181593`*^9, 3.9839687176183715`*^9, 
   3.983974535099164*^9, {3.983974592456958*^9, 3.9839746331258373`*^9}, 
   3.9839749107059183`*^9, 3.984031463464523*^9, 3.984031650090418*^9, 
   3.984031885248763*^9, 3.984031922740033*^9, 3.984033001840842*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"1f63abce-985c-4723-aa84-2e8739d680fa"]
}, Open  ]],

Cell["\<\
Note (as shown below) the \[OpenCurlyDoubleQuote]very-special\
\[CloseCurlyDoubleQuote] function AppellF1
\thttps://en.wikipedia.org/wiki/Appell_series
is a thousand times slower than the functions you are used to.  There may (or \
may not) be a good reason for this! See the discussions concerning Python at \
https://github.com/mpmath/mpmath/issues/633 and Mathematica at \
https://mathematica.stackexchange.com/questions/298554/abnormally-long-\
computation-time-using-appellf1-function.  \
\>", "Text",
 CellChangeTimes->{{3.983968776224864*^9, 3.983968878247855*^9}, {
  3.9839689286733766`*^9, 3.9839689909210777`*^9}, {3.9839690302772665`*^9, 
  3.9839690857783566`*^9}, {3.9839710799418125`*^9, 
  3.9839710828867464`*^9}},ExpressionUUID->"564bc2d0-b667-4be0-ae43-\
65ad7c52f574"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"z0", "=", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "-", "I"}], ",", 
      RowBox[{"1", "+", "I"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{"f1", "[", "z0", "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  SuperscriptBox["10", "3"], "*", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"AbsoluteTiming", "[", 
     RowBox[{
      RowBox[{"fPrime", "[", "z0", "]"}], ";"}], "]"}], ",", 
    RowBox[{"AbsoluteTiming", "[", 
     RowBox[{
      RowBox[{"Cos", "[", "z0", "]"}], ";"}], "]"}], ",", 
    RowBox[{"AbsoluteTiming", "[", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"Log", "[", 
        RowBox[{"Sin", "[", "z0", "]"}], "]"}], "]"}], ";"}], "]"}]}], 
   "}"}]}]}], "Input",
 CellChangeTimes->{{3.983794207635127*^9, 3.983794256413197*^9}, {
