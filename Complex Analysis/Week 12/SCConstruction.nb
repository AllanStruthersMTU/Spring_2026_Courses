Notebook[{

Cell[CellGroupData[{
Cell["\<\
THE SC construction for the unit triangle 0, 1, \[ImaginaryI] from the \
pre-vertices -1, 0, and 1\
\>", "Title",
 CellChangeTimes->{{3.977221536103969*^9, 3.9772215393612146`*^9}, {
  3.983794043000835*^9, 3.983794083982617*^9}, {3.984129904724113*^9, 
  3.984129915291833*^9}},ExpressionUUID->"e92b3264-461f-412b-be27-\
7a2944d06a78"],

Cell[TextData[{
 "I need to find an f that matches. \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "z", ")"}]}], "=", 
    RowBox[{"C", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"z", "+", "1"}], ")"}], 
      RowBox[{
       RowBox[{"-", "3"}], "/", "4"}]], 
     SuperscriptBox[
      RowBox[{
       SuperscriptBox["z", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]], "(", 
       RowBox[{"z", "-", "1"}], ")"}], 
      RowBox[{
       RowBox[{"-", "3"}], "/", "4"}]]}]}], TraditionalForm]],ExpressionUUID->
  "b4476bf7-65e1-4052-8e4a-10097ddca046"],
 ".\nWe need f to be analytic in the upper half plane.  A symbolic \
integration does not necessarily respect these branch cuts. I changed the \
pre-vertex labels to get a representation avoiding the #$#@ Appel function.  \
No reason for you to know this but the Hypergeometric function is much less \
esoteric!  The branch cuts match and the "
}], "Text",
 CellChangeTimes->{{3.9837940881662207`*^9, 3.983794109437974*^9}, {
   3.983794144470055*^9, 3.9837941788545265`*^9}, {3.9837942775267763`*^9, 
   3.983794327582103*^9}, {3.983794797670309*^9, 3.9837948588304024`*^9}, {
   3.9837949359888496`*^9, 3.983794947844551*^9}, {3.983869243270206*^9, 
   3.983869256103011*^9}, 3.983872118116434*^9, {3.984129838527796*^9, 
   3.9841298496567545`*^9}, {3.98412993313262*^9, 3.9841300270977745`*^9}, {
   3.984130303981514*^9, 3.9841303196605234`*^9}, {3.984131341431718*^9, 
   3.984131341431718*^9}},ExpressionUUID->"e707a821-8924-4dd4-9c15-\
31ab319a10c0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fPrime", "[", "0.0", "]"}], "=", "0.0"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fPrime", "[", "z_", "]"}], ":=", 
  RowBox[{
   SuperscriptBox["z", 
    RowBox[{
     RowBox[{"-", "1"}], "/", "2"}]], "/", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"z", "+", "1"}], ")"}], 
      RowBox[{"3", "/", "4"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"z", "-", "1"}], ")"}], 
      RowBox[{"3", "/", "4"}]]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"fPrime", "[", "z", "]"}], ",", "z"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f1", "[", "z_", "]"}], ":=", 
  FractionBox[
   RowBox[{"8", " ", "z", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["z", "2"]}], ")"}], 
     RowBox[{"3", "/", "4"}]], " ", 
    RowBox[{"Hypergeometric2F1", "[", 
     RowBox[{
      FractionBox["5", "16"], ",", 
      FractionBox["3", "4"], ",", 
      FractionBox["21", "16"], ",", 
      SuperscriptBox["z", "2"]}], "]"}]}], 
   RowBox[{"5", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "z"}], ")"}], " ", 
       SqrtBox["z"]}], ")"}], 
     RowBox[{"3", "/", "4"}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "z"}], ")"}], 
     RowBox[{"3", "/", "4"}]]}]]}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<f'\>\"", "->", 
     RowBox[{"ComplexPlot3D", "[", 
      RowBox[{
       RowBox[{"fPrime", "[", "z", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "2"}], "}"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<f1\>\"", "->", 
     RowBox[{"ComplexPlot3D", "[", 
      RowBox[{
       RowBox[{"f", "[", "z", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "2"}], "}"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<check\>\"", "->", 
     RowBox[{"Plot3D", "[", " ", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"f1", "'"}], "[", 
          RowBox[{"x", "+", " ", 
           RowBox[{"I", " ", "y"}]}], "]"}], "-", 
         RowBox[{"fPrime", "[", 
          RowBox[{"x", " ", "+", " ", 
           RowBox[{"I", " ", "y"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "4"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "}"}], "]"}]}], "Input",
 CellChangeTimes->{{3.983794207635127*^9, 3.983794256413197*^9}, {
