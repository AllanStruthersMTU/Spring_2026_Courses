Cell[CellGroupData[{

Cell["Complex Conjugates", "Section",
 CellChangeTimes->{{3.9786015433058014`*^9, 
  3.978601546835079*^9}},ExpressionUUID->"555095ad-0aa5-4e7d-9e85-\
111341e019d1"],

Cell[CellGroupData[{

Cell["Example 1", "Subsection",
 CellChangeTimes->{{3.9786019747551174`*^9, 
  3.9786019765161047`*^9}},ExpressionUUID->"e1d0b555-d286-40ad-a555-\
0d2ef5ec5a82"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "z_", "]"}], ":=", " ", 
  RowBox[{
   SuperscriptBox["z", "3"], "+", " ", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"z", "+", 
      RowBox[{"3", " ", "I"}], "+", "1"}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ComplexExpand", "[", 
   RowBox[{"f", "[", 
    RowBox[{"x", "+", " ", 
     RowBox[{"\[ImaginaryI]", " ", "y"}]}], "]"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   SuperscriptBox["x", "3"], "-", 
   RowBox[{"3", " ", "x", " ", 
    SuperscriptBox["y", "2"]}], "+", 
   FractionBox["1", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", "x"}], ")"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"3", "+", "y"}], ")"}], "2"]}]], "+", 
   FractionBox["x", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", "x"}], ")"}], "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"3", "+", "y"}], ")"}], "2"]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"3", " ", 
     SuperscriptBox["x", "2"], " ", "y"}], "-", 
    SuperscriptBox["y", "3"], "-", 
    FractionBox["3", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "x"}], ")"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"3", "+", "y"}], ")"}], "2"]}]], "-", 
    FractionBox["y", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "x"}], ")"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"3", "+", "y"}], ")"}], "2"]}]]}], 
   ")"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uPic", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ContourStyle", "->", "Blue"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Contours", "->", "20"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ContourShading", "->", "None"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vPic", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"v", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ContourStyle", "->", "Red"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Contours", "->", "20"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ContourShading", "->", "None"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<u\>\"", "->", "uPic"}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<v\>\"", "->", "vPic"}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<u and v\>\"", "->", 
     RowBox[{"Show", "[", 
      RowBox[{"uPic", ",", " ", "vPic"}], "]"}]}]}], "\[IndentingNewLine]", 
   "}"}], "]"}]}], "Input",
 CellChangeTimes->{{3.978601549124308*^9, 3.978601949252496*^9}, {
  3.9786054401782427`*^9, 3.978605460463677*^9}},
