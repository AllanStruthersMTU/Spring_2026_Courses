Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"z1", ",", "z2", ",", "t", ",", "a", ",", "b"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z1", "[", "t_", "]"}], ":=", " ", 
  RowBox[{"1", "+", "\[ImaginaryI]", " ", "+", " ", 
   RowBox[{"t", " ", 
    RowBox[{"(", 
     RowBox[{"2", " ", "+", "\[ImaginaryI]"}], 
     ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z2", "[", "t_", "]"}], ":=", " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
   "\[Pi]", "  ", "\[ImaginaryI]", " ", "t"}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z3", "[", "t_", "]"}], ":=", " ", 
  RowBox[{"2", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[Pi]", "  ", "\[ImaginaryI]", " ", 
     SuperscriptBox["t", "2"]}]]}]}], "\[IndentingNewLine]", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ReIm", "[", 
      RowBox[{"z1", "[", "t", "]"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ReIm", "[", 
      RowBox[{"z2", "[", "t", "]"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ReIm", "[", 
      RowBox[{"z3", "[", "t", "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", " ", "1"}], "}"}]}], "]"}]}], "Input",
