Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Mob", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "}"}], "]"}], "[", "z_",
    "]"}], ":=", " ", 
  FractionBox[
   RowBox[{
    RowBox[{"a", " ", "z"}], " ", "+", " ", "b"}], 
   RowBox[{
    RowBox[{"c", " ", "z"}], " ", "+", "d"}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1.2", "+", 
       RowBox[{"3", "\[ImaginaryI]"}]}], ",", " ", 
      RowBox[{"0.1", " ", "\[ImaginaryI]"}], ",", " ", 
      RowBox[{"5", "-", 
       RowBox[{"3.2", " ", "\[ImaginaryI]"}]}], ",", " ", 
      RowBox[{"1.2", " ", "-", 
       RowBox[{"2", " ", "\[ImaginaryI]"}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<disc = \>\"", ",", 
      RowBox[{
       RowBox[{"a", " ", "d"}], " ", "-", " ", 
       RowBox[{"b", " ", "c"}]}]}], "]"}], ";"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"R", ",", "cent"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"1.2", ",", " ", 
     RowBox[{"0.1", " ", "+", " ", "\[ImaginaryI]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<Par x-y\>\"", "->", 
     RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ReIm", "[", 
        RowBox[{
         RowBox[{"Mob", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], "]"}], "[", 
         RowBox[{"x", "+", 
          RowBox[{"\[ImaginaryI]", " ", "y"}]}], "]"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "12"}], ",", "12"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "12"}], ",", "12"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Mesh", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
       RowBox[{"BoundaryStyle", "\[Rule]", "Red"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<CPlot\>\"", "->", 
     RowBox[{"ComplexPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Mob", "[", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], "]"}], "[", "z",
         "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Mesh", "->", "Automatic"}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<Par Circle\>\"", "->", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ReIm", "[", 
          RowBox[{
           RowBox[{"R", " ", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}], "+", "cent"}], 
          "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"ReIm", "[", 
          RowBox[{
           RowBox[{"Mob", "[", 
            RowBox[{"{", 
             RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], "]"}], "[", 
           RowBox[{
            RowBox[{"R", " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}], "+", "cent"}], 
           "]"}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", " ", 
         RowBox[{"2", "\[Pi]"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "}"}], "]"}]}], "Input",
