     RowBox[{"\[Pi]", "/", "2"}], ",", " ", "\[Pi]"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "z_", "]"}], ":=", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"1", "+", "\[ImaginaryI]"}], ")"}], "z"]}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
