Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "z_", "]"}], ":=", " ", 
    RowBox[{
     SuperscriptBox["z", "2"], "+", " ", "z"}]}], " ", "\[IndentingNewLine]", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"f", "[", 
     RowBox[{"x", "+", " ", 
      RowBox[{"\[ImaginaryI]", " ", "y"}]}], "]"}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"x", "+", 
     SuperscriptBox["x", "2"], "-", 
     SuperscriptBox["y", "2"]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", " ", 
    RowBox[{
     RowBox[{"2", " ", "x", " ", "y"}], " ", "+", "y"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"uPic", "=", 
     RowBox[{"ContourPlot", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ContourStyle", "->", "Blue"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Contours", "->", "20"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ContourShading", "->", "None"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vPic", "=", 
     RowBox[{"ContourPlot", "[", 
      RowBox[{
       RowBox[{"v", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ContourStyle", "->", "Red"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Contours", "->", "20"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ContourShading", "->", "None"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"TabView", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<u\>\"", "->", "uPic"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<v\>\"", "->", "vPic"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<u and v\>\"", "->", 
        RowBox[{"Show", "[", 
         RowBox[{"uPic", ",", " ", "vPic"}], "]"}]}]}], "\[IndentingNewLine]",
       "}"}], ",", "3"}], "]"}]}]}]], "Input",
