Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "z_", "]"}], ":=", 
  RowBox[{
   FractionBox["1", "z"], 
   RowBox[{"(", 
    FractionBox["1", 
     RowBox[{"z", "-", "1"}]], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L1", "[", 
   RowBox[{"z_", ",", "nMax_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"-", 
    FractionBox["1", "z"]}], "-", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     SuperscriptBox["z", "n"], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "nMax"}], "}"}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L2", "[", 
   RowBox[{"z_", ",", "nMax_"}], "]"}], ":=", " ", 
  RowBox[{"Sum", "[", 
   RowBox[{
    SuperscriptBox["z", 
     RowBox[{"-", "n"}]], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "2", ",", "nMax"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Epsilon]", "=", "0.1"}], ";", " ", 
  RowBox[{"nMax", "=", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetOptions", "[", 
   RowBox[{"ComplexPlot", ",", " ", 
    RowBox[{"MaxRecursion", "->", "3"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", "\[IndentingNewLine]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\"\<f\>\"", "->", 
     RowBox[{"ComplexPlot3D", "[", 
      RowBox[{
       RowBox[{"f", "[", "z", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "3"}], "}"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"0", ",", "10"}], "}"}]}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<L1\>\"", "->", 
     RowBox[{"ComplexPlot3D", "[", 
      RowBox[{
       RowBox[{"L1", "[", 
        RowBox[{"z", ",", "nMax"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "3"}], "}"}], ",", 
       RowBox[{"RegionFunction", "\[Rule]", 
        RowBox[{"Function", "[", 
         RowBox[{"z", ",", 
          RowBox[{"\[Epsilon]", "<", 
           RowBox[{"Abs", "[", "z", "]"}], "<", 
           RowBox[{"1", "-", "\[Epsilon]"}]}]}], "]"}]}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<L2\>\"", "->", 
     RowBox[{"ComplexPlot3D", "[", 
      RowBox[{
       RowBox[{"L2", "[", 
        RowBox[{"z", ",", "nMax"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "3"}], "}"}], ",", 
       RowBox[{"RegionFunction", "\[Rule]", 
        RowBox[{"Function", "[", 
         RowBox[{"z", ",", 
          RowBox[{
           RowBox[{"Abs", "[", "z", "]"}], ">", 
           RowBox[{"1", "+", "\[Epsilon]"}]}]}], "]"}]}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<f-L1\>\"", "->", 
     RowBox[{"ComplexPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", "z", "]"}], "-", 
        RowBox[{"L1", "[", 
         RowBox[{"z", ",", "nMax"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "1"}], "}"}], ",", 
       RowBox[{"RegionFunction", "\[Rule]", 
        RowBox[{"Function", "[", 
         RowBox[{"z", ",", 
          RowBox[{"\[Epsilon]", "<", 
           RowBox[{"Abs", "[", "z", "]"}], "<", 
           RowBox[{"1", "-", "\[Epsilon]"}]}]}], "]"}]}]}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"\"\<f-L2\>\"", "->", 
     RowBox[{"ComplexPlot3D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", "z", "]"}], "-", 
        RowBox[{"L2", "[", 
         RowBox[{"z", ",", "nMax"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "3"}], "}"}], ",", 
       RowBox[{"RegionFunction", "\[Rule]", 
        RowBox[{"Function", "[", 
         RowBox[{"z", ",", 
          RowBox[{
           RowBox[{"Abs", "[", "z", "]"}], ">", 
           RowBox[{"1", "+", "\[Epsilon]"}]}]}], "]"}]}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "}"}], "]"}]}], "Input",
