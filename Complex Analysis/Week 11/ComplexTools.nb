Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f2", "[", "z_", "]"}], ":=", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "z"}], ")"}], 
    RowBox[{"1", "/", "2"}]], "/", "\[ImaginaryI]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"R", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<CPlot3D\>\"", "->", 
     RowBox[{"ComplexPlot3D", "[", " ", 
      RowBox[{
       RowBox[{"f2", "[", "z", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", " ", "R"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotLegends", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<re z\>\"", ",", "\"\<im z\>\"", ",", "\"\<abs(f2(z)\>\""}], 
         "}"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<Abs\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{"f2", "[", 
           RowBox[{"x", "+", " ", 
            RowBox[{"I", " ", "y"}]}], "]"}], "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<re z\>\"", ",", "\"\<im z\>\"", ",", "\"\<abs(f2(z)\>\""}], 
         "}"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<Arg\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", " ", 
         RowBox[{"Arg", "[", 
          RowBox[{"f2", "[", 
           RowBox[{"x", "+", " ", 
            RowBox[{"I", " ", "y"}]}], "]"}], "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<re z\>\"", ",", "\"\<im z\>\"", ",", "\"\<arg(f2(z)\>\""}], 
         "}"}]}]}], "]"}]}]}], "\[IndentingNewLine]", "}"}], "]"}]}], "Input",
