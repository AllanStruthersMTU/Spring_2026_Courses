  3.9831871075388265`*^9}},ExpressionUUID->"7468dc14-1f24-4452-ac74-\
0237a1b74498"],

Cell[TextData[{
 "The simplest line in \[DoubleStruckCapitalC] is probably the real axis.  \
The simplest 3 points on the real axis are probably ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "1"}], ",", "0", ",", "1."}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2f003a78-ad19-4d30-82ce-f294fb94ba6a"],
 "   The simplest circle in \[DoubleStruckCapitalC] is probably the unit \
circle.  The simplest 3 points on the unit circle are probably ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "1"}], ",", "\[ImaginaryI]", ",", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "37d40431-bea9-4277-b3a4-ee530c665457"]
}], "Text",
 CellChangeTimes->{{3.9831869102883625`*^9, 3.983186985058356*^9}, {
  3.9831870355622096`*^9, 
  3.9831871001536984`*^9}},ExpressionUUID->"650beec4-3c37-4721-8b31-\
9ea98444b4ed"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "Mob"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Mob", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "}"}], "]"}], "[", "z_",
    "]"}], ":=", " ", 
  FractionBox[
   RowBox[{
    RowBox[{"a", " ", "z"}], " ", "+", " ", "b"}], 
   RowBox[{
    RowBox[{"c", " ", "z"}], " ", "+", "d"}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"InvMob", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "}"}], "]"}], "[", "z_",
    "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"Mob", "[", 
    RowBox[{"{", 
     RowBox[{"d", ",", 
      RowBox[{"-", "b"}], ",", 
      RowBox[{"-", "c"}], ",", "a"}], "}"}], "]"}], "[", "z", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z1", ",", "z2", ",", "z3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"w1", ",", "w2", ",", "w3"}], "}"}]}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "\[ImaginaryI]", ",", "1"}], "}"}]}], "}"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"a", " ", "z1"}], " ", "+", "b"}], 
       RowBox[{
        RowBox[{"c", " ", "z1"}], "+", " ", "d"}]], "==", "w1"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"a", " ", "z2"}], " ", "+", "b"}], 
       RowBox[{
        RowBox[{"c", " ", "z2"}], "+", " ", "d"}]], "==", "w2"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"a", " ", "z3"}], " ", "+", "b"}], 
       RowBox[{
        RowBox[{"c", " ", "z3"}], "+", " ", "d"}]], "==", "w3"}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9831870229995337`*^9, 3.9831870286902494`*^9}, {
  3.9831871187927656`*^9, 3.983187306362706*^9}, {3.9831873720729713`*^9, 
  3.9831873929377623`*^9}, {3.9831874466642704`*^9, 3.983187476305953*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"84e5299c-c8ce-4394-b216-7067df5d950d"],

