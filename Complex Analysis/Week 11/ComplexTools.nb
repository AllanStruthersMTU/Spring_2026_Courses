             RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}]}]}], "]"}]}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<RToUC\>\"", "->", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
