Cell[CellGroupData[{

Cell[TextData[{
 "Sparse series! \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Sum]", 
     RowBox[{"k", "=", "0"}], "\[Infinity]"], 
    SuperscriptBox["z", 
     SuperscriptBox["k", "2"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b439448a-761e-4124-84c5-d059663e7f06"]
}], "Subsection",
 CellChangeTimes->{{3.9784301274728003`*^9, 3.9784301462301755`*^9}, {
  3.978430252348387*^9, 3.9784302559331074`*^9}, {3.9784309525496187`*^9, 
  3.9784309847776833`*^9}},ExpressionUUID->"1a9aa5a2-56a7-4c74-b27d-\
14bb78b43913"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "z_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    SuperscriptBox["z", 
     SuperscriptBox["j", "2"]], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "0", ",", " ", "5"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"f", "[", "z", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", ",", "0", ",", " ", "100"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"R", "=", "0.7"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\"\<CPlot\>\"", "->", 
     RowBox[{"ComplexPlot3D", "[", 
      RowBox[{
       RowBox[{"f", "[", "z", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "R"}], "}"}], ",", 
       RowBox[{"PlotLegends", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<re z\>\"", ",", "\"\<im z\>\"", ",", "\"\<abs(f(z)\>\""}], 
         "}"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<re\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", 
         RowBox[{"Re", "[", 
          RowBox[{"f", "[", 
           RowBox[{"x", "+", 
            RowBox[{"I", " ", "y"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<re z\>\"", ",", "\"\<im z\>\"", ",", "\"\<re(f(z)\>\""}], 
         "}"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<im\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", 
         RowBox[{"Im", "[", 
          RowBox[{"f", "[", 
           RowBox[{"x", "+", 
            RowBox[{"I", " ", "y"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<re z\>\"", ",", "\"\<im z\>\"", ",", "\"\<im(f(z)\>\""}], 
         "}"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<abs\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", 
         RowBox[{"Abs", "[", 
          RowBox[{"f", "[", 
           RowBox[{"x", "+", 
            RowBox[{"I", " ", "y"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<re z\>\"", ",", "\"\<im z\>\"", ",", "\"\<abs(f(z)\>\""}], 
         "}"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<arg\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", 
         RowBox[{"Arg", "[", 
          RowBox[{"f", "[", 
           RowBox[{"x", "+", 
            RowBox[{"I", " ", "y"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", "\[IndentingNewLine]", 
