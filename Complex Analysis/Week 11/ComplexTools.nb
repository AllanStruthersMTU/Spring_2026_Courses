Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "z_", "]"}], ":=", " ", 
  FractionBox[
   RowBox[{"Sin", "[", 
    SuperscriptBox["z", "2"], "]"}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox["z", "2"]}], ")"}], "2"]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "[", "z_", "]"}], ":=", " ", 
  SqrtBox[
   RowBox[{"1", "+", 
    SuperscriptBox["z", "2"]}]]}], "\[IndentingNewLine]", 
 RowBox[{"ComplexPlot3D", "[", 
  RowBox[{
   RowBox[{"f", "[", "z", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", ",", "2"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"ComplexPlot3D", "[", 
  RowBox[{
   RowBox[{"g", "[", "z", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", ",", "2"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}], "Input",
