Cell[CellGroupData[{

Cell["3 Points to 3 Points", "Subsection",
 CellChangeTimes->{{3.9828295474252925`*^9, 3.9828295705322375`*^9}, {
  3.9831868619424353`*^9, 
  3.983186872247202*^9}},ExpressionUUID->"c4d2c96c-e733-404e-af70-\
e101f64cc3ed"],

Cell[TextData[{
 "There is a unique bilinear map satisfying\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["z", "1"], "\[Rule]", 
    SubscriptBox["w", "1"]}], TraditionalForm]],ExpressionUUID->
  "3bf81362-ed6b-4590-b727-e5df28fd72a2"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["z", "2"], "\[Rule]", 
    SubscriptBox["w", "2"]}], TraditionalForm]],ExpressionUUID->
  "02b0a71e-3895-46d6-9cf6-650efad0404d"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["z", "3"], "\[Rule]", 
    SubscriptBox["w", "3"]}], TraditionalForm]],ExpressionUUID->
  "efb4c1ab-860b-4fb2-bb43-fc49d94db74f"],
 "\nMaps circles and lines (clines) to circles and lines!"
}], "Text",
 CellChangeTimes->{{3.9828295779374623`*^9, 3.9828296474661264`*^9}, {
  3.982831628485239*^9, 
  3.9828316931908617`*^9}},ExpressionUUID->"51bc9acd-aab5-4c40-b1c7-\
07f0dbe6cef5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z1", ",", "z2", ",", "z3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"w1", ",", "w2", ",", "w3"}], "}"}]}], "}"}], "=", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "-", "I"}], ",", 
       RowBox[{"1", "+", "I"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"a", " ", "z1"}], " ", "+", "b"}], 
       RowBox[{
        RowBox[{"c", " ", "z1"}], "+", " ", "d"}]], "==", "w1"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"a", " ", "z2"}], " ", "+", "b"}], 
       RowBox[{
        RowBox[{"c", " ", "z2"}], "+", " ", "d"}]], "==", "w2"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"a", " ", "z3"}], " ", "+", "b"}], 
       RowBox[{
        RowBox[{"c", " ", "z3"}], "+", " ", "d"}]], "==", "w3"}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9828296549016557`*^9, 3.982829818054528*^9}, {
  3.9828298496135297`*^9, 3.982829886356106*^9}, {3.983006476567651*^9, 
  3.9830064832934246`*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"a6eb5940-ed25-4312-8c84-14a35065bb36"],

