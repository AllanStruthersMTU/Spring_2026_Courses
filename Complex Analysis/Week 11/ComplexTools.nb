Cell[BoxData[{"Well", "\[IndentingNewLine]", Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{"a", "=", 
     RowBox[{
      SuperscriptBox["\[ImaginaryI]", "\[ImaginaryI]"], "=", 
      RowBox[{
       RowBox[{"exp", "(", 
        RowBox[{"\[ImaginaryI]", " ", 
         RowBox[{"log", "(", "\[ImaginaryI]", ")"}]}], ")"}], "=", 
       RowBox[{"exp", "(", "\[ImaginaryI]", " "}]}]}]}], TraditionalForm]],
   FormatType->TraditionalForm,ExpressionUUID->
   "0c8b2d38-945b-4215-8273-67cc3e268408"],
  "(\[ImaginaryI] \[Pi]/2 + \[ImaginaryI] 2 k \[Pi]))=exp(-(\[Pi]/2+2\[Pi]k)) "
 }],ExpressionUUID->"29900df5-0a41-49fa-8bc8-3d07ab10525e"]}], "Text",
