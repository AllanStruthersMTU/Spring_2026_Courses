Cell[CellGroupData[{

Cell["Power Series", "Section",
 CellChangeTimes->{{3.9772216571107187`*^9, 3.9772216613033705`*^9}, {
  3.9773932653764105`*^9, 3.9773932675323534`*^9}, {3.9784296301196084`*^9, 
  3.97842964303905*^9}},ExpressionUUID->"0575327e-684f-4efe-81dc-\
f9920cd6cee3"],

Cell["\<\
In Calculus 2 you worked out power series for functions.  In complex analysis \
any nice function is defined (at least locally) by a power series.\
\>", "Text",
 CellChangeTimes->{{3.978429679815745*^9, 3.978429733797694*^9}, 
   3.9784301203253484`*^9},ExpressionUUID->"bc6d94c2-1bee-4fc2-ba2a-\
3f035359831e"],

Cell[CellGroupData[{

Cell["Bessel Js ", "Subsection",
 CellChangeTimes->{{3.9784301274728003`*^9, 
  3.9784301351185317`*^9}},ExpressionUUID->"7f4c9b67-9b70-466c-9a8f-\
d5923e750604"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "z_", "]"}], ":=", 
  RowBox[{"BesselJ", "[", 
   RowBox[{"0", ",", "z"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Series", "[", 
  RowBox[{
   RowBox[{"f", "[", "z", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", ",", "0", ",", " ", "12"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"R", "=", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\"\<CPlot\>\"", "->", 
     RowBox[{"ComplexPlot3D", "[", 
      RowBox[{
       RowBox[{"f", "[", "z", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "R"}], "}"}], ",", 
       RowBox[{"PlotLegends", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<re z\>\"", ",", "\"\<im z\>\"", ",", "\"\<abs(f(z)\>\""}], 
         "}"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<re\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", 
         RowBox[{"Re", "[", 
          RowBox[{"f", "[", 
           RowBox[{"x", "+", 
            RowBox[{"I", " ", "y"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<re z\>\"", ",", "\"\<im z\>\"", ",", "\"\<re(f(z)\>\""}], 
         "}"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<im\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", 
         RowBox[{"Im", "[", 
          RowBox[{"f", "[", 
           RowBox[{"x", "+", 
            RowBox[{"I", " ", "y"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<re z\>\"", ",", "\"\<im z\>\"", ",", "\"\<im(f(z)\>\""}], 
         "}"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<abs\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", 
         RowBox[{"Abs", "[", 
          RowBox[{"f", "[", 
           RowBox[{"x", "+", 
            RowBox[{"I", " ", "y"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<re z\>\"", ",", "\"\<im z\>\"", ",", "\"\<abs(f(z)\>\""}], 
         "}"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<arg\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", 
         RowBox[{"Arg", "[", 
          RowBox[{"f", "[", 
           RowBox[{"x", "+", 
            RowBox[{"I", " ", "y"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<re z\>\"", ",", "\"\<im z\>\"", ",", "\"\<arg(f(z)\>\""}], 
         "}"}]}]}], "]"}]}]}], "\[IndentingNewLine]", "}"}], "]"}]}], "Input",
