Cell[CellGroupData[{

Cell["Complex Velocity Potential: Not done yet!", "Section",
 CellChangeTimes->{{3.978603264294879*^9, 3.97860327434051*^9}, {
  3.9786038535731335`*^9, 
  3.9786038559325695`*^9}},ExpressionUUID->"79aefb32-cd43-459c-b316-\
4f24fe1e089c"],

Cell[TextData[{
 "An analytic function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "z", ")"}], "=", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "y"}], ")"}], "+", " ", 
     RowBox[{"i", " ", 
      RowBox[{"v", "(", 
       RowBox[{"x", ",", "y"}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1d6981ab-206f-435b-b190-72d3a686b52b"],
 " describes a \[OpenCurlyDoubleQuote]flow field\[CloseCurlyDoubleQuote] with \
velocity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"p", "(", 
       RowBox[{"x", ",", "y"}], ")"}], ",", 
      RowBox[{"q", "(", 
       RowBox[{"x", ",", "y"}], ")"}]}], "}"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ff48a285-e586-46e4-9f75-64fa0bbfbfde"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p", "(", 
     RowBox[{"x", ",", "y"}], ")"}], "=", 
    RowBox[{"u", "(", 
     RowBox[{"x", ",", "y"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6d9d58af-f8d3-4687-b7cc-2ef80af62608"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"q", "(", 
     RowBox[{"x", ",", "y"}], ")"}], "=", 
    RowBox[{"-", 
     RowBox[{"v", "(", 
      RowBox[{"x", ",", "y"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7386d032-c9e8-487d-9bf8-91d10e70f822"],
 ".  Note the minus sign!"
}], "Text",
 CellChangeTimes->{{3.9786033380386877`*^9, 
  3.9786035194639893`*^9}},ExpressionUUID->"6976e074-b765-49e7-a8a0-\
4870cef94e67"],

Cell["Not done yet", "Text",
 CellChangeTimes->{{3.978603841799407*^9, 
  3.978603848212698*^9}},ExpressionUUID->"d0fc4457-869e-4c39-95d8-\
d7ab95db1431"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"U", "=", "0.3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", "=", " ", 
   RowBox[{"1.2", "-", "\[ImaginaryI]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", "1.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "z_", "]"}], ":=", " ", 
  RowBox[{"U", "*", 
   RowBox[{"(", 
    RowBox[{"z", "+", " ", 
     FractionBox[
      SuperscriptBox["a", "2"], "z"]}], ")"}]}]}], "\n", 
 RowBox[{
  RowBox[{"V", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Re", "[", 
     RowBox[{"f", "[", 
      RowBox[{"x", "+", " ", 
       RowBox[{"I", " ", "y"}]}], "]"}], "]"}], ",", 
    RowBox[{"-", 
     RowBox[{"Im", "[", 
      RowBox[{"f", "[", 
       RowBox[{"x", "+", " ", 
        RowBox[{"I", " ", "y"}]}], "]"}], "]"}]}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"StreamPlot", "[", 
  RowBox[{
   RowBox[{"V", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.978603522697069*^9, 3.9786037771849766`*^9}, {
  3.9786039099909024`*^9, 3.9786040914389772`*^9}, {3.9786041543923755`*^9, 
