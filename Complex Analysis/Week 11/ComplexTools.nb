Cell[BoxData[{
 RowBox[{
  RowBox[{"RToUC", "[", "z_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Mob", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "I", ",", "I", ",", "1"}], "}"}], "]"}], "[", "z", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"UCToR", "[", "z_", "]"}], ":=", 
