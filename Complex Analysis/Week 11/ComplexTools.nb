Cell[CellGroupData[{

Cell["Real Axis to Unit Circle", "Subsection",
 CellChangeTimes->{{3.9828295474252925`*^9, 3.9828295705322375`*^9}, {
  3.9831868619424353`*^9, 3.983186897855171*^9}, {3.983187042689131*^9, 
