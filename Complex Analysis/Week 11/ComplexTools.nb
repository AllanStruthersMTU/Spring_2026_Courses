  Cell[BoxData[
   FormBox[
    RowBox[{"a", "=", 
     RowBox[{
      SuperscriptBox["\[ImaginaryI]", "\[ImaginaryI]"], "=", 
      RowBox[{
       RowBox[{"exp", "(", 
        RowBox[{"\[ImaginaryI]", " ", 
