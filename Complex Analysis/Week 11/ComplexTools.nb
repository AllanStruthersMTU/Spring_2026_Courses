}, Closed]],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  SqrtBox[
   RowBox[{"1", "-", 
    SuperscriptBox["z", "2"]}]], 
  TraditionalForm]],ExpressionUUID->"f45f12b5-e7dd-4941-8694-e5e8a8b91f5d"]], \
"Subsection",
 CellChangeTimes->{{3.97842826985339*^9, 3.978428276117884*^9}, {
  3.9784290716560965`*^9, 
  3.978429076600423*^9}},ExpressionUUID->"c58af0b8-f626-48d1-b4ef-\
daa571e8b63d"],

Cell[TextData[{
 "We know that  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SuperscriptBox["z", "2"]}], ")"}], 
    RowBox[{"1", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "9d72eab2-6664-44d4-8866-9b949d2aab8c"],
 " has two values.  Everybody decided (including computer programs) to chose \
the same principle branch!  Can we somehow plot more than one bit of the \
function.  Could we find the other bits with plausible looking algebra."
}], "Text",
 CellChangeTimes->{{3.978427799923956*^9, 3.978427825588434*^9}, {
  3.9784282839725103`*^9, 3.9784283296671734`*^9}, {3.9784287300045366`*^9, 
  3.978428750854354*^9}, {3.978428966319422*^9, 3.9784289718595824`*^9}, {
  3.9784290059316335`*^9, 3.978429011187806*^9}, {3.9784295151241207`*^9, 
  3.978429520837384*^9}, {3.9784295538576565`*^9, 
  3.978429590615738*^9}},ExpressionUUID->"a07e3f2b-fb5b-4b30-a49d-\
1aff17973a5a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f1", "[", "z_", "]"}], ":=", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"1", "-", 
     SuperscriptBox["z", "2"]}], ")"}], 
   RowBox[{"1", "/", "2"}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"R", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TabView", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<CPlot3D\>\"", "->", 
     RowBox[{"ComplexPlot3D", "[", " ", 
      RowBox[{
       RowBox[{"f1", "[", "z", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", " ", "R"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotLegends", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<re z\>\"", ",", "\"\<im z\>\"", ",", "\"\<abs(f1(z)\>\""}], 
         "}"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<Abs\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{"f1", "[", 
           RowBox[{"x", "+", " ", 
            RowBox[{"I", " ", "y"}]}], "]"}], "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<re z\>\"", ",", "\"\<im z\>\"", ",", "\"\<abs(f1(z)\>\""}], 
         "}"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<Arg\>\"", "->", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", " ", 
         RowBox[{"Arg", "[", 
          RowBox[{"f1", "[", 
           RowBox[{"x", "+", " ", 
            RowBox[{"I", " ", "y"}]}], "]"}], "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<re z\>\"", ",", "\"\<im z\>\"", ",", "\"\<arg(f1(z)\>\""}], 
         "}"}]}]}], "]"}]}]}], "\[IndentingNewLine]", "}"}], "]"}]}], "Input",
